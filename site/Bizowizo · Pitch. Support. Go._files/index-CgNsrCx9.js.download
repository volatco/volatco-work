s:"لم يتم تجهيز تحويل بعد.",conversionStatus:{qualified:"مؤهل",partially_refunded:"استرداد جزئي",refunded:"مسترد",disputed:"قيد النزاع",rejected:"غير مؤهل"},payoutStatus:{requested:"مطلوب",under_review:"قيد المراجعة",approved:"مقبول",transfer_pending:"التحويل معلق",transferred:"محوّل إلى Stripe",payout_in_transit:"التحويل البنكي في الطريق",paid:"مدفوع",failed:"فشل",reversed:"معكوس",cancelled:"ملغى"},unavailableTitle:"الرابط غير متاح",unavailableBody:"انتهى الرابط أو توقف أو لم تعد الوجهة عامة."},zh:{navigationLabel:"推广大使",eyebrow:"推荐。连接。获得收益。",heroTitle:"成为 BizoWIZO VIP",heroBody:"向你的受众分享 Bizowizo、单个 Bizo、Wizo 或项目。由此产生真实、合格的 Bizowizo 净收入时，你可透明获得 5% 佣金。",heroPrimary:"申请 WIZO VIP",heroSecondary:"了解运作方式",rateBadge:"5%",rateCaption:"合格 Bizowizo 净收入",noGuarantee:"不保证收入、点击或覆盖。示例仅说明计算方式。",missionLabel:"WIZO VIP 控制中心",missionTitle:"你的链接。你的网络。真实影响。",missionBody:"选择获批目标，分享个人链接，并在一处查看真实点击、归因、佣金与转账。",howEyebrow:"你的路径",howTitle:"从支持者到 WIZO VIP",howBody:"六个清晰步骤，无加入费、下线层级或隐藏计算。",steps:[{title:"申请",body:"以现有 Bizo 或 Wizo 身份登录并接受 WIZO VIP 条款。"},{title:"审核",body:"Bizowizo 审核身份、资料、国家、许可声明与安全状态。"},{title:"选择目标",body:"推荐平台、网站/应用、Bizo、Wizo 或项目。"},{title:"分享链接",body:"使用安全链接，并清晰标注广告或联盟链接。"},{title:"产生 5%",body:"仅真实且合格的 Bizowizo 净收入产生佣金，点击或 Coins 本身不产生。"},{title:"Stripe 转账",body:"30 天保留期、审核且达到 50 欧元后，经 Stripe Connect 转账。"}],targetEyebrow:"推荐目标",targetTitle:"分享你真正认可的内容",targetBody:"每个链接只通向已验证的 Bizowizo 目标，不允许任意外部跳转。",targets:{platform:{label:"Bizowizo 平台",body:"推荐完整理念与社区入口。"},website:{label:"网站",body:"将受众带到 Bizowizo 官方网站。"},app:{label:"应用",body:"上线后分享获批应用或深度链接。"},bizo:{label:"单个 Bizo",body:"介绍创始人与其公开资料。"},wizo:{label:"单个 Wizo",body:"推荐公开 Wizo 资料。"},campaign:{label:"项目",body:"将注意力直接引向已审核项目。"}},earningsEyebrow:"透明计算",earningsTitle:"5%，精确到微单位",earningsBody:"计算基础是扣除税费、退款与争议后实际收到的 Bizowizo 平台份额。Coins、Bizo Nuggets 与 Bizo 份额保持分离。",earningsExamples:[{basis:"€10.00 净收入",commission:"€0.50 佣金"},{basis:"€100.00 净收入",commission:"€5.00 佣金"},{basis:"€1,000.00 净收入",commission:"€50.00 佣金"}],securityEyebrow:"公平且可追溯",securityTitle:"保护社区与 WIZO VIP",securityBody:"每次归因、调整与转账均可审计。禁止自我推荐、机器人、Cookie Stuffing 与重复佣金。",securityCards:[{title:"先征得同意",body:"只有自愿同意后才保存 30 天持续归因。"},{title:"30 天保留期",body:"转账前考虑退款、拒付与安全审核。"},{title:"Stripe Connect",body:"KYC 与银行付款由 Stripe 完成，Bizowizo 不保存银行或卡号。"}],disclosureTitle:"清晰标注广告",disclosureBody:"有偿推荐必须明确标注为广告、赞助或联盟链接。国家和渠道不同，可能还需政府许可。",publicCtaTitle:"准备传播 Bizowizo？",publicCtaBody:"先创建 Bizo 或 Wizo 资料，然后申请 WIZO VIP。",login:"登录",startBizo:"以 Bizo 开始",startWizo:"以 Wizo 开始",applicationTitle:"WIZO VIP 申请",applicationBody:"你的 Bizo/Wizo 身份不变；WIZO VIP 是额外审核功能。",entityType:"参与身份",individual:"个人",company:"公司",country:"居住/经营国家",taxCountry:"税务国家",permitStatus:"广告/媒体许可",permitUnknown:"尚未确认",permitNotRequired:"自行审查后声明无需",permitDeclared:"已有 / 已声明",permitReference:"许可编号",permitReferenceOptional:"可选",acceptTerms:"我接受 WIZO VIP 条款并确认信息准确。",submitApplication:"提交申请",submitting:"提交中…",applicationSuccess:"申请已安全提交。",portalEyebrow:"你的 WIZO VIP 门户",portalTitle:"链接、影响与收益",portalBody:"所有数值均来自真实事件。",statusLabel:"项目状态",status:{applied:"已提交",under_review:"审核中",approved:"已批准",payout_setup_required:"设置 Stripe",active:"活跃",suspended:"暂停",rejected:"拒绝",closed:"关闭"},clicks:"点击",attributions:"归因",links:"链接",pending:"待定",available:"可用",held:"保留",paid:"已转账",totalCommission:"佣金总额",createLinkTitle:"创建个人链接",createLinkBody:"选择获批目标，所有规则由服务器验证。",targetType:"推荐目标",chooseTarget:"选择目标",targetSearch:"搜索 Bizo、Wizo 或项目",targetSearchPlaceholder:"输入名称或标题",linkLabel:"内部标签",linkLabelPlaceholder:"例如：Instagram 简介",generateLink:"创建安全链接",generatingLink:"创建中…",copyLink:"复制链接",copied:"已复制",shareDisclosure:"发布时始终清晰标注广告或联盟链接。",noLinks:"尚未创建链接。",recentLinks:"最近链接",commissionTitle:"佣金概览",commissionBody:"金额保留 30 天，并可能因退款、争议或安全审核调整。",noCommission:"尚无合格佣金。",connectTitle:"设置 Stripe 转账",connectBody:"Stripe 处理身份与银行付款，Bizowizo 不接收银行数据。",connectStart:"开始 Stripe Connect",connectContinue:"继续设置",connectReady:"Stripe Connect 已可转账。",connectPending:"Stripe 仍需资料或正在审核。",connectUnavailable:"当前无法获取状态。",minimumPayout:"最低转账：€50.0