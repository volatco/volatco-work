g notifications.",empty:"No notifications yet.",systemActor:"Bizowizo",followsYou:"follows you now.",publishedPitch:"published a new pitch.",isLive:"is now live.",liveBattleBody:"A live battle is now active.",invitedBattle:"invited you to a live battle.",battleChanged:"Your battle status has changed.",campaignChanged:"Your campaign has reached a new status.",donationBody:"A coin donation has been confirmed.",rewardBody:"A reward status has changed.",payoutBody:"Your payout status has changed.",moderationBody:"There is an important account notification.",messengerMessageBody:"sent you a private message.",projectInvitationBody:"invited you to a campaign.",projectInvitationAcceptedBody:"Your campaign invitation was accepted.",projectInvitationDeclinedBody:"Your campaign invitation was declined.",newBizoBody:"is new as a Bizo on Bizowizo.",newWizoBody:"is new as a Wizo on Bizowizo.",pitchCommentBody:"commented on your pitch.",liveCommentBody:"commented in your live format.",campaignReviewBody:"wrote a Wizo review for your campaign.",pitchLikeBody:"liked your pitch.",pitchShareBody:"shared your pitch.",premiumUnlockBody:"unlocked premium content from your pitch.",referralActivityBody:"A new WIZO referral attribution was confirmed.",systemAnnouncementBody:"There is a new important platform announcement.",coinPurchaseBody:"Your coin purchase was successfully booked.",paymentStatusBody:"The status of your coin payment has changed.",refundStatusBody:"The status of a refund or chargeback has changed.",coins:"Coins",who:"Who",where:"Where",when:"When",amount:"Amount",statusLabel:"Status",open:"Open",groupedEvents:"events",filters:{all:"All",unread:"Unread",social:"Social",live:"Live",wallet:"Wallet",growth:"Growth",system:"System",critical:"Important"},contextLabels:{pitch:"Pitch",campaign:"Campaign",battle:"Live battle",messenger:"Messenger",profile:"Profile",wallet:"Wallet",live:"Live area",studio:"Studio",platform:"Bizowizo"},statuses:{active:"Active",extended:"Extended",accepted:"Accepted",declined:"Declined",withdrawn:"Withdrawn",scheduled:"Scheduled",live:"Live",cancelled:"Cancelled",completed:"Completed",paid:"Paid",failed:"Failed",refunded:"Refunded",disputed:"Under review",restored:"Restored",processing:"Processing",pending:"Pending",claimed:"Claimed"},types:{newFollower:"New follower",newPitch:"New pitch",livePitch:"Live pitch",liveBattle:"Live battle",battleInvitation:"Battle request",battleStatus:"Battle status",campaign:"Campaign news",donation:"Donation",reward:"Reward",payout:"Payout",moderation:"Important notice",messengerMessage:"New message",projectInvitation:"Campaign invitation",projectInvitationStatus:"Invitation status",newBizo:"New Bizo",newWizo:"New Wizo",pitchComment:"New pitch comment",liveComment:"New live comment",campaignReview:"New Wizo review",pitchLike:"New like",pitchShare:"New share",premiumUnlock:"Premium unlocked",referralActivity:"Referral confirmed",systemAnnouncement:"Platform announcement",coinPurchase:"Coin purchase booked",paymentStatus:"Payment status",refundStatus:"Refund status"}},activityTicker:{label:"Current Bizowizo activities",supported:"supported",coins:"Coins",newPitch:"New pitch",newCampaign:"New campaign",livePitch:"Live pitch active now",liveBattle:"Live battle active now",newRole:{bizo:"New Bizo",wizo:"New Wizo"},empty:"Loading current platform activities."},upload:{title:"Upload pitch video",intro:"Maximum 60 seconds as MP4 or WebM.",videoLabel:"Pitch video",sourceLanguageLabel:"Spoken language in the video",sourceLanguageHint:"Used for automatic captions and translations.",captionsLabel:"Caption file (optional)",captionsHint:"WEBVTT up to 30 KB. Without a file, captions are generated automatically.",captionsSelected:"Caption file selected",captionsAutomatic:"No file selected – captions will be generated automatically.",titleLabel:"Title",categoryLabel:"Category",descriptionLabel:"Description",projectDetailsLabel:"Project details",goalCoinsLabel:"Required coins",selectVideo:"Select video",replaceVideo:"Replace video",duration:"Video duration",submit:"Publish pitch",uploading:"Publishing pitch",loginRequired:"Sign in as Bizo",roleRequired:"This area is for Bizos.",loadFailed:"Failed to load Bizo profile.",onboardingRequired:"Create Bizo profile",backToFeed:"To pitch feed",formTitle:"Project & pitch",formHint:"All information appears directly in the feed.",errors:{VIDEO_TOO_LONG:"The pitch video may be a maximum of 60 seconds long.",VIDEO_NOT_9_16:"Please upload a genuine 9:16 portrait video (e.g., 1080 × 1920 pixels).",VIDEO_DURATION_UNREADABLE:"The video duration could not be read.",INVALID_VIDEO:"The video file could not be processed.",UNSUPPORTED_VIDEO_TYPE:"MP4 and WebM videos are allowed.",VIDEO_TOO_LARGE:"The video file is too large.",EMPTY_VIDEO:"The video file is empty.",VIDEO_REQUIRED:"Please select a pitch video.",CAPTIONS_TOO_LARGE:"The caption file may not exceed 30 KB.",INVALID_CAPTIONS_VTT:"Please select a valid WEBVTT caption file.",CAPTIONS_READ_FAILED:"The caption file could not be read.",INVALID_PITCH_FIELDS:"Please check all project data completely.",PITCH_UPLOAD_FAILED:"Failed to publish the pitch.",BIZO_PROFILE_INCOMPLETE:"Your Bizo profile is not complete yet. The missing information is listed below.",UNAUTHENTICATED:"Please sign in again.",BIZO_ROLE_REQUIRED:"This area is for Bizos."}}},mT={brand:"BIZOWIZO",slogan:"Do Your thing!",website:"WWW.BIZOWIZO.COM",roles:{bizo:"BIZO",wizo:"WIZO"},account:{bizoTitle:"START AS A BIZO!",wizoTitle:"GO ALL IN AS A WIZO.",usernameLabel:"Show your vibes:",displayNameLabel:"Profile or brand identity",bioLabel:"Pitch your vision:",bizoFollowerLabel:"100 followers",bizoBattleLabel:"Rock live battles:",bizoCommunityLabel:"Talk with your WIZO crew:",wizoFollowingLabel:"WIZO squad:",wizoRewardLabel:"Rewards for engagement:"},live:"LIVE",coinMark:"B",hero:{title:"CROWD REVOLUTION 3.0",subtitle:"WELCOME TO THE WORLD'S FIRST SHORT-VIDEO CROWDFUNDING PLATFORM!",paragraphs:["At Bizowizo it's all about giving hundreds of thousands of creative projects worldwide the chance to take off. And us? We're here to change the game completely – with a live touch you haven't seen before! Say goodbye to the boring crowdfunding campaigns of yesterday!","With 1-minute pitch videos, live pitch sessions and action-packed 5-minute live battles, we open up entirely new dimensions and opportunities for BIZOS to bring their ideas to life. BIZOS pull the WIZO audience into their live pitches to earn virtual Coins, which they can then turn into real money.","Creative projects, products and services deserve the stage – directly in front of a global audience, with real-time feedback, support and full coffers!","With our integrated coin system including wallets, Wizos can invest live and directly in their favorite Bizos, push them on the path to success and bring them to life. With BIZOWIZO we create an euphoric atmosphere for all users and open opportunities to turn dreams into reality!","This is crowdfunding like you've never experienced it before – and the best part? We make the world a little better, more innovative and more successful every day while offering the best user experience ever!","BizoWizo – the platform that changes the crowdfunding game forever! Join us and experience the future of crowdfunding! LIVE"]},bizo:{title:"START AS A BIZO!",items:["Show your vibes: Kickstart your unique profile or brand identity on BIZOWIZO with cool visual elements, messages and live action to really stand out.","Set goals, earn Coins: Define clear goals and the coin amount you need to fully engage your WIZO community and kickstart your project.","Pitch your vision: Put out what you've got! Share your startup, idea or creative project with convincing 1-minute pitch videos.","Share dreams, reach 100 followers, go live: Once you've hit the 100 follower mark, go live with a few clicks and connect with your audience for instant feedback.","Rock live battles: Face other Bizos in action-packed 5-minute pitch battles, show your innovation and rake in coins for every captivating performance. Let's go!","Connect with other Bizos: Team up with other Bizos for epic live battles and create unique experiences for your audience.","Earn coins with support: Get virtual Coins as backing from your WIZO fan club. That's not just cash, it's clear validation of your project.","Talk with your WIZO crew: Chat casually with your supporters, keep them up to date and build your own fanbase.","Share non-stop: Boost your visibility by sharing your pitch videos and live battles everywhere and create serious buzz around your innovative journey. Let's roll!"]},pitch:{title:"YOUR PITCH VIDEO",subtitle:"Your ticket to success!",paragraphs:["Dive into the exciting world of BIZOWIZO! With an ultra-cool 1-minute BIZO pitch video you can present your project on the virtual stage and make a splash. This is more than just a pitch - it's a captivating performance that paves the way to your success!","Participate in live pitches and 5-minute live battles while sharing your bold vision directly with your supporters. Every moment is a chance to showcase not only your project but the dream that shapes the future.","Feel the energy of passion, innovation and the fighting spirit against other Bizos - this is not an ordinary presentation, but a real powerplay for your idea!","Present your pitch to an enthusiastic WIZO audience and experience the magic that is staged.","And the best part? WIZOS reward your participation in live pitches and live battles with Coins that will catapult your endeavor to a whole new level!"],reactions:["go go go","You will make it go","You will make it go","your thing bro..."],display:{time:"3:00",coins:"250.000"}},battle:{title:"Live Pitch Battles",intro:["Welcome to the Live Pitch Battles, the ultimate showdown where BIZOS fight for their dreams and innovation explodes in just 5 minutes!","There are no limits here, just hardcore business, plenty of action and, of course, coins in the pot!"],minutes:["(1 minute) The BIZOS enter the spotlight with pure passion and kick off. Every incoming coin is a digital cheer, a vote for the BIZOS' pulsating dream.","(2 minute) The pitches run. The pace increases. The WIZO audience holds the fate of the projects in their hands. Who will convince the Wizos more with their project?","(3 minute) BIZOS turn up the heat and transform the live video pitch into a mega dynamic story. Coins pile up like a thunderous applause from our enthusiastic WIZOS. Every second counts.","(4 minute) The pitch battle reaches its absolute peak. Coins are the visible sign of collective support and decide which dream becomes reality.","(5 minute) Time's up. The winner is determined – their project has won hearts and coins. The Bizowizo Live Pitch Battle is over, and the victorious BIZO can bask in the glow of success or start a new round in the fight for coins."],reactions:["Great job buddy","Wow awesome","Go go go go go","You will make it go"],display:{time:"4:30"}},wizo:{title:"GO ALL IN AS A WIZO.",items:["Check exclusivity: Get special content and live streams from BIZOS just for you.","Get involved: Shape the live experience with BIZOS through comments, virtual gifts and tips.","Virtual surprises: Send virtual gifts to show your support.","Join live battles: Be there for live battles and rock the platform events.","Push projects: Buy gifts and support Bizos' projects.","Deals and discounts: Grab exclusive deals and big discounts on BIZO goodies and services.","Exclusive events: Participate in special events just for you as part of the Bizowizo crew.","Rewards for engagement: Earn rewards and props for your engagement.","Chat with BIZOS: Talk directly with the BIZOS and check out their projects. Let's vibe!","WIZO squad: Join the crew that pushes innovative projects to the next level!","Goodbye ads: Enjoy ad-free action, get coins and say goodbye to ad breaks.","Props for power users: Active WIZOS receive extra goodies for their regular participation."]},coins:{title:"BIZOWIZO COINS",subtitle:"- THE VIRTUAL CURRENCY -",label:"VIRTUAL COINS",paragraphs:["Get the bling-bling coins: WIZOS buy COINS to access VIP content, subscribe to BIZOS and send big virtual gifts live!","Swipe in, COINS out: WizOS put in credit cards, top up their COIN BALANCE and then it’s on! With these COINS (also gifts and tips) they support Bizo posts and boost live battles."],action:"GET COINS",rate:"1 BIZOWIZO COIN = 1 EUR"},coinPacks:[{coins:"5",price:"5.00 €"},{coins:"10",price:"10.00 €"},{coins:"15",price:"15.00 €"},{coins:"20",price:"20.00 €"}],coinSections:{coinPacksTitle:"GIFT CATALOG",coinPacksSubtitle:"- 16 GIFTS -",giftsTitle:"VIRTUAL GIFTS.",giftsSubtitle:"NOVA TO ULTRAWIZO",superPacksTitle:"MEGA GIFTS.",superPacksSubtitle:"- SUPERPACKS -"},gifts:[{name:"STARTY",coins:"25",price:"25.00 €"},{name:"BOOMY",coins:"50",price:"50.00 €"},{name:"CASHY",coins:"75",price:"75.00 €"},{name:"TROVY",coins:"100",price:"100.00 €"},{name:"COINY",coins:"125",price:"125.00 €"},{name:"WIZY",coins:"150",price:"150.00 €"},{name:"CATCHY",coins:"175",price:"175.00 €"},{name:"TWINKY",coins:"200",price:"200.00 €"}],superPacks:[{name:"WIZYPRO",coins:"500",price:"500.00 €"},{name:"WIZYHERO",coins:"1.000",price:"1,000.00 €"},{name:"MEGAWIZO",coins:"2.500",price:"2,500.00 €"},{name:"ULTRAWIZO",coins:"5.000",price:"5,000.00 €"}],revenue:{title:"How does BIZOWIZO make money?",subtitle:"WE EARN WITH VIRTUAL COINS.",paragraphs:["Users purchase virtual gifts with COINS and send them to selected BIZOS. Each sent gift puts coins into the Bizowizo coffers – a great way to generate revenue!","Bizowizo offers 16 named virtual gifts from NOVA to ULTRAWIZO. Before purchase, every gift card displays its Coin quantity and binding Euro price at 1 Coin = 1 EUR. Internal processing and settlement are not broken down publicly.","BIZOS have the opportunity to earn money by marking their content as exclusive via our premium live streaming features. WIZOS can unlock these exclusive streams by using Coins. Bizowizo earns a commission on each transaction, providing fair compensation for the exclusive platform provided.","Bizowizo also generates substantial revenue through in-app advertising from cool third parties! The commission depends on how many people click or purchase products through referrals. More action, more commission – that's the Bizowizo style!"]},forecast:{title:"What roughly comes out:",subtitle:"- COINS / PROJECTS -",years:["2024","2025","2026","2027","2028"],rows:[{label:"Bizos / Projects",values:["500","1.000","2.000","5.000","10.000"]},{label:"Wizos / Donators",values:["500.000","1.000.000","2.000.000","5.000.000","10.000.000"]},{label:"Purchased Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]},{label:"Donated Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]}],assumptions:["- Planning values are internal model assumptions and not a result guarantee","- Only the aggregated campaign progress is publicly visible"],assumptionsTitle:"ASSUMPTIONS"},investor:{title:"DO YOU WANT TO JOIN BIZOWIZO AS A FRIEND / INVESTOR?",companyTitle:"THE COMPANY BEHIND BIZOWIZO",company:"BIZOWIZO - The vibe starts in Dubai! Startups are booming here, and we enjoy not only the coolest community but also tax freedom and many other benefits.",amountTitle:"HOW MUCH CAN I INVEST FOR WHAT?",amount:"Grab your piece of the pie! In the family & friends round you can get up to 10% of the shares. We're even offering a 1% stake for just €25,000. Be part of it when it takes off!",expectationTitle:"WHAT CAN I EXPECT AND IN WHAT TIMEFRAME?",expectation:"Bling-bling alert! We see BIZOWIZO shooting through the roof and taking off massively in no time! Valuation and revenue will be catapulted into the stratosphere!",actionTitle:"YES, I WANT IN!",action:"Join and secure your ticket to the hottest investment of the year! Send us a short message and maybe experience the most profitable adventure of your life! Email: edwin.davis@icloud.com"},copyright:"Copyright 2023 / EDWIN DAVIS"},jT={campaign:{title:"Campañas",intro:"Planifica tu objetivo, sube documentos y crea recompensas para los Wizos que te apoyan.",login:"Iniciar sesión como Bizo",onboarding:"Configurar perfil de Bizo",bizoOnly:"Las campañas pueden ser gestionadas por Bizos.",backProfile:"Volver al perfil de Bizo",myCampaigns:"Mis campañas",empty:"Aún no se ha creado ninguna campaña.",selectOrCreate:"Seleccionar campaña o crear una nueva.",loadFailed:"No se pudo cargar la campaña.",create:"Crear campaña",created:"Borrador de campaña creado.",createFailed:"No se pudo crear la campaña.",draftHint:"Primero guardar como borrador. Al publicar, comienzan 60 días.",saveDraft:"Guardar borrador",saved:"Campaña guardada.",saveFailed:"No se pudo guardar la campaña.",publish:"Iniciar 60 días",published:"Campaña publicada.",publishFailed:"No se pudo publicar la campaña.",reviewTitle:"Revisión automática de campaña",reviewIntro:"Toda la información obligatoria se verifica en el lado del servidor. Solo cuando se cumplen 15 de 15 criterios, la campaña comienza automáticamente durante 60 días.",reviewProgress:"Progreso de aprobación",reviewReady:"Listo para aprobación",reviewBlocked:"Aún no listo para aprobación",reviewNotChecked:"Aún no verificado",reviewApproved:"Aprobado automáticamente",reviewRun:"Iniciar revisión y aprobación",reviewRunning:"Revisando campaña",reviewBlockedToast:"La campaña permanece en borrador. Por favor, completa los criterios abiertos.",reviewFailed:"No se pudo ejecutar la revisión automática.",reviewLoadFailed:"No se pudo cargar el estado de aprobación.",reviewLastChecked:"Última revisión",reviewNeverChecked:"Aún no se ha guardado ninguna ejecución de prueba",reviewCorrection:"Corregir ahora",reviewCriteria:{account_active:{title:"Cuenta Bizo activa",hint:"La cuenta Bizo debe estar activa y sin restricciones."},profile_identity:{ti