rivene logike provizija.",steps:[{title:"Prijavi se",body:"Prijavite se kao postojeći Bizo ili Wizo i prihvatite uvjete WIZO VIP."},{title:"Provjera",body:"Bizowizo provjerava identitet, profil, državu, izjave o dozvolama i sigurnosni status."},{title:"Odaberite destinaciju",body:"Preporučite platformu, web-stranicu/aplikaciju, Bizo, Wizo ili kampanju."},{title:"Podijelite svoju poveznicu",body:"Koristite svoju sigurnu poveznicu i jasno označite svaki komercijalni post kao oglas ili partnersku poveznicu."},{title:"Zaradite 5%",body:"Provizija nastaje samo od stvarnog kvalificiranog Bizowizo neto prihoda – nikada samo od klikova ili Coins."},{title:"Isplata putem Stripe",body:"Nakon 30-dnevnog zadržavanja, provjere i najmanje €50, Bizowizo prenosi iznos putem Stripe Connect."}],targetEyebrow:"VAŠE DESTINACIJE PREPORUKA",targetTitle:"Dijelite upravo ono u što vjerujete",targetBody:"Svaka poveznica vodi isključivo na verificiranu Bizowizo destinaciju. Otvoreni vanjski preusmjeravanja su isključena.",targets:{platform:{label:"Bizowizo platforma",body:"Preporuči cjelokupan koncept i ulazak u zajednicu."},website:{label:"Web stranica",body:"Dovedi svoju publiku na službenu Bizowizo web stranicu."},app:{label:"Aplikacija",body:"Podijeli odobrenu aplikaciju ili deep link kad postane dostupan."},bizo:{label:"Pojedinačni Bizo",body:"Predstavi osnivača i njihov javni profil."},wizo:{label:"Pojedinačni Wizo",body:"Preporuči javni profil Wizo i njegov utjecaj na zajednicu."},campaign:{label:"Kampanja",body:"Usmjeri pažnju na recenzirani projekt."}},earningsEyebrow:"IZRAČUNATO TRANSPARENTNO",earningsTitle:"5% – točno do mikrojedinice",earningsBody:"Osnova je stvarni primljeni udio platforme Bizowizo nakon poreza, povrata i sporova. Coins, Bizo Nuggets i Bizo share ostaju odvojeni.",earningsExamples:[{basis:"€10.00 neto prihoda",commission:"€0.50 provizije"},{basis:"€100.00 neto prihoda",commission:"€5.00 provizije"},{basis:"€1,000.00 neto prihoda",commission:"€50.00 provizije"}],securityEyebrow:"PRAVEDNO I PRATIVO",securityTitle:"Zaštita zajednice i WIZO VIP",securityBody:"Svako pripisivanje, ispravak i isplata ostaju revizijski provjerljivi. Samopreporuke, botovi, umetanje kolačića i dvostruka provizija isključeni su.",securityCards:[{title:"Pristanak prije svega",body:"Trajna 30-dnevna atribucija pohranjuje se samo nakon dobrovoljnog pristanka na preporuku."},{title:"30-dnevno zadržavanje",body:"Povrati, chargebackovi i sigurnosne provjere razmatraju se prije isplate."},{title:"Stripe Connect",body:"KYC i isplate na bankovni račun obavljaju se putem Stripe. Bizowizo ne pohranjuje brojeve bankovnih računa niti kartica."}],disclosureTitle:"Jasno otkrijte oglašavanje",disclosureBody:"Plaćene preporuke moraju biti vidljivo i jasno označene kao oglašavanje, sponzorirani sadržaj ili partnerski link. Također može biti potrebna državna dozvola, ovisno o državi i kanalu.",publicCtaTitle:"Spremni povesti Bizowizo naprijed?",publicCtaBody:"Prvo izradite Bizo ili Wizo profil. Nakon toga se možete prijaviti za WIZO VIP.",login:"Prijavite se",startBizo:"Započni kao Bizo",startWizo:"Započni kao Wizo",applicationTitle:"Prijava za WIZO VIP",applicationBody:"Vaša Bizo/Wizo uloga ostaje nepromijenjena. WIZO VIP je dodatna mogućnost programa podložna provjeri.",entityType:"Sudjelujte kao",individual:"Pojedinačno",company:"Tvrtka",country:"Država prebivališta/poslovanja",taxCountry:"Država oporezivanja",permitStatus:"Dozvola za oglašavanje/medije",permitUnknown:"Još nije pojašnjeno",permitNotRequired:"Deklarirano kao nepotrebno nakon vlastite provjere",permitDeclared:"Dostupno / prijavljeno",permitReference:"Referenca dozvole/licence",permitReferenceOptional:"Neobavezno gdje je dostupno",acceptTerms:"Prihvaćam uvjete za WIZO VIP i potvrđujem da su moje informacije točne.",submitApplication:"Pošalji prijavu",submitting:"Slanje…",applicationSuccess:"Vaša je prijava sigurno poslana.",portalEyebrow:"VAŠ PORTAL WIZO VIP",portalTitle:"Linkovi, utjecaj i zarada",por