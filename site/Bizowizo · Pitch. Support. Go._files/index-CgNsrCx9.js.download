nlockBody:"otključao je premium sadržaj iz vašeg pitcha.",referralActivityBody:"Potvrđena je nova WIZO atribucija preporuke.",systemAnnouncementBody:"Postoji nova važna obavijest platforme.",coinPurchaseBody:"Vaša kupovina coina je uspješno evidentirana.",paymentStatusBody:"Status vaše coin uplate je promijenjen.",refundStatusBody:"Status povrata sredstava ili chargebacka je promijenjen.",coins:"Coins",who:"Tko",where:"Gdje",when:"Kada",amount:"Iznos",statusLabel:"Status",open:"Otvori",groupedEvents:"događaji",filters:{all:"Sve",unread:"Nepročitano",social:"Društveno",live:"Uživo",wallet:"Novčanik",growth:"Rast",system:"Sustav",critical:"Važno"},contextLabels:{pitch:"Pitch",campaign:"Kampanja",battle:"Live dvoboj",messenger:"Messenger",profile:"Profil",wallet:"Novčanik",live:"Live područje",studio:"Studio",platform:"Bizowizo"},statuses:{active:"Aktivno",extended:"Produženo",accepted:"Prihvaćeno",declined:"Odbijeno",withdrawn:"Povučeno",scheduled:"Zakazano",live:"Uživo",cancelled:"Poništeno",completed:"Završeno",paid:"Plaćeno",failed:"Neuspješno",refunded:"Refundirano",disputed:"U pregledu",restored:"Obnovljeno",processing:"Obrađuje se",pending:"Na čekanju",claimed:"Preuzeto"},types:{newFollower:"Novi pratitelj",newPitch:"Nova prezentacija",livePitch:"Prezentacija uživo",liveBattle:"Live dvoboj",battleInvitation:"Zahtjev za izazov",battleStatus:"Status izazova",campaign:"Novosti kampanje",donation:"Donacija",reward:"Reward",payout:"Isplata",moderation:"Važna obavijest",messengerMessage:"Nova poruka",projectInvitation:"Poziv za kampanju",projectInvitationStatus:"Status pozivnice",newBizo:"Novi Bizo",newWizo:"Novi Wizo",pitchComment:"Novi komentar na prezentaciju",liveComment:"Novi komentar uživo",campaignReview:"Nova recenzija Wizo",pitchLike:"Novi lajk",pitchShare:"Novo dijeljenje",premiumUnlock:"Premium otključan",referralActivity:"Preporuka potvrđena",systemAnnouncement:"Obavijest platforme",coinPurchase:"Kupnja Coina zabilježena",paymentStatus:"Status plaćanja",refundStatus:"Status povrata"}},activityTicker:{label:"Trenutne aktivnosti Bizowizo",supported:"podržano",coins:"Coins",newPitch:"Nova prezentacija",newCampaign:"Nova kampanja",livePitch:"Live pitch je sada aktivan.",liveBattle:"Live battle je sada aktivan.",newRole:{bizo:"Novi Bizo",wizo:"Novi Wizo"},empty:"Učitavanje trenutnih aktivnosti platforme."},upload:{title:"Prenesi pitch video",intro:"Maksimalno 60 sekundi kao MP4 ili WebM.",videoLabel:"Pitch video",sourceLanguageLabel:"Jezik govora u videu",sourceLanguageHint:"Koristi se za automatske titlove i prijevode.",captionsLabel:"Datoteka s titlovima (neobavezno)",captionsHint:"WEBVTT do 30 KB. Ako nema datoteke, titlovi se generiraju automatski.",captionsSelected:"Odabrana datoteka titlova",captionsAutomatic:"Nijedna datoteka nije odabrana – titlovi će biti generirani automatski.",titleLabel:"Naslov",categoryLabel:"Kategorija",descriptionLabel:"Opis",projectDetailsLabel:"Detalji projekta",goalCoinsLabel:"Potrebni coinsi",selectVideo:"Odaberite video",replaceVideo:"Zamijeni video",duration:"Trajanje videa",submit:"Objavi prezentaciju",uploading:"Objavljivanje prezentacije",loginRequired:"Prijavite se kao Bizo",roleRequired:"Ovo područje je za Bizos.",loadFailed:"Učitavanje Bizo profila nije uspjelo.",onboardingRequired:"Kreiraj Bizo profil",backToFeed:"Na feed pitchova",formTitle:"Projekt i prezentacija",formHint:"Sve se informacije prikazuju izravno u feedu.",errors:{VIDEO_TOO_LONG:"Video prezentacije može trajati najviše 60 sekundi.",VIDEO_NOT_9_16:"Molimo učitajte stvarni portretni video u omjeru 9:16 (npr. 1080 × 1920 piksela).",VIDEO_DURATION_UNREADABLE:"Nije moguće pročitati trajanje videa.",INVALID_VIDEO:"Video datoteku nije moguće obraditi.",UNSUPPORTED_VIDEO_TYPE:"Dozvoljeni su MP4 i WebM videozapisi.",VIDEO_TOO_LARGE:"Video datoteka je prevelika.",EMPTY_VIDEO:"Video datoteka je prazna.",VIDEO_REQUIRED:"Molimo odaberite video prezentacije.",CAPTIONS_TOO_LARGE:"Datoteka titlova ne smije premašiti 30 KB.",INVALID_CAPTIONS_VTT:"Molimo odaberite važeću WEBVTT datoteku titlova.",CAPTIONS_READ_FAILED:"Datoteku titlova nije moguće pročitati.",INVALID_PITCH_FIELDS:"Molimo provjerite sve podatke o projektu u potpunosti.",PITCH_UPLOAD_FAILED:"Objavljivanje prezentacije nije uspjelo.",BIZO_PROFILE_INCOMPLETE:"Vaš Bizo profil još nije dovršen. Nedostajući podaci navedeni su u nastavku.",UNAUTHENTICATED:"Molimo prijavite se ponovno.",BIZO_ROLE_REQUIRED:"Ovo područje je za Bizos."}}},Mm={brand:"BIZOWIZO",slogan:"Budi svoj!",website:"WWW.BIZOWIZO.COM",roles:{bizo:"BIZO",wizo:"WIZO"},account:{bizoTitle:"POČNI KAO BIZO!",wizoTitle:"DAJ SVE KAO WIZO.",usernameLabel:"Pokaži svoj stil:",displayNameLabel:"Profil ili identitet brenda",bioLabel:"Predstavi svoju viziju:",bizoFollowerLabel:"100 pratitelja",bizoBattleLabel:"Zdominiraj live bitke:",bizoCommunityLabel:"Razgovaraj sa svojom WIZO ekipom:",wizoFollowingLabel:"WIZO ekipa:",wizoRewardLabel:"Nagrade za angažman:"},live:"UŽIVO",coinMark:"B",hero:{title:"CROWD REVOLUTION 3.0",subtitle:"DOBRODOŠLI NA PRVU SVJETSKU PLATFORMU ZA CROWDFUNDING S KRATKIM VIDEOZAPISIMA!",paragraphs:["Na Bizowizo radi se o tome da stotinama tisuća kreativnih projekata diljem svijeta pružimo priliku za uzlet. A mi? Tu smo da potpuno promijenimo pravila igre – s live elementom kakvog dosad niste vidjeli! Recite zbogom dosadnim crowdfunding kampanjama iz prošlosti!","S 1-minutnim pitch videima, live pitch sesijama i akcijom nabijenim 5-minutnim live bitkama otvaramo potpuno nove dimenzije i mogućnosti za BIZOS da ožive svoje ideje. BIZOS privlače WIZO publiku u svoje live pitchove kako bi zaradili virtualne Coins, koje potom mogu pretvoriti u pravi novac.","Kreativni projekti, proizvodi i usluge zaslužuju pozornicu – izravno pred globalnom publikom, s povratnim informacijama u stvarnom vremenu, podrškom i punim blagajnama!","Uz naš integrirani coin sustav koji uključuje novčanike, Wizos mogu ulagati uživo i izravno u svoje omiljene Bizos, potaknuti ih na put prema uspjehu i oživjeti ih. S BIZOWIZO stvaramo euforičnu atmosferu za sve korisnike i otvaramo mogućnosti za pretvaranje snova u stvarnost!","Ovo je crowdfunding kakav dosad niste iskusili – a najbolji dio? Svaki dan činimo svijet malo boljim, inovativnijim i uspješnijim, istovremeno nudeći najbolje korisničko iskustvo ikada!","BizoWizo – platforma koja zauvijek mijenja pravila crowdfundinga! Pridružite nam se i iskusite budućnost crowdfundinga! LIVE"]},bizo:{title:"POČNI KAO BIZO!",items:["Pokaži svoj stil: Pokreni jedinstveni profil ili identitet brenda na BIZOWIZO s atraktivnim vizualnim elementima, porukama i live akcijom kako bi se zaista istaknuo.","Postavi ciljeve, zaradi Coins: Definiraj jasne ciljeve i iznos coin koji ti treba da u potpunosti angažiraš svoju WIZO zajednicu i pokreneš svoj projekt.","Predstavi svoju viziju: Iznesi što imaš! Podijeli svoj startup, ideju ili kreativni projekt uvjerljivim 1-minutnim pitch videima.","Dijeli snove, dosegnite 100 pratitelja, uključi se uživo: Nakon što postigneš prag od 100 pratitelja, uključi se uživo s nekoliko klikova i poveži se s publikom za trenutne povratne informacije.","Zdominiraj live bitke: Suoči se s drugim Bizos u akcijom nabijenim 5-minutnim pitch bitkama, pokaži svoju inovativnost i osvoji coins za svaku zaintrigirajuću izvedbu. Idemo!","Poveži se s drugim Bizos: Udruži se s drugim Bizos za epske live bitke i stvori jedinstvena iskustva za svoju publiku.","Zaradi coins uz podršku: Dobij virtualne Coins kao potporu od svog WIZO fan kluba. To nije samo novac, to je jasna potvrda tvog projekta.","Razgovaraj sa svojom WIZO ekipom: Neformalno ćaskaj sa svojim podržavateljima, drži ih u toku i izgradi svoju bazu fanova.","Dijeli bez prestanka: Povećaj vidljivost dijeleći svoje pitch videozapise i live bitke svuda i stvori ozbiljan odjek oko svog inovativnog puta. Krenimo!"]},pitch:{title:"VAŠ VIDEO PITCH",subtitle:"Vaša ulaznica za uspjeh!",paragraphs:["Zaronite u uzbudljivi svijet BIZOWIZO! Uz ultra-impresivan 1-minutni BIZO video pitch možete predstaviti svoj projekt na virtualnoj pozornici i zablistati. Ovo je više od običnog pitcha — to je upečatljiv nastup koji otvara put vašem uspjehu!","Sudjelujte u live pitchima i 5-minutnim live bitkama dok svoju hrabru viziju dijelite izravno sa svojim podržavateljima. Svaki trenutak je prilika da pokažete ne samo svoj projekt nego i san koji oblikuje budućnost.","Osjetite energiju strasti, inovacije i borbenog duha protiv drugih Bizos — ovo nije obična prezentacija, već prava moćna igra za vašu ideju!","Predstavite svoj pitch oduševljenoj publici WIZO i doživite magiju koja nastaje na sceni.","I najbolji dio? WIZOS nagrađuju vaše sudjelovanje u live pitchevima i live bitkama s Coins koji će katapultirati vaš pothvat na sasvim novu razinu!"],reactions:["Idemo, idemo, idemo","Ti ćeš to pokrenuti","Ti ćeš to pokrenuti","To je tvoja stvar, brate..."],display:{time:"3:00",coins:"250.000"}},battle:{title:"Live Pitch Bitke",intro:["Dobrodošli na Live Pitch Bitke, ultimativni okršaj gdje BIZOS bore za svoje snove, a inovacija eksplodira u samo 5 minute!","Ovdje nema ograničenja, samo hardcore business, puno akcije i, naravno, coins u igri!"],minutes:["(1 minute) BIZOS stupaju u centar pozornosti s čistom strašću i započinju. Svaki pristigli coin je digitalni aplauz, glas za pulsirajući san BIZOS.","(2 minute) Pitchovi teku. Tempo se pojačava. Publika WIZO drži sudbinu projekata u rukama. Tko će više uvjeriti Wizos svojim projektom?","(3 minute) BIZOS podižu napetost i pretvaraju live video pitch u mega dinamičnu priču. Coins se gomilaju poput gromoglasnog pljeska naše oduševljene publike WIZOS. Svaka sekunda je važna.","(4 minute) Pitch bitka doseže svoj vrhunac. Coins su vidljiv znak kolektivne podrške i odlučuju koji će san postati stvarnost.","(5 minute) Isteklo je vrijeme. Pobjednik je određen – njihov projekt je osvojio srca i coins. Bizowizo Live Pitch Bitka je završena, a pobjednički BIZO mogu uživati u sjaju uspjeha ili započeti novu rundu borbe za coins."],reactions:["Odličan posao, prijatelju","Wow, sjajno!","Idemo, idemo, idemo, idemo, idemo","Ti ćeš to pokrenuti"],display:{time:"4:30"}},wizo:{title:"DAJ SVE KAO WIZO.",items:["Provjerite ekskluzivnost: Nabavite poseban sadržaj i livestreamove od BIZOS samo za vas.","Uključi se: Oblikuj live iskustvo s BIZOS kroz komentare, virtualne poklone i napojnice.","Virtualna iznenađenja: Pošaljite virtualne poklone da pokažete svoju podršku.","Pridružite se live bitkama: Budite prisutni na live bitkama i oživite događaje na platformi.","Poticati projekte: Kupujte poklone i podržite projekte Bizos.","Povoljne ponude i popusti: Ugrabite ekskluzivne ponude i velike popuste na proizvode i usluge BIZO. ","Ekskluzivni događaji: Sudjelujte u posebnim događajima samo za vas kao dio Bizowizo ekipe.","Nagrade za angažman: Osvojite nagrade i priznanja za svoj angažman.","Razgovarajte s BIZOS: Razgovarajte izravno s BIZOS i pogledajte njihove projekte. Povežite se i uživajte!","WIZO squad: Pridružite se ekipi koja inovativne projekte podiže na višu razinu!","Zbogom oglasima: Uživajte u sadržaju bez oglasa, nabavite coins i recite zbogom reklamnim pauzama.","Priznanja za napredne korisnike: Aktivni WIZOS dobivaju dodatne nagrade za redovito sudjelovanje."]},coins:{title:"BIZOWIZO COINS",subtitle:"- VIRTUALNA VALUTA -",label:"VIRTUALNE COINS",paragraphs:["Nabavite bling-bling coins: WIZOS kupuju COINS za pristup VIP sadržaju, pretplaćuju se na BIZOS i šalju velike virtualne poklone uživo!","Swipe in, COINS out: WizOS unose podatke kreditne kartice, nadopunjuju svoj COIN BALANCE i onda sve počne! Tim COINS (također pokloni i napojnice) podržavaju Bizo objave i pojačavaju live dvoboje."],action:"KUPI COINS",rate:"1 BIZOWIZO COIN = 1 EUR"},coinPacks:[{coins:"5",price:"5.00 €"},{coins:"10",price:"10.00 €"},{coins:"15",price:"15.00 €"},{coins:"20",price:"20.00 €"}],coinSections:{coinPacksTitle:"KATALOG POKLONA",coinPacksSubtitle:"- 16 POKLONA -",giftsTitle:"VIRTUALNI POKLONI.",giftsSubtitle:"NOVO NA ULTRAWIZO",superPacksTitle:"MEGA POKLONI.",superPacksSubtitle:"- SUPERPAKETI -"},gifts:[{name:"STARTY",coins:"25",price:"25.00 €"},{name:"BOOMY",coins:"50",price:"50.00 €"},{name:"CASHY",coins:"75",price:"75.00 €"},{name:"TROVY",coins:"100",price:"100.00 €"},{name:"COINY",coins:"125",price:"125.00 €"},{name:"WIZY",coins:"150",price:"150.00 €"},{name:"CATCHY",coins:"175",price:"175.00 €"},{name:"TWINKY",coins:"200",price:"200.00 €"}],superPacks:[{name:"WIZYPRO",coins:"500",price:"500.00 €"},{name:"WIZYHERO",coins:"1.000",price:"1,000.00 €"},{name:"MEGAWIZO",coins:"2.500",price:"2,500.00 €"},{name:"ULTRAWIZO",coins:"5.000",price:"5,000.00 €"}],revenue:{title:"Kako BIZOWIZO zarađuje?",subtitle:"Zarađujemo s virtualnim COINS.",paragraphs:["Korisnici kupuju virtualne poklone pomoću COINS i šalju ih odabranim BIZOS. Svaki poslani poklon stavlja coins u blagajnu Bizowizo – izvrstan način za generiranje prihoda!","Bizowizo nudi 16 imenovanih virtualnih poklona od NOVA do ULTRAWIZO. Prije kupnje svaka kartica poklona prikazuje količinu Coin i obvezujuću cijenu u eurima po tečaju 1 Coin = 1 EUR. Interna obrada i poravnanje nisu javno razdvojeni.","BIZOS imaju priliku zaraditi označavanjem svog sadržaja kao ekskluzivnog putem naših premium značajki prijenosa uživo. WIZOS mogu otključati te ekskluzivne prijenose koristeći Coins. Bizowizo zarađuje proviziju na svakoj transakciji, osiguravajući pravednu naknadu za pruženu ekskluzivnu platformu.","Bizowizo također ostvaruje značajne prihode putem oglašavanja u aplikaciji od cool trećih strana! Provizija ovisi o tome koliko ljudi klikne ili kupi proizvode putem preporuka. Više akcije, više provizije – to je Bizowizo stil!"]},forecast:{title:"Otprilike ispada:",subtitle:"- COINS / PROJEKTI -",years:["2024","2025","2026","2027","2028"],rows:[{label:"Bizos / Projekti",values:["500","1.000","2.000","5.000","10.000"]},{label:"Wizos / Donatori",values:["500.000","1.000.000","2.000.000","5.000.000","10.000.000"]},{label:"Kupljeni Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]},{label:"Donirani Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]}],assumptions:["- Vrijednosti planiranja su interne pretpostavke modela i nisu jamstvo za rezultat","- Javno je vidljiv samo agregirani napredak kampanje"],assumptionsTitle:"PRETPOSTAVKE"},investor:{title:"ŽELITE LI SE PRIDRUŽITI BIZOWIZO KAO PRIJATELJ / INVESTITOR?",companyTitle:"TVRTKA IZA BIZOWIZO",company:"BIZOWIZO - Atmosfera počinje u Dubaiju! Startupi ovdje cvjetaju, a mi uživamo ne samo u najboljoj zajednici nego i u poreznoj slobodi te mnogim drugim pogodnostima.",amountTitle:"KOLIKO MOGU ULOŽITI I ŠTO ZA TO DOBIVAM?",amount:"Uzmite svoj dio kolača! U krugu obitelji i prijatelja možete dobiti do 10% udjela. Nudimo čak 1% udjela za samo €25,000. Budite dio kad poleti!",expectationTitle:"ŠTO MOGU OČEKIVATI I U KOJEM ROKU?",expectation:"Upozorenje bling-bling! Vidimo kako BIZOWIZO puca kroz krov i u trenu masivno polijeće! Vrijednost i prihodi bit će katapultirani u stratosferu!",actionTitle:"DA, ŽELIM!",action:"Pridružite se i osigurajte svoju kartu za najvruće ulaganje godine! Pošaljite nam kratku poruku i možda doživite najprofitabilnije iskustvo u svom životu! Email: edwin.davis@icloud.com"},copyright:"Copyright 2023 / EDWIN DAVIS"},ss="",iN={terms:{eyebrow:"Regeln der Plattform",title:"Nutzungsbedingungen",summary:"Diese Bedingungen beschreiben die Nutzung von Bizowizo durch Bizos, Wizos, Werbekunden und Agenturen.",shortNotice:ss,version:"Version 1.1",lastUpdated:"2. September 2026",sections:[{id:"scope",title:"1. Geltungsbereich und Anbieter",paragraphs:["Bizowizo ist eine Short-Video-Crowdfunding-Plattform. Bizos stellen Projekte in Pitchvideos, Kampagnen, Live-Pitches und Live-Battles vor. Wizos entdecken Projekte und können sie mit Coins unterstützen. Zusätzlich sind Premiuminhalte und ein Werbeprogramm vorgesehen.","Vertragspartner und Diensteanbieter ist Pitch60 Social Media Marketing Services - FZCO, IFZA Business Park, Premises No. 10742-001, Dubai, United Arab Emirates. Trade License issued by the Government of Dubai, Trade License No. 10742, Makani No. A1-3641379065."]},{id:"eligibility",title:"2. Teilnahme und Mindestalter",paragraphs:["Ein Konto darf nur mit richtigen, aktuellen und vollständigen Angaben eröffnet werden. Bis ein geprüftes Minderjährigen- und Elternzustimmungsmodell vorliegt, sind Coin-Käufe, Donations, Premiumfreischaltungen, Werbebuchungen und Bizo-Auszahlungen ausschließlich für volljährige Personen vorgesehen.","Unternehmen und Agenturen müssen durch eine vertretungsberechtigte Person handeln. Bizowizo kann geeignete Nachweise verlangen, soweit dies für Sicherheit, Zahlungen, gesetzliche Pflichten oder Missbrauchsschutz erforderlich ist."]},{id:"accounts",title:"3. Konto, Anmeldung und Rollen",paragraphs:["Nutzer schützen ihre Zugangsdaten und informieren Bizowizo unverzüglich über einen vermuteten unbefugten Zugriff. Ein Konto darf nicht verkauft, vermietet oder ohne Zustimmung übertragen werden.","Beim Onboarding wird die Plattformrolle Bizo oder Wizo gewählt. Diese Rolle ist aus Sicherheits- und Finanzgründen grundsätzlich dauerhaft. Rollenwechsel erfordern einen gesondert geprüften Prozess; ein zweites Konto zur Umgehung von Regeln ist unzulässig."]},{id:"content",title:"4. Inhalte und Nutzungsrechte",paragraphs:["Nutzer behalten ihre Rechte an eigenen Inhalten. Mit dem Hochladen räumen sie Bizowizo die für Speicherung, technische Verarbeitung, Anzeige, Untertitelung, Übersetzung, Moderation und plattformbezogene Bewerbung erforderlichen, nicht ausschließlichen Rechte für die Dauer der Veröffentlichung ein.","Es dürfen nur Inhalte hochgeladen werden, für die alle erforderlichen Rechte vorliegen. Das gilt besonders für Musik, Videos, Bilder, Marken, Dokumente, Persönlichkeitsrechte und vertrauliche Angaben. Rechtsverletzende oder täuschende Inhalte sind verboten."]},{id:"bizo-campaigns",title:"5. Pflichten von Bizos und Kampagnen",paragraphs:["Bizos müssen Projekt, Finanzierungsziel, Laufzeit, Risiken, Dokumente und Rewards verständlich und wahrheitsgemäß beschreiben. Wesentliche Änderungen sind transparent mitzuteilen. Eine automatische technische Freigabe ersetzt keine rechtliche, wirtschaftliche oder sachliche Prüfung des Projekts.","Bizos sind für die Durchführung ihres Projekts, versprochene Rewards, Kommunikation mit Unterstützern sowie erforderliche Steuern, Genehmigungen und Nachweise verantwortlich. Bizowizo garantiert weder Finanzierungserfolg noch Lieferung oder wirtschaftlichen Erfolg."]},{id:"wizo-support",title:"6. Unterstützung durch Wizos",paragraphs:["Eine Unterstützung ist kein Kauf von Unternehmensanteilen, kein Darlehen und keine Anlageberatung. Wizos erhalten nur den jeweils klar beschriebenen Reward oder digitalen Zugang. Ein Gewinn, eine Rendite oder eine Rückzahlung des unterstützten Betrags wird nicht versprochen.","Wizos prüfen Kampagneninformationen eigenverantwortlich. Bizowizo stellt Plattformfunktionen und Zahlungsabwicklung bereit, übernimmt aber keine Garantie für Aussagen oder Erfüllungspflichten eines Bizo."]},{id:"coins",title:"7. Coins, Support und virtuelle Geschenke",paragraphs:["Coins sind plattformgebundene, nicht übertragbare Nutzungseinheiten. Wizos erwerben eines der 16 benannten Geschenke von NOVA bis ULTRAWIZO; Coinanzahl und verbindlicher Europreis werden bei einem festen Verhältnis von 1 Coin = 1 EUR am jeweiligen Geschenk angezeigt. Coins sind kein gesetzliches Zahlungsmittel, Bankguthaben, Wertpapier oder Investment und können von Wizos nicht in Geld zurückgetauscht werden.","Geschenkkäufe werden ausschließlich über Stripe bezahlt und erst nach serverseitig bestätigter Zahlung gutgeschrieben. Refunds, Chargebacks und Fehlbuchungen erzeugen dokumentierte Gegenbuchungen; abgeschlossene Ledgerjournale werden nicht verändert oder gelöscht.","Die Plattform berechnet und zeigt ausschließlich einen zusammengefassten Kampagnenfortschritt. Seine interne Gewichtung und seine Bestandteile werden nicht öffentlich offengelegt. Der sichtbare Fortschritt ist von Battle-Bewertung, 1.000-Coin-Bewertungscap sowie späterer Bizo-Reward- und Auszahlungsberechnung getrennt. Die Sammlung schließt automatisch bei Zielerreichung oder spätestens am Ende des 60. Kampagnentags und kann nicht verlängert werden. Bestätigte Reversals aktualisieren den Gesamtfortschritt durch eine revisionssichere serverseitige Neuberechnung genau einmal.","Bestätigter Support wird als kampagnengebundenes Support-Commitment revisionssicher erfasst und bleibt unter M1 reserviert. Ab M1 kann nach den anwendbaren Reward-Regeln ein Bizo-Reward auf Grundlage des tatsächlich verifizierten bereinigten Nettoerlöses entstehen. Maßgeblich sind bestätigter Umsatz sowie tatsächliche Steuern, Refunds, Chargebacks und Zahlungs-, App-Store-, Connect- oder Auszahlungskosten. Prognosen begründen keinen Auszahlungsanspruch. Ein Reward bleibt bis zum Kampagnenende, vollständigem Stripe-Connect-/Prüfstatus und Ablauf der mindestens 30-tägigen Risikofrist gesperrt. Es besteht keine Einnahme- oder Auszahlungsgarantie."]},{id:"premium",title:"8. Premiuminhalte",paragraphs:["Ein Premium-Pitch kann einmalig mit dem angezeigten Coinbetrag freigeschaltet werden. Die Freischaltung gilt für das betreffende Wizo-Konto und den bezeichneten Pitch. Eine Freischaltung überträgt keine Urheber- oder Weiterverbreitungsrechte.","Premium-Livezugang wird erst nach Aktivierung der externen LiveKit-Infrastruktur angeboten. Ein sichtbarer Vorbereitungshinweis ist keine Zusage eines bereits verfügbaren Livestreams."]},{id:"live",title:"9. Live-Pitches und Live-Battles",paragraphs:["Bizos benötigen mindestens 100 echte Follower für Live-Pitches und mindestens 200 echte Follower für Live-Battles. Die Berechtigung wird serverseitig geprüft und kann bei Manipulation, Sicherheitsproblemen oder Regelverstößen entzogen werden.","Liveinhalte können verzögert, unterbrochen, moderiert oder beendet werden. Demo-Battles und Demo-Systemeffekte sind klar zu kennzeichnen und dürfen nicht als echte Nutzeraktivität oder echte Geldbewegung dargestellt werden."]},{id:"advertising",title:"10. Werbung und Agenturkonten",paragraphs:["Sobald das Werbeprogramm freigeschaltet ist, dürfen Privatpersonen, Unternehmen und Agenturen Anzeigen nur nach den dann gültigen Werberichtlinien buchen. Preise, Laufzeit, Platzierung und Budget werden vor Zahlung transparent angezeigt und serverseitig berechnet.","Werbung wird klar gekennzeichnet. Unzulässig sind insbesondere Täuschung, illegale Produkte, diskriminierende Zielgruppen, sensible Zielgruppenmerkmale und zielgerichtete Werbung an Minderjährige. Bizowizo kann Anzeigen vor oder nach Start ablehnen oder pausieren."]},{id:"payments",title:"11. Zahlungen, Rechnungen, Erstattungen und Auszahlungen",paragraphs:["Stripe ist der einzige Zahlungsdienstleister. Karten- und Bankdaten werden von Stripe verarbeitet und nicht vollständig bei Bizowizo gespeichert. Im Konto können nur sichere Metadaten wie Zahlungsart, Marke, letzte Ziffern und Status erscheinen.","Gesetzliche Widerrufs-, Gewährleistungs- und Erstattungsrechte bleiben unberührt. Besondere Informationen zu digitalen Geschenken, Support und dem Beginn der Leistung stehen in der Widerrufsinformation. Bizo-Auszahlungen erfolgen nur für verifizierte verfügbare Rewards nach erfüllten Kampagnen-, M1–M3-, Risikofrist-, Prüf- und Stripe-Connect-Voraussetzungen."]},{id:"conduct",title:"12. Verbotenes Verhalten",paragraphs:["Untersagt sind rechtswidrige Inhalte, Betrug, falsche Kampagnenangaben, künstliche Follower oder Interaktionen, Geldwäsche, Zahlungsmanipulation, Belästigung, Hass, Drohungen, Identitätsmissbrauch, Schadsoftware, Spam und die Umgehung technischer Schutzmaßnahmen.","Coins, Donations, Reviews, Kommentare, Rankings oder Werbeereignisse dürfen nicht automatisiert oder koordiniert manipuliert werden. Sicherheitslücken dürfen nur verantwortungsvoll an Bizowizo gemeldet und nicht ausgenutzt werden."]},{id:"moderation",title:"13. Moderation, Meldungen und Beschwerden",paragraphs:["Nutzer können Inhalte und Konten melden und andere Nutzer blockieren. Bizowizo kann Inhalte einschränken, entfernen, demonetarisieren oder Konten vorübergehend beziehungsweise dauerhaft sperren, wenn Regeln, Gesetze oder Sicherheitsanforderungen verletzt werden.","Soweit rechtlich erforderlich, erläutert Bizowizo wesentliche Moderationsentscheidungen und bietet einen internen Beschwerdeweg. Offensichtlich missbräuchliche Meldungen können eingeschränkt werden."]},{id:"availability",title:"14. Verfügbarkeit und Haftung",paragraphs:["Bizowizo bemüht sich um einen sicheren und verfügbaren Dienst, schuldet aber keine ununterbrochene Verfügbarkeit. Wartung, externe Anbieter, Netzwerke, höhere Gewalt oder Sicherheitsmaßnahmen können Funktionen vorübergehend einschränken.","Für Vorsatz, grobe Fahrlässigkeit sowie Schäden an Leben, Körper oder Gesundheit gelten die gesetzlichen Regeln. Im Übrigen richtet sich die Haftung nach dem anwendbaren Recht; zwingende Verbraucherrechte werden nicht beschränkt."]},{id:"termination",title:"15. Laufzeit, Kündigung und Kontolöschung",paragraphs:["Nutzer können ihr Konto nach Erfüllung offener Zahlungs-, Auszahlungs-, Moderations- und Aufbewahrungspflichten schließen. Gesetzliche Aufbewahrung, laufende Streitfälle, Betrugsprävention und unveränderliche Finanzjournale können eine sofortige vollständige Löschung begrenzen.","Bizowizo kann Konten aus wichtigem Grund sperren oder kündigen. Offene Nutzerrechte, Erstattungen und gesetzliche Ansprüche bleiben davon unberührt."]},{id:"changes",title:"16. Änderungen dieser Bedingungen",paragraphs:["Wesentliche Änderungen werden mit neuer Versionsnummer und angemessener Vorabinformation mitgeteilt. Soweit eine Zustimmung erforderlich ist, wird sie ausdrücklich eingeholt. Die bloße Weiternutzung ersetzt keine gesetzlich erforderliche Einwilligung."]},{id:"law",title:"17. Anwendbares Recht und Streitbeilegung",paragraphs:["Diese Bedingungen sind auf das in Dubai und den Vereinigten Arabischen Emiraten geltende Recht ausgerichtet. Zwingende Verbraucherschutzrechte bleiben unberührt.","Für Streitigkeiten sind – soweit gesetzlich zulässig – die zuständigen Gerichte beziehungsweise Streitbeilegungsstellen in Dubai oder den Vereinigten Arabischen Emiraten vorgesehen. Verbraucher können außerdem die zuständigen Beschwerdekanäle des UAE Ministry of Economy oder des Dubai Department of Economy and Tourism nutzen."]}]},privacy:{eyebrow:"Transparenz über Daten",title:"Datenschutzerklärung",summary:"Diese Erklärung beschreibt, welche personenbezogenen Daten Bizowizo für Plattform, Zahlungen, Medien, Kommunikation und Sicherheit verarbeitet.",shortNotice:ss,version:"Version 1.0",lastUpdated:"12. August 2026",sections:[{id:"controller",title:"1. Verantwortlicher und Kontakt",paragraphs:["Verantwortlicher für Bizowizo ist Pitch60 Social Media Marketing Services - FZCO, IFZA Business Park, Premises No. 10742-001, Dubai, United Arab Emirates. Trade License issued by the Government of Dubai, Trade License No. 10742, Makani No. A1-3641379065.","Für Datenschutzanfragen und die Kontaktaufnahme mit dem Betreiber ist info@bizowizo.ai die zentrale E-Mail-Adresse."]},{id:"scope",title:"2. Geltungsbereich",paragraphs:["Diese Erklärung gilt für Website, Web-App, Konten, Profile, Feeds, Kampagnen, Wallet, Zahlungen, Premium, Messenger, Kommentare, Reviews, Moderation und das künftige Werbeprogramm. Für eine spätere native App oder externe Social-Media-Auftritte können ergänzende Hinweise erforderlich sein."]},{id:"categories",title:"3. Welche Daten verarbeitet werden",paragraphs:["Je nach Nutzung verarbeitet Bizowizo Konto- und Kontaktdaten, Rollen- und Profildaten, öffentliche Inhalte, Medien und Dokumente, Follower- und Interaktionsdaten, Nachrichten, Moderations- und Sicherheitsdaten, technische Zugriffs- und Gerätedaten sowie Zahlungs- und Ledger-Metadaten."],bullets:["Konto: OpenID beziehungsweise spätere E-Mail, Anzeigename, Rolle, Sprache, Sitzungsdaten und Kontostatus.","Öffentliches Profil: Benutzername, Profilbild, Banner, Bio, Land/Ort und veröffentlichte Aktivitäten.","Projekt und Inhalte: Pitches, Videos, Captions, Kampagnen, Dokumente, Rewards, Kommentare und Rezensionen.","Kommunikation: private Messengerinhalte, Einladungen, Benachrichtigungen und Supportanfragen.","Finanzen: Stripe-Kunden-/Session-/Eventreferenzen, Kaufstatus, Coin- und Ledgerbuchungen, Donations, Holds und Auszahlungsstatus; keine vollständigen Karten-, CVC- oder Bankzugangsdaten.","Sicherheit: IP-/Zeit-/Geräteinformationen, Missbrauchssignale, Meldungen, Blockierungen, Moderations- und Auditdaten."]},{id:"purposes",title:"4. Zwecke und Rechtsgrundlagen",paragraphs:["Die konkrete Rechtsgrundlage hängt vom Zweck ab. Vertrag und vorvertragliche Maßnahmen tragen Konto, Plattformfunktionen, Coin-Kauf, Premium, Werbung und Auszahlung. Gesetzliche Pflichten betreffen insbesondere Buchhaltung, Zahlungsprüfung und Behördenanfragen. Berechtigte Interessen können Sicherheit, Missbrauchsschutz, Fehleranalyse und grundlegenden Plattformbetrieb tragen. Einwilligung wird für optionale Analyse, Marketing und andere nicht notwendige Verarbeitung verwendet."]},{id:"public-content",title:"5. Öffentliche Profile und Inhalte",paragraphs:["Veröffentlichte Profile, Pitches, Kampagnen, Kommentare, Reviews, Followerzahlen, Rankings und Battle-Ergebnisse können weltweit abrufbar und teilbar sein. Private Kontaktdaten, Wallet-IDs, E-Mails und Zahlungsdetails werden nicht absichtlich öffentlich ausgegeben.","Nutzer sollen keine vertraulichen oder besonders sensiblen Daten in öffentliche Inhalte aufnehmen. Suchmaschinen und Empfänger geteilter Links können öffentliche Inhalte unabhängig zwischenspeichern."]},{id:"payments",title:"6. Stripe, Coins und Auszahlungen",paragraphs:["Stripe verarbeitet Zahlungen, Zahlungsmethoden, Betrugsprävention, Identitätsprüfung und Bizo-Auszahlungen als eigenständiger Verantwortlicher oder Auftragsverarbeiter nach dem jeweiligen Dienst. Bizowizo erhält nur die für Status, Zuordnung, Support, Buchhaltung und Ledger notwendigen Referenzen und Metadaten.","Coin-Salden entstehen aus unveränderlichen Double-Entry-Ledgerbuchungen. Refunds und Disputes werden durch Gegenbuchungen nachvollziehbar. Gesetzliche Finanz- und Nachweispflichten können längere Aufbewahrung verlangen."]},{id:"media-ai",title:"7. Medien, Untertitel und Übersetzung",paragraphs:["Medienbytes werden in einem S3-kompatiblen Speicher abgelegt. Metadaten, Eigentum, Status und Speicherreferenzen liegen in der Plattformdatenbank. Für Transkription, Untertitel und Übersetzung können Audio, Text und erforderlicher Kontext an integrierte KI-Dienste übermittelt werden.","Private Messengertexte werden nur für den jeweiligen angemeldeten Empfänger übersetzt."]},{id:"communication",title:"8. Messenger, Benachrichtigungen und E-Mail",paragraphs:["Private Nachrichten werden für Zustellung, Gelesenstatus, Missbrauchsschutz und Meldungen verarbeitet. Benachrichtigungen enthalten nur die für das Ereignis notwendigen Angaben. Nachrichteninhalte werden nicht in öffentliche Aktivitätsfeeds übernommen.","Bestätigungs- und Passwortreset-E-Mails werden nur über dafür konfigurierte Zustellwege versendet."]},{id:"live",title:"9. LiveKit und Liveübertragung",paragraphs:["LiveKit Cloud ist als Infrastruktur für Live-Pitches und Battles vorgesehen. Bei Aktivierung können Raum-, Teilnehmer-, Verbindungs-, Audio-/Video- und technische Qualitätsdaten verarbeitet werden."]},{id:"analytics",title:"10. Cookies, lokale Speicherung und Analytics",paragraphs:["Notwendige Technologien speichern insbesondere Sitzung, Sprache, Datenschutzentscheidung, Soundpräferenz und Oberflächeneinstellungen. Das projektseitige Umami-Analytics-Skript wird erst nach einer optionalen Analytics-Einwilligung geladen.","Einwilligung kann jederzeit über „Cookie-Einstellungen“ im Footer widerrufen werden. Weitere Einzelheiten stehen in den Cookie-Hinweisen."]},{id:"recipients",title:"11. Empfänger und Dienstleister",paragraphs:["Empfänger können je nach Funktion Manus Hosting/Auth/Datenbank/Speicher, Stripe, E-Mail-Dienste, LiveKit, Übersetzungs-/Transkriptionsdienste, Supportanbieter, berufliche Berater und Behörden sein. Daten werden nur im erforderlichen Umfang und auf geeigneter Rechtsgrundlage übermittelt."]},{id:"transfers",title:"12. Internationale Datenübermittlungen",paragraphs:["Einzelne Dienstleister können Daten außerhalb des Sitzstaats des Betreibers verarbeiten. In diesem Fall werden die nach dem anwendbaren Recht der Vereinigten Arabischen Emirate erforderlichen vertraglichen, technischen und organisatorischen Schutzmaßnahmen geprüft und dokumentiert."]},{id:"retention",title:"13. Speicherdauer",paragraphs:["Daten werden nur so lange gespeichert, wie sie für den jeweiligen Zweck, Vertrag, Sicherheitsnachweis oder gesetzliche Pflichten benötigt werden. Kontodaten können nach Löschung entfallen; öffentliche Inhalte werden entfernt oder anonymisiert, soweit keine Rechte oder Pflichten entgegenstehen.","Ledger-, Stripe-, Rechnungs-, Audit-, Moderations- und Streitfalldaten können wegen gesetzlicher Aufbewahrung, Betrugsprävention und Rechtsverteidigung länger gespeichert werden. Konkrete Fristen richten sich nach dem Löschkonzept."]},{id:"rights",title:"14. Rechte betroffener Personen",paragraphs:["Betroffene Personen können nach den gesetzlichen Voraussetzungen Auskunft, Berichtigung, Löschung, Einschränkung, Datenübertragbarkeit und Widerspruch verlangen. Eine Einwilligung kann jederzeit für die Zukunft widerrufen werden.","Außerdem besteht ein Beschwerderecht bei der zuständigen Datenschutzaufsichtsbehörde nach anwendbarem VAE-Recht."]},{id:"automation",title:"15. Automatisierte Regeln und Profiling",paragraphs:["Follower-Schwellen, Kampagnenvollständigkeit, Rankings, Betrugsindikatoren und Moderationsprioritäten können automatisiert berechnet werden. Sie begründen derzeit keine ausschließlich automatisierte Entscheidung mit vergleichbar erheblicher rechtlicher Wirkung; risikoreiche Maßnahmen werden administrativ prüfbar gehalten.","Ein Werbesystem darf keine sensiblen Daten zur Zielgruppenbildung verwenden und keine zielgerichtete Werbung an Minderjährige ausspielen."]},{id:"minors-security",title:"16. Minderjährige und Datensicherheit",paragraphs:["Bis ein geprüftes Alters- und Elternzustimmungsmodell vorliegt, sind zahlungsbezogene Funktionen nur für Volljährige vorgesehen. Verdächtige Minderjährigenkonten können eingeschränkt werden.","Bizowizo setzt rollenbasierte Zugriffe, sichere Cookies, serverseitige Validierung, Rate Limits, signierte Webhooks, verschlüsselte Übertragung, S3-Zugriffsschutz und unveränderliche Finanzjournale ein. Kein System kann absolute Sicherheit garantieren."]},{id:"changes-contact",title:"17. Änderungen und Datenschutzkontakt",paragraphs:["Diese Erklärung wird bei neuen Anbietern, Funktionen oder Rechtsgrundlagen aktualisiert. Wesentliche Änderungen werden angemessen mitgeteilt.","Für Datenschutzanfragen und die Kontaktaufnahme mit dem Betreiber ist info@bizowizo.ai die zentrale E-Mail-Adresse."]}]},imprint:{eyebrow:"Anbieterkennzeichnung",title:"Impressum",summary:"Anbieterinformationen für Bizowizo.",shortNotice:ss,version:"Version 1.0",lastUpdated:"12. August 2026",sections:[{id:"provider",title:"Anbieter des digitalen Dienstes",paragraphs:["Pitch60 Social Media Marketing Services - FZCO","IFZA Business Park, Premises No. 10742-001, Dubai, United Arab Emirates","Trade License issued by the Government of Dubai, Trade License No. 10742, Makani No. A1-3641379065"]},{id:"contact",title:"Kontakt",paragraphs:["Zentrale E-Mail-Adresse für Betreiber- und Datenschutzanfragen: info@bizowizo.ai."]},{id:"register",title:"Register und Steuerangaben",paragraphs:["Trade License issued by the Government of Dubai, Trade License No. 10742","Makani No. A1-3641379065"]},{id:"editorial-dsa",title:"Inhaltliche Verantwortung und DSA-Kontakt",paragraphs:["Kontaktstelle für Behörden und Nutzer: info@bizowizo.ai"]},{id:"dispute",title:"Verbraucherschlichtung",paragraphs:["Verbraucher können die zuständigen Beschwerdekanäle des UAE Ministry of Economy oder des Dubai Department of Economy and Tourism nutzen.","Die frühere EU-Plattform zur Online-Streitbeilegung wird nicht verlinkt, da sie eingestellt wurde."]},{id:"copyright",title:"Marke und Urheberrecht",paragraphs:["Bizowizo, das Bold-B-Zeichen und plattformeigene Medien sind marken- beziehungsweise urheberrechtlich geschützt. Nutzerinhalte verbleiben bei ihren jeweiligen Rechteinhabern.","Ursprungsunterlage: Copyright 2023 / EDWIN DAVIS."]}]},community:{eyebrow:"Sicher miteinander",title:"Community-Richtlinien",summary:"Diese Regeln schützen Bizos, Wizos, Projekte und die Glaubwürdigkeit von Unterstützung und Werbung.",shortNotice:ss,version:"Version 1.1",lastUpdated:"8. September 2026",sections:[{id:"respect",title:"1. Respekt und Sicherheit",paragraphs:["Behandle andere Menschen respektvoll. Belästigung, Drohungen, Hass, Entmenschlichung, sexualisierte Übergriffe, Doxxing und Aufrufe zu Gewalt sind nicht erlaubt."]},{id:"authenticity",title:"2. Echtheit und Vertrauen",paragraphs:["Keine falschen Identitäten, erfundenen Projekterfolge, manipulierten Follower, gekauften Interaktionen oder koordinierten Schein-Donations. Demo-Inhalte müssen als Demo erkennbar bleiben."]},{id:"campaigns",title:"3. Ehrliche Kampagnen",paragraphs:["Bizos erklären Ziel, Verwendung der Mittel, Risiken, Zeitplan und Rewards wahrheitsgemäß. Wesentliche Probleme oder Änderungen werden zeitnah mitgeteilt. Betrug, Schneeballsysteme und unrealistische Renditeversprechen sind verboten."]},{id:"rights",title:"4. Rechte, Privatsphäre und Minderjährige",paragraphs:["Veröffentliche nur Inhalte, Musik, Bilder und Dokumente, für die du die Rechte besitzt. Teile keine privaten Daten anderer Personen. Inhalte mit Minderjährigen erfordern besondere Sorgfalt und alle notwendigen Zustimmungen."]},{id:"platform-content",title:"5. Beiträge, Fremdfirmen und Werbung",paragraphs:["Mit jedem Upload bestätigst du, dass du den Inhalt selbst erstellt hast oder alle erforderlichen Nutzungs-, Musik-, Marken-, Bild-, Persönlichkeits- und sonstigen Rechte sowie Einwilligungen besitzt. Inhalte, Logos, Produkte, Geschäftsgeheimnisse oder Werbemittel fremder Unternehmen dürfen ohne nachweisbare Berechtigung nicht hochgeladen werden.","Unaufgeforderte Werbung, Spam, verdeckte Verkaufsangebote, Affiliate- oder Referral-Werbung außerhalb der vorgesehenen Bizowizo-Funktionen sowie irreführende geschäftliche Behauptungen sind verboten. Zulässige Werbung muss die Werberichtlinie erfüllen und klar als Werbung gekennzeichnet sein.","Bizowizo kann gemeldete oder auffällige Inhalte prüfen, vorläufig ausblenden, entfernen oder ihre Reichweite beschränken und bei wiederholten oder schweren Verstößen Kontofunktionen sperren. Rechteinhaber und Betroffene können den Meldeweg am Inhalt oder Profil nutzen; gesetzliche Auskunfts-, Beschwerde- und Rechtsbehelfswege bleiben unberührt."]},{id:"live",title:"6. Live-Pitches und Battles",paragraphs:["Liveformate dürfen nicht für gefährliche Handlungen, Erniedrigung, Glücksspiel, Zahlungsdruck oder künstliche Donation-Manipulation genutzt werden. Moderatoren können Streams unterbrechen oder beenden."]},{id:"commerce",title:"7. Zahlungen, Werbung und verbotene Angebote",paragraphs:["Umgehe Stripe oder Bizowizo-Wallet nicht durch verdeckte Zahlungsaufforderungen. Illegale Waren, Waffen, Drogen, Ausbeutung, betrügerische Finanzangebote und andere verbotene Leistungen dürfen nicht beworben oder finanziert werden.","Werbung muss als Werbung erkennbar sein und darf keine sensiblen Merkmale oder Minderjährige für Zielgruppenbildung verwenden."]},{id:"enforcement",title:"8. Maßnahmen",paragraphs:["Je nach Schwere kann Bizowizo Reichweite begrenzen, Inhalte entfernen, Monetarisierung oder Livezugang sperren, Auszahlungen prüfen und Konten vorübergehend oder dauerhaft schließen. Finanzdaten werden nicht gelöscht, sondern rechtssicher gesperrt oder durch Gegenbuchungen korrigiert."]},{id:"report-appeal",title:"9. Melden und Beschwerde",paragraphs:["Nutze die Meldefunktion am Inhalt oder Profil und beschreibe den Grund konkret. Betroffene erhalten, soweit rechtlich zulässig, eine Begründung und einen Weg zur internen Überprüfung. Akute Gefahren gehören zusätzlich an die zuständigen Behörden oder Notrufstellen."]}]},cookies:{eyebrow:"Datenschutz-Einstellungen",title:"Cookie- und Speicherhinweise",summary:"Bizowizo trennt notwendige Sitzungstechnik von optionaler Reichweitenmessung und lädt Analytics erst nach Einwilligung.",shortNotice:ss,version:"Version 1.0",lastUpdated:"12. August 2026",sections:[{id:"necessary",title:"1. Notwendige Technologien",paragraphs:["Notwendige Cookies und Browserspeicher ermöglichen Anmeldung, Sicherheit, Sprache, Datenschutzentscheidung, Rückleitung nach Login sowie Audio- und Oberflächeneinstellungen. Ohne sie funktionieren wesentliche gewünschte Funktionen nicht zuverlässig."],bullets:["Sitzungscookie: hält eine sichere Anmeldung aufrecht.","Locale-Speicher: merkt die gewählte Sprache.","Datenschutzspeicher: merkt die Entscheidung zu optionaler Analytics.","Session-Speicher: merkt Rücksprung und Tonpräferenzen nur für die aktuelle Sitzung.","Oberflächenspeicher: merkt lokale Einstellungen wie die Breite der Admin-Sidebar."]},{id:"analytics",title:"2. Optionale Analytics",paragraphs:["Bizowizo verwendet eine projektseitig konfigurierte Umami-Reichweitenmessung nur nach ausdrücklicher Einwilligung. Sie dient der technischen und inhaltlichen Verbesserung.","Es werden derzeit keine Werbe- oder Social-Media-Pixel durch Bizowizo geladen. Das künftige Werbeprogramm darf diese Aussage erst nach einer neuen Prüfung ändern."]},{id:"choice",title:"3. Deine Auswahl",paragraphs:["Beim ersten Besuch kannst du nur notwendige Technologien verwenden oder Analytics zusätzlich erlauben. Beide Möglichkeiten sind gleichwertig erreichbar. Nicht notwendige Analytics wird vor der Entscheidung nicht geladen."]},{id:"withdraw",title:"4. Einwilligung ändern oder widerrufen",paragraphs:["Öffne jederzeit „Cookie-Einstellungen“ im Footer. Eine Änderung gilt für die Zukunft. Bereits rechtmäßig verarbeitete Daten werden dadurch nicht rückwirkend unzulässig; Lösch- oder Widerspruchsrechte können zusätzlich bestehen."]},{id:"browser",title:"5. Browser-Einstellungen",paragraphs:["Browser können Cookies und lokale Speicher blockieren oder löschen. Dadurch können Anmeldung, Sprache, Wallet, Videoeinstellungen oder andere gewünschte Funktionen beeinträchtigt werden."]},{id:"changes",title:"6. Änderungen",paragraphs:["Neue Analyse-, Werbe- oder Drittanbietertechnologien werden erst nach Aktualisierung dieses Hinweises und – soweit erforderlich – erneuter Einwilligung aktiviert."]}]},withdrawal:{eyebrow:"Information für Verbraucher",title:"Widerruf und Rückerstattung",summary:"Information zu Widerruf, digitalen Leistungen, Geschenkkäufen, Premiumzugang, Support und Rückerstattungen.",shortNotice:ss,version:"Version 1.0",lastUpdated:"12. August 2026",sections:[{id:"scope",title:"1. Für wen diese Information gilt",paragraphs:["Diese Information richtet sich an Verbraucher. Unternehmen und Agenturen besitzen grundsätzlich kein gesetzliches Verbraucherwiderrufsrecht."]},{id:"period",title:"2. Widerrufsfrist",paragraphs:["Bei einem einschlägigen Fernabsatzvertrag besteht grundsätzlich eine Frist von vierzehn Tagen ab Vertragsschluss. Der Widerruf muss eindeutig erklärt werden und benötigt keine Begründung."]},{id:"digital",title:"3. Sofortige digitale Leistung",paragraphs:["Soll ein digitales Geschenk oder Premiumzugang sofort bereitgestellt werden, kann das Widerrufsrecht nur unter den gesetzlichen Voraussetzungen vorzeitig erlöschen. Dazu gehören insbesondere eine ausdrückliche, nicht vorangekreuzte Zustimmung zum sofortigen Beginn, die bestätigte Kenntnis des Rechtsverlusts und eine Bestätigung auf einem dauerhaften Datenträger.","Fehlt eine Voraussetzung, wird ein Widerrufsrecht nicht allein durch Nutzung der Website ausgeschlossen."]},{id:"donations",title:"4. Support, Geschenke und ausgeführte Buchungen",paragraphs:["Bestätigte Geschenkkäufe und ausgeführter Support erzeugen nachvollziehbare, unveränderliche Primär- und Commitment-Buchungen; es erfolgt keine automatische Nennwertaufteilung. Refunds, Chargebacks oder gesetzlich erforderliche Rückabwicklungen werden ausschließlich durch dokumentierte Gegenbuchungen verarbeitet. Ob und in welchem Umfang ein ausgeführter Support widerrufbar oder erstattungsfähig ist, richtet sich nach seiner endgültigen rechtlichen Einordnung und zwingenden Verbraucherrechten; diese dürfen nicht pauschal zu Lasten von Verbrauchern ausgeschlossen werden."]},{id:"refunds",title:"5. Refunds, Streitfälle und Mängelrechte",paragraphs:["Widerruf, freiwillige Erstattung, Chargeback und gesetzliche Mängelrechte sind unterschiedliche Vorgänge. Bestätigte Refunds oder Streitfälle werden technisch durch Gegenbuchungen verarbeitet; das ursprüngliche Journal bleibt erhalten.","Gesetzliche Rechte bei nicht erbrachter oder mangelhafter digitaler Leistung bleiben unabhängig von einem Widerruf bestehen."]},{id:"exercise",title:"6. Widerruf erklären",paragraphs:["Widerrufserklärungen können an info@bizowizo.ai gerichtet werden.","Seit 19. Juni 2026 kann für einschlägige Onlineverträge zusätzlich eine elektronische Widerrufsfunktion erforderlich sein."]},{id:"consequences",title:"7. Folgen eines wirksamen Widerrufs",paragraphs:["Im Fall eines wirksamen Widerrufs werden empfangene Zahlungen nach den gesetzlichen Regeln und grundsätzlich über dasselbe Zahlungsmittel zurückgezahlt, soweit nichts anderes zulässig vereinbart wurde. Bereits erbrachte Dienstleistungen können unter gesetzlichen Voraussetzungen zu Wertersatz führen."]}]}};function Dn(e){return{...e,shortNotice:"",version:e.version.replace(/^Entwurf\s+/,"Version ")}}const ls=rr(iN,"de"),oN={terms:Dn(ls.terms),privacy:Dn(ls.privacy),imprint:Dn(ls.imprint),community:Dn(ls.community),cookies:Dn(ls.cookies),withdrawal:Dn(ls.withdrawal),ambassador:Dn(nr.de)},pt={pitchBoost:si.de,pitchDonationTicker:li.de,ambassador:ur.de,ads:di.de,adReporting:pi.de,commercialAccount:ui.de,common:{save:"Speichern",cancel:"Abbrechen"},donationEffects:{live:"Live Support",sent:"schickt",coins:"Coins",support:"Support",soundOn:"Donation-Sound einschalten",soundOff:"Donation-Sound ausschalten",previewBadge:"Effektvorschau",previewTitle:"Live-Donation-Effekte",previewDescription:"Reine Vorschau – keine Coin-Buchung und keine echte Donation.",previewSender:"Wizo Demo"},home:{login:"Login",startBizo:"Als Bizo starten",startWizo:"Als Wizo starten",howItWorksEyebrow:"Idee zeigen · Kampagne starten · Support gewinnen",howItWorksTitle:"So geht Bizowizo",howItWorksStepsLabel:"So funktioniert Bizowizo in drei Schritten",howItWorksPitch:"Pitch",howItWorksLive:"Live",howItWorksSupport:"Support",howItWorksStep1Title:"Idee zeigen. Kampagne starten.",howItWorksStep1Body:"Profil erstellen, 60-Sekunden-Pitch hochladen und Kampagne für 60 Tage starten.",howItWorksStep1Label:"Profil · 60-Sekunden-Pitch · 60 Tage",howItWorksStep2Title:"Mit deiner Community live überzeugen",howItWorksStep2Body:"Erreiche 100 echte Follower für Live Pitch. Erreiche 200 für Live Battle und tritt live für deine Idee an.",howItWorksStep2Label:"100 Follower · Live Pitch · 200 Follower · Live Battle",howItWorksStep3Title:"Kampagne abschließen. Verfügbarkeit prüfen.",howItWorksStep3Body:"Kampagne abschließen, Gebühren und Reversals prüfen und die 30-tägige Risikofrist abwarten. Verfügbare Bizo-Rewards können danach über Stripe ausgezahlt werden.",howItWorksStep3Label:"M1–M3 · Prüfung · Risikofrist",startNow:"Jetzt starten!",toFeed:"Zum Feed",feed:"Pitch-Feed",shortVideoCrowdfunding:"Short-Video-C