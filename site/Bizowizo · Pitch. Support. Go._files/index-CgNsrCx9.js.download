{const d=t[t.length-1],p=t[t.length-2];if((d.x-p.x)*(s.y-p.y)>=(d.y-p.y)*(s.x-p.x))t.pop();else break}t.push(s)}return t.pop(),i.length===1&&t.length===1&&i[0].x===t[0].x&&i[0].y===t[0].y?i:i.concat(t)}var O2=SS,B2=OS,I2=BS,C2=IS,A2=CS,E2=xS;function TS({delayDuration:e=0,...i}){return u.jsx(O2,{"data-loc":"client/src/components/ui/tooltip.tsx:11","data-slot":"tooltip-provider",delayDuration:e,...i})}function x2({...e}){return u.jsx(TS,{"data-loc":"client/src/components/ui/tooltip.tsx:23",children:u.jsx(B2,{"data-loc":"client/src/components/ui/tooltip.tsx:24","data-slot":"tooltip",...e})})}function T2({...e}){return u.jsx(I2,{"data-loc":"client/src/components/ui/tooltip.tsx:32","data-slot":"tooltip-trigger",...e})}function N2({className:e,sideOffset:i=0,children:t,...r}){return u.jsx(C2,{"data-loc":"client/src/components/ui/tooltip.tsx:42",children:u.jsxs(A2,{"data-loc":"client/src/components/ui/tooltip.tsx:43","data-slot":"tooltip-content",sideOffset:i,className:Te("bg-foreground text-background animate-in fade-in-0 zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 z-50 w-fit origin-(--radix-tooltip-content-transform-origin) rounded-md px-3 py-1.5 text-xs text-balance",e),...r,children:[t,u.jsx(E2,{"data-loc":"client/src/components/ui/tooltip.tsx:53",className:"bg-foreground fill-foreground z-50 size-2.5 translate-y-[calc(-50%_-_2px)] rotate-45 rounded-[2px]"})]})})}const NS="Pitch60 Social Media Marketing Services - FZCO",mt={brand:"BIZOWIZO",slogan:"Do Your thing!",website:"WWW.BIZOWIZO.COM",roles:{bizo:"BIZO",wizo:"WIZO"},account:{bizoTitle:"STARTE DURCH ALS BIZO!",wizoTitle:"GEHE ALL IN ALS WIZO.",usernameLabel:"Zeig deine Vibes:",displayNameLabel:"Profil- oder Markenidentität",bioLabel:"Pitch deine Vision:",bizoFollowerLabel:"100 Follower für Live Pitch · 200 für Battle",bizoBattleLabel:"Live-Battles rocken:",bizoCommunityLabel:"Talk mit deiner WIZO-Crew:",wizoFollowingLabel:"WIZO-Squad:",wizoRewardLabel:"Rewards fürs Engagement:"},live:"LIVE",coinMark:"B",hero:{title:"CROWD REVOLUTION 3.0",subtitle:"HERZLICH WILLKOMMEN AUF DER WELTWEIT ERSTEN SHORT-VIDEO-CROWDFUNDING-PLATTFORM!",paragraphs:["Bei Bizowizo dreht sich alles darum, Hunderttausenden von kreativen Projekten weltweit die Chance zu geben, durchzustarten. Und wir? Wir sind hier, um das Game komplett zu verändern – mit einem Live-Touch, den ihr so noch nicht gesehen habt! Schluss mit dem langweiligen Crowdfunding-Kampagnen von gestern!","Mit 1-minütigen Pitch-Videos, Livepitch-Sessions und actionreichen 5-minütigen Live-Battles eröffnen wir BIZOS völlig neue Dimensionen und Chancen um ihre Ideen in die Tat umzusetzen. BIZOS reißen das WIZO-Publikum mit ihren Live-Piches mit, um virtuelle Coins zu verdienen, die sie dann in klingende Münze umwandeln können.","Kreative Projekte, Produkte und Services verdienen bei uns die Bühne – direkt vor einem globalen Publikum, in Echtzeit Feedback, Support und vollen Kassen!","Mit unseren integrierten Coin-System inklusive Wallets können Wizos live und direkt in ihre Lieblings-Bizos investieren, sie auf dem Weg zum Erfolg pushen und zum Leben erwecken. Mit BIZOWIZO schaffen wir eine euphorische Atmosphäre für alle User und eröffnen Chancen, aus Träumen Realität werden zu lassen!","Das ist Crowdfunding, wie ihr es noch nie erlebt habt – und das Beste? Wir machen die Welt jeden Tag ein bisschen besser, innovativer, erfolgreicher und bieten dabei das beste User-Erlebnis aller Zeiten!","BizoWizo – die Plattform, die das Crowdfunding-Spiel für immer verändert! Seid dabei und erlebt mit uns die Zukunft des Crowdfundings! LIVE"]},bizo:{title:"STARTE DURCH ALS BIZO!",items:["Zeig deine Vibes: Kickstarte auf BIZOWIZO deine einzigartige Profil- oder Markenidentität mit coolen visuellen Elementen, Messages und Live-Action, damit du richtig auffällst.","Ziele setzen, Coins kassieren: Definiere klare Ziele und den Coin-Betrag, den du brauchst, um deine WIZO-Community voll einzubeziehen und dein Projekt richtig anzuschieben.","Pitch deine Vision: Knall raus, was du drauf hast! Teile mit überzeugenden 1-minütigen Pitch-Videos dein Startup, deine Idee oder dein kreatives Projekt.","Träume teilen und live gehen: Ab 100 echten Followern startest du Live Pitch. Ab 200 echten Followern trittst du im Battle gegen andere Bizos an.","Live-Battles rocken: Stell dich anderen Bizos in actiongeladenen 5-minütigen Pitch-Battles, zeig deine Innovation und räum Münzen für jeden fesselnden Auftritt ab. Let's go!","Connecte mit anderen Bizos: Mach gemeinsame Sache mit anderen Bizos für epische Live-Battles und schaff einzigartige Erlebnisse für dein Publikum.","Verdien Münzen mit Support: Hol dir virtuelle Coins als Backing von deinem WIZO-Fanclub. Das sind nicht nur Zaster, sondern auch ein klare Zustimmung zu deinem Projekt.","Talk mit deiner WIZO-Crew: Quatsch locker mit deinen Unterstützern, halt sie auf dem Laufenden und bau dir 'ne eigene Fanbase auf.","Teile nonstop: Booste deine Bekanntheit, indem du deine Pitch-Videos und Live-Battles überall teilst und für ordentlich Buzz um deine innovative Reise sorgst. Let's roll!"]},pitch:{title:"DEIN PITCH VIDEO",subtitle:"Deine Eintrittskarte zum Erfolg!",paragraphs:["Tauche ein in die aufregende Welt von BIZOWIZO! Mit einem ultracoolen 1-minütigen BIZO-Pitch-Video kannst du dein Projekt auf der virtuellen Bühne präsentieren und für Furore sorgen. Das ist mehr als nur ein Pitch - das ist eine mitreißende Performance, die den Weg zu deinem Erfolg ebnet!","Mische mit bei den Live-Pitches und 5-minütigen Live-Battles, während du deine kühne Vision direkt mit deinen Unterstützern teilst. Jeder Moment ist eine Chance, nicht nur dein Projekt, sondern auch den Traum, der die Zukunft prägt, zu zeigen.","Spüre die Energie von Leidenschaft, Innovation und dem Kampfgeist gegen andere Bizos - das ist keine gewöhnliche Präsentation, sondern ein echtes Powerplay für deine Idee!","Starte dein Pitch vor einem begeisterten WIZO-Publikum und erlebe den Zauber der in Szene gesetzt wird.","Und das Beste daran? WIZOS belohnen deine Teilnahme an den Live-Pitches und Live-Battles mit Coins, die dein Vorhaben auf ein völlig neues Level katapultieren werden!"],reactions:["go go go","You will make it go","You will make it go","your thing bro..."],display:{time:"3:00",coins:"250.000"}},battle:{title:"Live Pitch Battles",intro:["Willkommen zu den Live Pitch Battles, dem ultimativen Showdown, wo BIZOS für ihre Träume kämpfen und Innovation in nur 5 Minuten durch die Decke geht!","Hier gibt's keine Limits, nur krasses Business, jede Menge Action und natürlich Coins in die Kasse!"],minutes:["(1 Minute) Die BIZOS betreten das Rampenlicht mit purer Leidenschaft und starten durch. Jeder eintreffende Coin ist dabei ein digitaler Jubelschrei, eine Stimme für den pulsierenden Traum der BIZOS.","(2 Minute) Die Pitches laufen. Das Tempo steigt. Das WIZO-Publikum hat das Schicksal der Projekte fest in der Hand. Wer wird die Wizos mit seinem Projekt mehr überzeugen?","(3 Minute) BIZOS heizen die Auseinandersetzung ordentlich an und verwandeln den Live-Video-Pitch in eine mega dynamische Geschichte. Coins häufen sich an wie ein donnernder Applaus von unseren begeisterten WIZOS. Jede Sekunde zählt.","(4 Minute) Der Pitch-Battle erreicht seinen absoluten Höhepunkt. Coins sind das sichtbare Zeichen für die kollektive Unterstützung und entscheiden welcher Traum zur Realität wird.","(5 Minute) Die Uhr ist abgelaufen. Der Gewinner steht fest – sein Projekt hat nicht nur Herzen, sondern auch die Coins erobert. Das Bizowizo Live Pitch Battle ist vorbei, und der siegreiche BIZO kann jetzt im Glanz seines Erfolgs schwelgen oder eine neue Runde im Kampf um Coins starten."],reactions:["Great job buddy","Wow awesome","Go go go go go","You will make it go"],display:{time:"4:30"}},wizo:{title:"GEHE ALL IN ALS WIZO.",items:["Check die Exklusivität: Hol dir spezielle Inhalte und Live-Streams von BIZOS nur für dich.","Mischt euch ein: Gestaltet die Live-Erfahrung mit BIZOS durch Kommentare, virtuelle Geschenke und Trinkgelder.","Virtuelle Überraschungen: Schick virtuelle Geschenke, um deine Unterstützung zu zeigen.","Ab ins Live-Battle: Sei am Start bei Live-Battles und rock das Geschehen auf der Plattform.","Projekte pushen: Kauf Münzen und push die Projekte der BIZOS.","Deals und Rabatte: Schnapp dir exklusive Deals und dicke Rabatte auf BIZOS-Goodies und -Services.","Exclusive Events: Mach mit bei besonderen Events, nur für dich als Teil der Bizowizo-Crew.","Rewards fürs Engagement: Räum Belohnungen und Props für dein Engagement ab.","Quatsch mit BIZOS: Komm direkt mit den BIZOS ins Gespräch und check ihre Projekte. Let's vibe!","WIZO-Squad: Join die Crew, die innovative Projekte auf die nächste Stufe pusht!","Adieu, Werbung: Gönn dir werbefreie Action, hol dir Coins und mach Schluss mit Werbepausen.","Props für Power-User: Aktive WIZOS kriegen extra Goodies für ihre regelmäßige Teilnahme."]},coins:{title:"BIZOWIZO COINS",subtitle:"- DIE VIRTUELLE WÄHRUNG-",label:"VIRTUELLE COINS",paragraphs:["Hol dir die Bling-Bling Coins: WIZOS kaufen sich COINS, um VIP-Content zu checken, BIZOS zu abonnieren und live mit fetten Geschenken zu ballern!","Swipe rein, COINS raus: WIZOS ballern Kreditkarten rein, pumpen ihr COIN GUTHABEN auf und dann geht's los! Mit diesen COINS (auch Geschenke und Trinkgelder) rocken sie die BIZO-Beiträge und pushen Live-Battles."],action:"HOL DIR COINS",rate:"1 BIZOWIZO COIN = 1 EUR"},coinPacks:[{coins:"5",price:"5,00 €"},{coins:"10",price:"10,00 €"},{coins:"15",price:"15,00 €"},{coins:"20",price:"20,00 €"}],coinSections:{coinPacksTitle:"GESCHENKKATALOG",coinPacksSubtitle:"- 16 GESCHENKE -",giftsTitle:"VIRTUELLE GESCHENKE.",giftsSubtitle:"NOVA BIS ULTRAWIZO",superPacksTitle:"MEGA GESCHENKE.",superPacksSubtitle:"- SUPERPACKS -"},gifts:[{name:"STARTY",coins:"25",price:"25,00 €"},{name:"BOOMY",coins:"50",price:"50,00 €"},{name:"CASHY",coins:"75",price:"75,00 €"},{name:"TROVY",coins:"100",price:"100,00 €"},{name:"COINY",coins:"125",price:"125,00 €"},{name:"WIZY",coins:"150",price:"150,00 €"},{name:"CATCHY",coins:"175",price:"175,00 €"},{name:"TWINKY",coins:"200",price:"200,00 €"}],superPacks:[{name:"WIZYPRO",coins:"500",price:"500,00 €"},{name:"WIZYHERO",coins:"1.000",price:"1.000,00 €"},{name:"MEGAWIZO",coins:"2.500",price:"2.500,00 €"},{name:"ULTRAWIZO",coins:"5.000",price:"5.000,00 €"}],revenue:{title:"Wie verdient BIZOWIZO?",subtitle:"WIR VERDIENEN MIT VIRTUELLEN COINS.",paragraphs:["Nutzer erwerben virtuelle Geschenke mit COINS und schicken sie an ausgewählte BIZOS. Jedes versendete Geschenk spült Coins in die Bizowizo-Kasse – eine großartige Möglichkeit, Umsatz zu generieren!","Bizowizo bietet 16 benannte virtuelle Geschenke von NOVA bis ULTRAWIZO an. Jedes Geschenk zeigt vor dem Kauf transparent Coinzahl und verbindlichen Europreis bei 1 Coin = 1 EUR. Die interne Verarbeitung und Abrechnung wird nicht öffentlich aufgeschlüsselt.","BIZOS haben die Gelegenheit, durch die Markierung ihres Inhalts als exklusiv über unsere Premium-Live-Streaming-Funktionen Geld zu verdienen. WIZOS können diese exklusiven Streams durch den Einsatz von Coins freischalten. Bei jeder Transaktion verdient Bizowizo eine Provision, was einen fairen Austausch für die bereitgestellte exklusive Plattform darstellt.","Bizowizo macht ordentlich Kasse durch In-App-Werbung von coolen Drittanbietern! Die Provision hängt davon ab, wie viele Leute daraufklicken oder die Produkte über Empfehlungen kaufen. Mehr Action, mehr Provision – das ist der Bizowizo-Style!"]},forecast:{title:"Was kommt in etwa raus:",subtitle:"- COINS / PROJEKTE-",years:["2024","2025","2026","2027","2028"],rows:[{label:"Bizos / Projekte",values:["500","1.000","2.000","5.000","10.000"]},{label:"Wizos / Donators",values:["500.000","1.000.000","2.000.000","5.000.000","10.000.000"]},{label:"Gekaufte Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]},{label:"Gespendete Coins",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]}],assumptions:["- Planwerte sind interne Modellannahmen und keine Ergebniszusage","- Öffentlich sichtbar ist ausschließlich der aggregierte Kampagnenfortschritt"],assumptionsTitle:"ANNAHMEN"},investor:{title:"DU WILLST ALS FREUND / INVESTOR BEI BIZOWIZO DABEI SEIN ?",companyTitle:"DIE FIRMA HINTER BIZOWIZO",company:"BIZOWIZO - Der Vibe beginnt in Dubai! Hier sprießen Startups, und wir genießen nicht nur die coolste Community, sondern auch Steuerfreiheit und jede Menge andere Vorteile.",amountTitle:"WIEVIEL KANN ICH INVESTIEREN FÜR WAS?",amount:"Schnapp dir dein Stück vom Kuchen! In der Family & Friends Runde kannst du bis zu 10% der Anteile abstauben. Wir hauen sogar einen 1% Anteil für nur 25.000€ raus. Sei dabei, wenn's abgeht!",expectationTitle:"WAS KANN ICH ERWARTEN UND IN WELCHEM ZEITRAUM?",expectation:"Bling-Bling Alert! Wir sehen BIZOWIZO durch die Decke schießen und in kürzester Zeit mega durchstarten! Die Bewertung und der Umsatz werden in die Stratosphäre katapultiert!",actionTitle:"JA, ICH WILL DABEI SEIN!",action:"Sei dabei und sicher dir deine Eintrittskarte für das heißeste Investment des Jahres! Schreib uns eine kurze Nachricht und erlebe vielleicht das profitabelste Abenteuer deines Lebens! E-Mail: edwin.davis@icloud.com"},copyright:"Copyright 2023 / EDWIN DAVIS"},R2={de:mt,en:_a(mt,mT),es:_a(mt,fT),ar:_a(mt,BT),zh:_a(mt,LT),hi:_a(mt,HT),hr:_a(mt,Mm),bs:pe(_a(mt,Mm),"bs"),sr:pe(_a(mt,Mm),"sr")},ci=XP(R2),D2="/manus-storage/bizowizo-official-geometric-bw-glyph-transparent-v1_f1c25fba.png",f6="/manus-storage/bizowizo-official-geometric-b-white-transparent-v1_542cbdbd.png",L2="/manus-storage/bizowizo-official-geometric-frame-transparent-v1_2bc383a2.png",W2="/manus-storage/bizowizo-official-geometric-bw-glyph-transparent-v1_f1c25fba.png";function nc({className:e="",title:i}){return u.jsx("img",{"data-loc":"client/src/components/BrandMark.tsx:20",src:D2,alt:i??"",className:e,style:{objectFit:"contain",objectPosition:"center",padding:"4%"},draggable:!1})}function Xn({compact:e=!1,inverted:i=!1,symbolOnly:t=!1,hideWordmarkOnMobile:r=!1,headerMotion:s=!1}){return u.jsxs("span",{"data-loc":"client/src/components/BrandMark.tsx:40",className:`bizowizo-brand-mark inline-flex items-center ${s?"bizowizo-brand-mark--header-motion":""} ${e?"gap-3":"gap-4"}`,"data-brand-mark-motion":s?"header-b-to-w":void 0,"aria-label":ci.brand,children:[u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:45",className:`bizowizo-brand-mark__symbol grid shrink-0 place-items-center overflow-visible bg-transparent ${s?"":"drop-shadow-[0_8px_18px_rgba(253,224,71,.18)]"} ${e?"size-11":"size-16"}`,"aria-hidden":"true",children:s?u.jsxs("span",{"data-loc":"client/src/components/BrandMark.tsx:47",className:"bizowizo-brand-mark__motion-stage",children:[u.jsx("img",{"data-loc":"client/src/components/BrandMark.tsx:48",src:W2,alt:"",className:"bizowizo-brand-mark__glyph",draggable:!1}),u.jsx("img",{"data-loc":"client/src/components/BrandMark.tsx:54",src:L2,alt:"",className:"bizowizo-brand-mark__frame",draggable:!1}),u.jsxs("svg",{"data-loc":"client/src/components/BrandMark.tsx:60",viewBox:"0 0 120 120",className:"bizowizo-brand-mark__edge-light","aria-hidden":"true",focusable:"false",children:[u.jsx("defs",{"data-loc":"client/src/components/BrandMark.tsx:66",children:u.jsxs("linearGradient",{"data-loc":"client/src/components/BrandMark.tsx:67",id:"bizowizo-header-edge-light-gradient",x1:"0",y1:"0",x2:"1",y2:"1",children:[u.jsx("stop",{"data-loc":"client/src/components/BrandMark.tsx:68",offset:"0",stopColor:"#C084FC"}),u.jsx("stop",{"data-loc":"client/src/components/BrandMark.tsx:69",offset:"0.46",stopColor:"#FFF8D2"}),u.jsx("stop",{"data-loc":"client/src/components/BrandMark.tsx:70",offset:"1",stopColor:"#FFD400"})]})}),u.jsx("rect",{"data-loc":"client/src/components/BrandMark.tsx:73","data-brand-mark-frame-light":!0,className:"bizowizo-brand-mark__edge-light-path",x:"12.2",y:"12.2",width:"95.6",height:"95.6",rx:"14.4",pathLength:"100",fill:"none",stroke:"url(#bizowizo-header-edge-light-gradient)",strokeWidth:"0.8",strokeLinecap:"round",vectorEffect:"non-scaling-stroke"})]})]}):u.jsx(nc,{"data-loc":"client/src/components/BrandMark.tsx:91",className:"bizowizo-brand-mark__glyph size-full"})}),!t&&u.jsxs("span",{"data-loc":"client/src/components/BrandMark.tsx:95","data-brand-mark-wordmark":!0,className:`${r?"hidden sm:inline":""} font-black uppercase leading-none tracking-[-0.085em] ${e?"text-[1.08rem] sm:text-[1.16rem]":"text-[1.65rem] sm:text-[1.85rem]"}`,style:{fontFamily:'"Sora", ui-sans-serif, system-ui, sans-serif'},children:[u.jsxs("span",{"data-loc":"client/src/components/BrandMark.tsx:100","data-brand-mark-name":!0,children:[u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:100",children:ci.brand.slice(0,4)}),u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:100",children:ci.brand.slice(4)})]}),u.jsxs("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-mark-tagline":!0,"aria-label":"Pitch. Support. Go.",children:[u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-part":"pitch",children:"Pitch"}),u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-dot":!0,children:"."})," ",u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-part":"support",children:"Support"}),u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-dot":!0,children:"."})," ",u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-part":"go",children:"Go"}),u.jsx("span",{"data-loc":"client/src/components/BrandMark.tsx:101","data-brand-tagline-dot":!0,children:"."})]})]})]})}const jt={version:"Advertising Policy v1",updated:"30 August 2026"},RS={en:{...jt,navLabel:"Advertising policy",eyebrow:"Bizowizo advertising standards",title:"Advertising policy",summary:"Rules for advertisers, agencies, creatives, targeting, payment, delivery, review and complaints on Bizowizo.",print:"Print policy",back:"Back to advertising",sections:[{id:"scope",title:"1. Scope and advertiser responsibility",paragraphs:["This policy applies to individuals, businesses, agencies, campaigns, ad groups, creatives, destinations and paid delivery on Bizowizo. Advertisers are responsible for their account information, rights, claims, targeting instructions and legal compliance in every market where an ad is delivered."],bullets:["Advertising must be identifiable as Advertising or Sponsored.","Organic rankings, support, gifts and Bizo Rewards cannot be bought or manipulated through advertising.","An approval or payment does not guarantee reach, engagement, support or business results."]},{id:"prohibited",title:"2. Prohibited and restricted content",paragraphs:["Bizowizo may reject, pause or remove advertising that is illegal, unsafe, deceptive, discriminatory, exploitative or incompatible with the platform."],bullets:["Illegal goods or services, weapons, drugs, tobacco or nicotine, sexual exploitation, hate, harassment, violence or dangerous challenges.","Fraud, impersonation, malware, deceptive destinations, hidden fees, false scarcity, guaranteed income or misleading investment, health or performance claims.","Gambling, political, financial, health, alcohol, age-restricted or other regulated categories require prior written eligibility and may remain unavailable.","Ads directed at minors must not exploit inexperience, encourage unsafe conduct or use inappropriate targeting."]},{id:"creative",title:"3. Creative and destination requirements",paragraphs:["Each creative requires a valid media file, headline, description, secure HTTP(S) destination, call to action, language, age rating, policy category and visible advertising label. The advertiser must own or license all media, music, marks and claims."],bullets:["Labels must remain visible and must not be obscured.","The landing page must match the ad, load securely and disclose material terms.","Before review, the advertiser must expressly confirm the mandatory label and supplied compliance information."]},{id:"review",title:"4. Review, enforcement and audit",paragraphs:["Accounts, campaigns, ad groups and creatives are subject to server-authoritative review. Bizowizo may approve, reject, pause, suspend or archive them with a recorded reason. Review decisions, status changes and financial events are retained in auditable logs."],bullets:["A previous approval does not prevent later action when content, destination, law or risk changes.","Repeated or serious breaches may restrict an account.","Pending or rejected campaigns are not delivered."]},{id:"pricing",title:"5. Pricing, payment and delivery",paragraphs:["Media budget, duration, included platform delivery and any applicable tax are shown before payment. CPM and reach figures are projections only. Stripe processes advertising payments separately from Coins, gifts, support, WIZO VIP commissions and Bizo Rewards."],bullets:["The browser cannot set the payable amount; the server-authoritative campaign and price version control checkout.","Payment, failure, refund and dispute events are deduplicated and written to a separate monetary journal.","Refund eligibility depends on delivered service, payment status, mandatory law and documented review; a request is not an automatic entitlement."]},{id:"data",title:"6. Data, targeting and Stripe consent",paragraphs:["Targeting uses only the options made available in the advertising portal. Sensitive personal traits must not be inferred or uploaded for targeting. Before checkout, the payer must expressly authorize the required transfer of campaign, billing, contact and technical checkout data to Stripe."],bullets:["Marketing, analytics and other optional processing remain subject to their separate consent and withdrawal rules.","The checkout consent version and UTC confirmation time are recorded with the advertising payment.","Agents and agencies must have authority to act for each managed client."]},{id:"complaints",title:"7. Reporting, complaints and contact",paragraphs:["Users can report a sponsored item from its visible moderation controls. Reports create an auditable complaint for review. Advertisers can challenge a decision through the account contact path; urgent legal or safety concerns can be sent to info@bizowizo.ai."],bullets:["Reporting does not require interacting with the advertiser's destination.","Knowingly abusive reports or attempts to evade enforcement are prohibited.","Mandatory consumer and statutory rights remain unaffected."]}]},de:{...jt,navLabel:"Werberichtlinien",eyebrow:"Bizowizo Werbestandards",title:"Werberichtlinien",summary:"Regeln für Werbekunden, Agenturen, Werbemittel, Zielgruppen, Zahlungen, Auslieferung, Prüfung und Beschwerden bei Bizowizo.",print:"Richtlinie drucken",back:"Zurück zu Werben",sections:[{id:"scope",title:"1. Geltungsbereich und Verantwortung",paragraphs:["Diese Richtlinie gilt für Privatpersonen, Unternehmen, Agenturen, Kampagnen, Anzeigengruppen, Werbemittel, Zielseiten und bezahlte Auslieferung bei Bizowizo. Werbekunden verantworten Kontodaten, Rechte, Aussagen, Zielgruppenvorgaben und die Rechtskonformität in jedem Ausspielungsmarkt."],bullets:["Werbung muss sichtbar als Werbung oder Sponsored gekennzeichnet sein.","Organische Rankings, Support, Geschenke und Bizo-Rewards dürfen nicht durch Werbung gekauft oder manipuliert werden.","Freigabe oder Zahlung garantieren keine Reichweite, Interaktion, Unterstützung oder Geschäftsergebnisse."]},{id:"prohibited",title:"2. Verbotene und eingeschränkte Inhalte",paragraphs:["Bizowizo kann Werbung ablehnen, pausieren oder entfernen, wenn sie rechtswidrig, unsicher, täuschend, diskriminierend, ausbeuterisch oder plattformwidrig ist."],bullets:["Illegale Waren oder Dienste, Waffen, Drogen, Tabak/Nikotin, sexuelle Ausbeutung, Hass, Belästigung, Gewalt oder gefährliche Challenges.","Betrug, Identitätstäuschung, Schadsoftware, irreführende Zielseiten, versteckte Kosten, falsche Verknappung, Einkommensgarantien oder täuschende Anlage-, Gesundheits- und Leistungsversprechen.","Glücksspiel, politische, finanzielle, gesundheitliche, alkoholbezogene, altersbeschränkte oder sonst regulierte Kategorien benötigen eine vorherige schriftliche Freigabe und können ausgeschlossen bleiben.","An Minderjährige gerichtete Werbung darf Unerfahrenheit nicht ausnutzen, kein unsicheres Verhalten fördern und keine ungeeignete Zielgruppenauswahl verwenden."]},{id:"creative",title:"3. Anforderungen an Werbemittel und Zielseiten",paragraphs:["Jedes Werbemittel benötigt eine gültige Mediendatei, Überschrift, Beschreibung, sichere HTTP(S)-Ziel-URL, Handlungsaufforderung, Sprache, Altersfreigabe, Richtlinienkategorie und sichtbare Werbekennzeichnung. Alle Medien, Musiken, Marken und Aussagen müssen rechtmäßig genutzt werden dürfen."],bullets:["Kennzeichnungen müssen sichtbar bleiben und dürfen nicht verdeckt werden.","Die Zielseite muss zur Anzeige passen, sicher laden und wesentliche Bedingungen offenlegen.","Vor der Prüfung müssen Werbekunden Kennzeichnung und Complianceangaben ausdrücklich bestätigen."]},{id:"review",title:"4. Prüfung, Durchsetzung und Audit",paragraphs:["Konten, Kampagnen, Anzeigengruppen und Werbemittel unterliegen einer serverautoritativen Prüfung. Bizowizo kann sie mit dokumentierter Begründung freigeben, ablehnen, pausieren, sperren oder archivieren. Entscheidungen, Statusänderungen und Finanzereignisse werden auditierbar protokolliert."],bullets:["Eine frühere Freigabe schließt spätere Maßnahmen bei Inhalts-, Zielseiten-, Rechts- oder Risikoänderungen nicht aus.","Wiederholte oder schwere Verstöße können ein Konto einschränken.","Ausstehende oder abgelehnte Kampagnen werden nicht ausgeliefert."]},{id:"pricing",title:"5. Preise, Zahlung und Auslieferung",paragraphs:["Mediabudget, Laufzeit, enthaltene Plattformleistung und gegebenenfalls anwendbare Steuer werden vor der Zahlung angezeigt. CPM- und Reichweitenwerte sind ausschließlich Prognosen. Stripe verarbeitet Werbezahlungen getrennt von Coins, Geschenken, Support, WIZO-VIP-Provisionen und Bizo-Rewards."],bullets:["Der Browser bestimmt keinen Zahlbetrag; serverautoritatives Kampagnen- und Preisversionsmodell steuert den Checkout.","Zahlung, Fehler, Refund und Dispute werden dedupliziert in einem getrennten Geldjournal protokolliert.","Refundberechtigung richtet sich nach erbrachter Leistung, Zahlungsstatus, zwingendem Recht und dokumentierter Prüfung; ein Antrag begründet keinen automatischen Anspruch."]},{id:"data",title:"6. Daten, Zielgruppen und Stripe-Einwilligung",paragraphs:["Zielgruppen verwenden ausschließlich die im Werbeportal angebotenen Optionen. Sensible persönliche Merkmale dürfen nicht für Targeting abgeleitet oder hochgeladen werden. Vor dem Checkout muss der Zahlende die erforderliche Übermittlung von Kampagnen-, Rechnungs-, Kontakt- und technischen Checkoutdaten an Stripe ausdrücklich erlauben."],bullets:["Marketing, Analyse und andere optionale Verarbeitungen folgen ihren getrennten Einwilligungs- und Widerrufsregeln.","Consentversion und UTC-Bestätigungszeit werden an der Werbezahlung gespeichert.","Agenturen müssen zur Handlung für jeden verwalteten Kunden berechtigt sein."]},{id:"complaints",title:"7. Meldung, Beschwerde und Kontakt",paragraphs:["Nutzer können einen gesponserten Inhalt über dessen sichtbare Moderationssteuerung melden. Die Meldung erzeugt einen auditierbaren Beschwerdefall. Werbekunden können Entscheidungen über ihren Kontokontakt beanstanden; dringende Rechts- oder Sicherheitshinweise gehen an info@bizowizo.ai."],bullets:["Für eine Meldung ist kein Aufruf der Werbezielseite erforderlich.","Wissentlich missbräuchliche Meldungen und Umgehungsversuche sind untersagt.","Zwingende Verbraucher- und gesetzliche Rechte bleiben unberührt."]}]},es:{...jt,navLabel:"Política publicitaria",eyebrow:"Normas publicitarias de Bizowizo",title:"Política publicitaria",summary:"Reglas para anunciantes, agencias, creatividades, segmentación, pagos, entrega, revisión y reclamaciones.",print:"Imprimir política",back:"Volver a publicidad",sections:[{id:"scope",title:"1. Alcance y responsabilidad",paragraphs:["La política se aplica a cuentas, campañas, grupos, creatividades, destinos y entrega pagada. El anunciante responde por sus datos, derechos, afirmaciones, segmentación y cumplimiento en cada mercado."],bullets:["La publicidad debe identificarse como Publicidad o Sponsored.","No se pueden comprar ni manipular rankings orgánicos, Support, regalos ni Bizo Rewards.","La aprobación o el pago no garantizan alcance ni resultados."]},{id:"prohibited",title:"2. Contenido prohibido o restringido",paragraphs:["Bizowizo puede rechazar, pausar o retirar publicidad ilegal, peligrosa, engañosa, discriminatoria o explotadora."],bullets:["Bienes ilegales, armas, drogas, tabaco/nicotina, explotación sexual, odio, acoso, violencia o retos peligrosos.","Fraude, suplantación, malware, destinos engañosos, costes ocultos, escasez falsa o promesas garantizadas de ingresos, inversión, salud o rendimiento.","Juego, política, finanzas, salud, alcohol y categorías restringidas por edad requieren autorización previa y pueden no estar disponibles.","No se puede explotar la inexperiencia de menores ni usar segmentación inadecuada."]},{id:"creative",title:"3. Creatividad y destino",paragraphs:["Cada creatividad necesita medio válido, título, descripción, URL HTTP(S) segura, CTA, idioma, edad, categoría normativa y etiqueta publicitaria visible. El anunciante debe disponer de todos los derechos."],bullets:["La etiqueta no puede ocultarse.","El destino debe coincidir con el anuncio y revelar condiciones materiales.","La información de cumplimiento se confirma antes de revisión."]},{id:"review",title:"4. Revisión y auditoría",paragraphs:["Bizowizo puede aprobar, rechazar, pausar, suspender o archivar con motivo registrado. Decisiones, estados y eventos financieros quedan auditados."],bullets:["Una aprobación previa no impide actuar ante cambios.","Incumplimientos graves o repetidos pueden restringir la cuenta.","Campañas pendientes o rechazadas no se entregan."]},{id:"pricing",title:"5. Precio, pago y entrega",paragraphs:["Presupuesto, duración, servicio incluido e impuestos aplicables se muestran antes del pago. CPM y alcance son estimaciones. Stripe procesa la publicidad por separado de Coins, regalos, Support, comisiones y Bizo Rewards."],bullets:["El servidor controla el importe.","Pago, fallo, reembolso y disputa se deduplican en un diario monetario separado.","Un reembolso depende del servicio entregado, pago, ley aplicable y revisión."]},{id:"data",title:"6. Datos y consentimiento de Stripe",paragraphs:["Solo se usan las opciones de segmentación ofrecidas; no se permiten rasgos sensibles inferidos o cargados. Antes del checkout, el pagador autoriza expresamente el envío a Stripe de los datos necesarios."],bullets:["El tratamiento opcional conserva su propio consentimiento.","Versión y hora UTC del consentimiento se guardan con el pago.","Las agencias deben estar autorizadas por cada cliente."]},{id:"complaints",title:"7. Denuncias y contacto",paragraphs:["Los usuarios pueden denunciar un contenido patrocinado desde sus controles visibles. Se crea una reclamación auditable. Contacto: info@bizowizo.ai."],bullets:["No es necesario abrir el destino.","Se prohíben denuncias abusivas y evasiones.","Los derechos legales obligatorios no se ven afectados."]}]},ar:{...jt,navLabel:"سياسة الإعلانات",eyebrow:"معايير إعلانات Bizowizo",title:"سياسة الإعلانات",summary:"قواعد المعلنين والوكالات والمواد والاستهداف والدفع والعرض والمراجعة والشكاوى.",print:"طباعة السياسة",back:"العودة إلى الإعلانات",sections:[{id:"scope",title:"1. النطاق والمسؤولية",paragraphs:["تسري السياسة على الحسابات والحملات والمجموعات والمواد والوجهات والعرض المدفوع. يتحمل المعلن مسؤولية البيانات والحقوق والادعاءات والاستهداف والامتثال في كل سوق."],bullets:["يجب تمييز الإعلان بوضوح.","لا يجوز شراء أو التلاعب بالترتيب العضوي أو الدعم أو الهدايا أو مكافآت Bizo.","لا تضمن الموافقة أو الدفع الوصول أو النتائج."]},{id:"prohibited",title:"2. المحتوى المحظور والمقيّد",paragraphs:["يجوز لـ Bizowizo رفض أو إيقاف أو إزالة الإعلان غير القانوني أو الخطر أو المضلل أو التمييزي أو الاستغلالي."],bullets:["السلع غير القانونية والأسلحة والمخدرات والتبغ/النيكوتين والاستغلال الجنسي والكراهية والتحرش والعنف والتحديات الخطرة.","الاحتيال وانتحال الهوية والبرمجيات الخبيثة والوجهات المضللة والرسوم المخفية والندرة الزائفة وضمانات الدخل أو الادعاءات الاستثمارية والصحية المضللة.","القمار والسياسة والمال والصحة والكحول والفئات العمرية المقيّدة تتطلب موافقة مسبقة وقد تبقى غير متاحة.","يحظر استغلال قلة خبرة القاصرين أو استهدافهم بشكل غير مناسب."]},{id:"creative",title:"3. متطلبات المادة والوجهة",paragraphs:["تتطلب كل مادة ملفًا صالحًا وعنوانًا ووصفًا ورابط HTTP(S) آمنًا ودعوة ولغة وتصنيفًا عمريًا وفئة سياسة ووسم إعلان ظاهرًا، مع امتلاك الحقوق اللازمة."],bullets:["يجب ألا يُحجب الوسم.","يجب أن تطابق الوجهة الإعلان وتكشف الشروط المهمة.","تُؤكد بيانات الامتثال قبل المراجعة."]},{id:"review",title:"4. المراجعة والتدقيق",paragraphs:["يجوز لـ Bizowizo الموافقة أو الرفض أو الإيقاف أو التعليق أو الأرشفة بسبب مسجل. تُحفظ القرارات والحالات والأحداث المالية في سجل قابل للتدقيق."],bullets:["لا تمنع الموافقة السابقة إجراءً لاحقًا عند تغير المخاطر.","قد تؤدي المخالفات الخطرة أو المتكررة إلى تقييد الحساب.","لا تُعرض الحملات المعلقة أو المرفوضة."]},{id:"pricing",title:"5. السعر والدفع والعرض",paragraphs:["تظهر الميزانية والمدة والخدمة والضريبة المطبقة قبل الدفع. CPM والوصول تقديرات فقط. يعالج Stripe الإعلان منفصلًا عن Coins والهدايا والدعم والعمولات ومكافآت Bizo."],bullets:["الخادم يحدد المبلغ.","تُسجل حالات الدفع والفشل والاسترداد والنزاع في دفتر مالي منفصل دون تكرار.","يعتمد الاسترداد على الخدمة والحالة والقانون والمراجعة."]},{id:"data",title:"6. البيانات وموافقة Stripe",paragraphs:["تُستخدم خيارات الاستهداف المتاحة فقط ولا يجوز استنتاج السمات الحساسة أو تحميلها. قبل الدفع يصرح الدافع صراحة بإرسال البيانات اللازمة إلى Stripe."],bullets:["للمعالجة الاختيارية موافقاتها المنفصلة.","تُسجل نسخة الموافقة ووقتها UTC مع الدفعة.","يجب أن تكون الوكالة مخولة من كل عميل."]},{id:"complaints",title:"7. الإبلاغ والاتصال",paragraphs:["يمكن للمستخدم الإبلاغ عن المحتوى الممول من أدواته الظاهرة، فتُنشأ شكوى قابلة للتدقيق. للتواصل: info@bizowizo.ai."],bullets:["لا يلزم فتح وجهة الإعلان.","يحظر إساءة استخدام البلاغات أو تجاوز الإنفاذ.","تبقى الحقوق القانونية الإلزامية محفوظة."]}]},zh:{...jt,navLabel:"广告政策",eyebrow:"Bizowizo 广告标准",title:"广告政策",summary:"适用于广告主、代理机构、素材、定向、付款、投放、审核与投诉的规则。",print:"打印政策",back:"返回广告",sections:[{id:"scope",title:"1. 范围与责任",paragraphs:["本政策适用于广告账户、活动、广告组、素材、目标页面与付费投放。广告主对资料、权利、声明、定向和各投放市场的合规负责。"],bullets:["广告必须明确标识。","不得通过广告购买或操纵自然排名、支持、礼物或 Bizo Rewards。","批准或付款不保证触达或结果。"]},{id:"prohibited",title:"2. 禁止与受限内容",paragraphs:["Bizowizo 可拒绝、暂停或移除违法、危险、欺骗、歧视或剥削性广告。"],bullets:["非法商品、武器、毒品、烟草/尼古丁、性剥削、仇恨、骚扰、暴力或危险挑战。","欺诈、冒充、恶意软件、误导目的地、隐藏费用、虚假稀缺、保证收入或误导性投资、健康及效果声明。","博彩、政治、金融、健康、酒精及年龄限制类别需事先书面许可，也可能不开放。","不得利用未成年人经验不足或进行不当定向。"]},{id:"creative",title:"3. 素材与目的地要求",paragraphs:["每个素材必须包含有效媒体、标题、说明、安全 HTTP(S) 网址、CTA、语言、年龄分级、政策类别及可见广告标识，并具备全部使用权。"],bullets:["标识不得遮挡。","目的地必须与广告一致并披露重要条件。","审核前须明确确认合规资料。"]},{id:"review",title:"4. 审核与审计",paragraphs:["Bizowizo 可记录理由后批准、拒绝、暂停、限制或归档。决定、状态与财务事件保留可审计记录。"],bullets:["先前批准不妨碍风险变化后的行动。","严重或重复违规可限制账户。","待审或拒绝活动不投放。"]},{id:"pricing",title:"5. 价格、付款与投放",paragraphs:["付款前显示预算、期限、所含服务和适用税费。CPM 与触达仅为估算。Stripe 广告付款与 Coins、礼物、支持、佣金及 Bizo Rewards 分开处理。"],bullets:["金额由服务器控制。","付款、失败、退款与争议在独立货币日志中去重记录。","退款取决于已交付服务、付款状态、强制法律与审核。"]},{id:"data",title:"6. 数据与 Stripe 同意",paragraphs:["仅使用门户提供的定向选项，不得推断或上传敏感属性。付款前，付款人须明确授权向 Stripe 发送必要资料。"],bullets:["可选处理保留独立同意。","同意版本与 UTC 时间随付款保存。","代理机构须获得每位客户授权。"]},{id:"complaints",title:"7. 举报与联系",paragraphs:["用户可从赞助内容的可见控制中举报，并生成可审计投诉。联系：info@bizowizo.ai。"],bullets:["无需打开广告目的地。","禁止滥用举报或规避执行。","强制法定权利不受影响。"]}]},hi:{...jt,navLabel:"विज्ञापन नीति",eyebrow:"Bizowizo विज्ञापन मानक",title:"विज्ञापन नीति",summary:"विज्ञापनदाताओं, एजेंसियों, क्रिएटिव, लक्ष्यीकरण, भुगतान, डिलीवरी, समीक्षा और शिकायतों के नियम।",print:"नीति प्रिंट करें",back:"विज्ञापन पर लौटें",sections:[{id:"scope",title:"1. दायरा और जिम्मेदारी",paragraphs:["नीति खाते, अभियान, समूह, क्रिएटिव, गंतव्य और भुगतान वाली डिलीवरी पर लागू है। विज्ञापनदाता डेटा, अधिकार, दावे, लक्ष्यीकरण और हर बाज़ार में अनुपालन के लिए जिम्मेदार है।"],bullets:["विज्ञापन स्पष्ट रूप से चिह्नित होना चाहिए।","ऑर्गेनिक रैंकिंग, सपोर्ट, उपहार या Bizo Rewards खरीदे या प्रभावित नहीं किए जा सकते।","मंजूरी या भुगतान पहुँच या परिणाम की गारंटी नहीं देता।"]},{id:"prohibited",title:"2. प्रतिबंधित सामग्री",paragraphs:["Bizowizo गैरकानूनी, खतरनाक, भ्रामक, भेदभावपूर्ण या शोषक विज्ञापन अस्वीकार, रोक या हटा सकता है।"],bullets:["गैरकानूनी वस्तुएँ, हथियार, ड्रग्स, तंबाकू/निकोटीन, यौन शोषण, घृणा, उत्पीड़न, हिंसा या खतरनाक चुनौतियाँ।","धोखाधड़ी, प्रतिरूपण, मालवेयर, भ्रामक गंतव्य, छिपे शुल्क, झूठी कमी या गारंटीकृत आय/निवेश/स्वास्थ्य दावे।","जुआ, राजनीति, वित्त, स्वास्थ्य, शराब और आयु-प्रतिबंधित श्रेणियों को पूर्व अनुमति चाहिए और वे अनुपलब्ध रह सकती हैं।","नाबालिगों की अनुभवहीनता का शोषण या अनुचित लक्ष्यीकरण निषिद्ध है।"]},{id:"creative",title:"3. क्रिएटिव और गंतव्य",paragraphs:["हर क्रिएटिव में मान्य मीडिया, शीर्षक, विवरण, सुरक्षित HTTP(S) URL, CTA, भाषा, आयु रेटिंग, नीति श्रेणी और दृश्यमान विज्ञापन लेबल तथा सभी उपयोग अधिकार आवश्यक हैं।"],bullets:["लेबल छिपाया नहीं जा सकता।","गंतव्य विज्ञापन से मेल खाए और महत्वपूर्ण शर्तें बताए।","समीक्षा से पहले अनुपालन जानकारी की स्पष्ट पुष्टि जरूरी है।"]},{id:"review",title:"4. समीक्षा और ऑडिट",paragraphs:["Bizowizo दर्ज कारण के साथ मंजूर, अस्वीकार, रोक, निलंबित या संग्रहित कर सकता है। निर्णय, स्थिति और वित्तीय घटनाएँ ऑडिट लॉग में रहती हैं।"],bullets:["पहली मंजूरी बाद की कार्रवाई को नहीं रोकती।","गंभीर या बार-बार उल्लंघन खाता सीमित कर सकता है।","लंबित या अस्वीकृत अभियान वितरित नहीं होते।"]},{id:"pricing",title:"5. मूल्य, भुगतान और डिलीवरी",paragraphs:["भुगतान से पहले बजट, अवधि, शामिल सेवा और लागू कर दिखते हैं। CPM और पहुँच केवल अनुमान हैं। Stripe विज्ञापन भुगतान Coins, उपहार, सपोर्ट, कमीशन और Bizo Rewards से अलग संभालता है।"],bullets:["राशि सर्वर नियंत्रित करता है।","भुगतान, विफलता, रिफंड और विवाद अलग धन जर्नल में डीडुप्लिकेट होते हैं।","रिफंड सेवा, भुगतान स्थिति, अनिवार्य कानून और समीक्षा पर निर्भर है।"]},{id:"data",title:"6. डेटा और Stripe सहमति",paragraphs:["केवल उपलब्ध लक्ष्यीकरण विकल्प उपयोग होते हैं; संवेदनशील गुण अनुमानित या अपलोड नहीं किए जा सकते। चेकआउट से पहले भुगतानकर्ता आवश्यक डेटा Stripe को भेजने की स्पष्ट अनुमति देता है।"],bullets:["वैकल्पिक प्रसंस्करण की अलग सहमति रहती है।","सहमति संस्करण और UTC समय भुगतान के साथ दर्ज होते हैं।","एजेंसी को हर ग्राहक का अधिकार चाहिए।"]},{id:"complaints",title:"7. रिपोर्ट और संपर्क",paragraphs:["उपयोगकर्ता प्रायोजित सामग्री के दृश्य नियंत्रण से रिपोर्ट कर सकते हैं; इससे ऑडिट योग्य शिकायत बनती है। संपर्क: info@bizowizo.ai।"],bullets:["रिपोर्ट के लिए गंतव्य खोलना जरूरी नहीं।","दुरुपयोग रिपोर्ट और प्रवर्तन से बचना निषिद्ध है।","अनिवार्य कानूनी अधिकार अप्रभावित रहते हैं।"]}]},hr:{...jt,navLabel:"Pravila oglašavanja",eyebrow:"Bizowizo standardi oglašavanja",title:"Pravila oglašavanja",summary:"Pravila za oglašivače, agencije, kreative, ciljano oglašavanje, plaćanje, isporuku, pregled i pritužbe na Bizowizo.",print:"Politika ispisa",back:"Natrag na oglašavanje",sections:[{id:"scope",title:"1. Opseg i odgovornost oglašivača",paragraphs:["Ova politika primjenjuje se na pojedince, tvrtke, agencije, kampanje, grupe oglasa, kreativne materijale, odredišta i plaćenu dostavu na Bizowizo. Oglašivači su odgovorni za informacije o svojim računima, prava, tvrdnje, upute za ciljano oglašavanje i zakonsku usklađenost na svakom tržištu gdje se oglas prikazuje."],bullets:["Oglašavanje mora biti jasno označeno kao oglas ili sponzorirano.","Organsko rangiranje, podrška, pokloni i Bizo Rewards ne mogu se kupiti niti manipulirati putem oglašavanja.","Odobrenje ili uplata ne jamče doseg, angažman, podršku ili poslovne rezultate."]},{id:"prohibited",title:"2. Zabranjeni i ograničeni sadržaj",paragraphs:["Bizowizo može odbiti, pauzirati ili ukloniti oglašavanje koje je nezakonito, nesigurno, obmanjujuće, diskriminatorno, eksploatativno ili nespojivo s platformom."],bullets:["Nezakonita roba ili usluge, oružje, droge, duhan ili nikotin, seksualna eksploatacija, mržnja, uznemiravanje, nasilje ili opasni izazovi.","Prijevare, lažno predstavljanje, zlonamjerni softver, obmanjujuće odredišne stranice, skriveni troškovi, lažni nedostatak, zajamčeni prihod ili obmanjujuće tvrdnje o ulaganjima, zdravlju ili izvedbi.","Kockanje, političke, financijske, zdravstvene, alkoholne, kategorije s ograničenjem dobi ili druge regulirane kategorije zahtijevaju prethodnu pisanu potvrdu podobnosti i mogu ostati nedostupne.","Oglasi usmjereni na maloljetnike ne smiju iskorištavati neiskustvo, poticati nesigurno ponašanje ili koristiti neprikladno ciljanje."]},{id:"creative",title:"3. Zahtjevi za kreativu i odredište",paragraphs:["Svaka kreativa zahtijeva valjani medijski zapis, naslov, opis, sigurno HTTP(S) odredište, poziv na akciju, jezik, dobnu ocjenu, kategoriju politike i vidljivu oznaku oglašavanja. Oglašivač mora posjedovati ili imati licencu za sav medijski sadržaj, glazbu, zaštitne znakove i tvrdnje."],bullets:["Oznake moraju ostati vidljive i ne smiju biti prikrivene.","Odredišna stranica mora odgovarati oglasu, učitavati se sigurno i otkriti bitne uvjete.","Prije pregleda, oglašivač mora izričito potvrditi obveznu oznaku i dostavljene informacije o usklađenosti."]},{id:"review",title:"4. Pregled, provedba i revizija",paragraphs:["Računi, kampanje, grupe oglasa i kreative podliježu pregledu koji je autoritativan na strani poslužitelja. Bizowizo ih može odobriti, odbiti, pauzirati, obustaviti ili arhivirati uz zabilježen razlog. Odluke o pregledu, promjene statusa i financijski događaji zadržavaju se u revizijskim zapisnicima."],bullets:["Prethodno odobrenje ne sprječava naknadne mjere ako se sadržaj, odredište, zakon ili rizik promijene.","Ponavljana ili ozbiljna kršenja mogu ograničiti račun.","Kampanje na čekanju ili odbijene se ne isporučuju."]},{id:"pricing",title:"5. Cijene, plaćanje i isporuka",paragraphs:["Medijski budžet, trajanje, uključena isporuka na platformi i bilo koji primjenjivi porez prikazuju se prije plaćanja. Podaci o CPM-u i dosegu su samo projekcije. Stripe obrađuje plaćanja za oglašavanje odvojeno od Coins, poklona, podrške, provizija WIZO VIP i Bizo Rewards."],bullets:["Preglednik ne može postaviti iznos za plaćanje; autoritativni poslužitelj za kampanju i verziju cijene kontrolira proces naplate.","Događaji plaćanja, neuspjeha, povrata i sporova dedupliciraju se i zapisuju u zaseban monetarni dnevnik.","Pravo na povrat ovisi o isporučenoj usluzi, statusu plaćanja, obveznom zakonu i dokumentiranom pregledu; zahtjev nije automatsko pravo."]},{id:"data",title:"6. Podaci, ciljano oglašavanje i privola za Stripe",paragraphs:["Ciljanje koristi samo opcije dostupne u oglašivačkom portalu. Osjetljive osobne osobine ne smiju se zaključivati niti učitavati radi ciljanja. Prije naplate, platitelj mora izričito odobriti potreban prijenos podataka o kampanji, naplati, kontaktima i tehničkim podacima naplate Stripeu."],bullets:["Marketing, analitika i ostalo opcionalno procesiranje podliježu odvojenim pravilima o privoli i povlačenju privole.","Verzija privole za naplatu i UTC vrijeme potvrde bilježe se uz plaćanje oglašavanja.","Agentima i agencijama mora biti dana ovlast za postupanje u ime svakog klijenta kojeg upravljaju."]},{id:"complaints",title:"7. Prijave, pritužbe i kontakt",paragraphs:["Korisnici mogu prijaviti sponzorirani sadržaj putem vidljivih kontrola za moderiranje. Prijave stvaraju revizijsku pritužbu za pregled. Oglašivači mogu osporiti odluku putem kontakta na računu; hitne pravne ili sigurnosne zabrinutosti mogu se poslati na info@bizowizo.ai."],bullets:["Za prijavu nije potrebno posjećivati odredište oglašivača.","Namjerne zlonamjerne prijave ili pokušaji izbjegavanja provedbe zabranjeni su.","Obvezna prava potrošača i zakonska prava ostaju netaknuta."]}]},bs:pe({...jt,navLabel:"Pravila oglašavanja",eyebrow:"Bizowizo standardi oglašavanja",title:"Pravila oglašavanja",summary:"Pravila za oglašivače, agencije, kreative, ciljano oglašavanje, plaćanje, isporuku, pregled i pritužbe na Bizowizo.",print:"Politika ispisa",back:"Natrag na oglašavanje",sections:[{id:"scope",title:"1. Opseg i odgovornost oglašivača",paragraphs:["Ova politika primjenjuje se na pojedince, tvrtke, agencije, kampanje, grupe oglasa, kreativne materijale, odredišta i plaćenu dostavu na Bizowizo. Oglašivači su odgovorni za informacije o svojim računima, prava, tvrdnje, upute za ciljano oglašavanje i zakonsku usklađenost na svakom tržištu gdje se oglas prikazuje."],bullets:["Oglašavanje mora biti jasno označeno kao oglas ili sponzorirano.","Organsko rangiranje, podrška, pokloni i Bizo Rewards ne mogu se kupiti niti manipulirati putem oglašavanja.","Odobrenje ili uplata ne jamče doseg, angažman, podršku ili poslovne rezultate."]},{id:"prohibited",title:"2. Zabranjeni i ograničeni sadržaj",paragraphs:["Bizowizo može odbiti, pauzirati ili ukloniti oglašavanje koje je nezakonito, nesigurno, obmanjujuće, diskriminatorno, eksploatativno ili nespojivo s platformom."],bullets:["Nezakonita roba ili usluge, oružje, droge, duhan ili nikotin, seksualna eksploatacija, mržnja, uznemiravanje, nasilje ili opasni izazovi.","Prijevare, lažno predstavljanje, zlonamjerni softver, obmanjujuće odredišne stranice, skriveni troškovi, lažni nedostatak, zajamčeni prihod ili obmanjujuće tvrdnje o ulaganjima, zdravlju ili izvedbi.","Kockanje, političke, financijske, zdravstvene, alkoholne, kategorije s ograničenjem dobi ili druge regulirane kategorije zahtijevaju prethodnu pisanu potvrdu podobnosti i mogu ostati nedostupne.","Oglasi usmjereni na maloljetnike ne smiju iskorištavati neiskustvo, poticati nesigurno ponašanje ili koristiti neprikladno ciljanje."]},{id:"creative",title:"3. Zahtjevi za kreativu i odredište",paragraphs:["Svaka kreativa zahtijeva valjani medijski zapis, naslov, opis, sigurno HTTP(S) odredište, poziv na akciju, jezik, dobnu ocjenu, kategoriju politike i vidljivu oznaku oglašavanja. Oglašivač mora posjedovati ili imati licencu za sav medijski sadržaj, glazbu, zaštitne znakove i tvrdnje."],bullets:["Oznake moraju ostati vidljive i ne smiju biti prikrivene.","Odredišna stranica mora odgovarati oglasu, učitavati se sigurno i otkriti bitne uvjete.","Prije pregleda, oglašivač mora izričito potvrditi obveznu oznaku i dostavljene informacije o usklađenosti."]},{id:"review",title:"4. Pregled, provedba i revizija",paragraphs:["Računi, kampanje, grupe oglasa i kreative podliježu pregledu koji je autoritativan na strani poslužitelja. Bizowizo ih može odobriti, odbiti, pauzirati, obustaviti ili arhivirati uz zabilježen razlog. Odluke o pregledu, promjene statusa i financijski događaji zadržavaju se u revizijskim zapisnicima."],bullets:["Prethodno odobrenje ne sprječava naknadne mjere ako se sadržaj, odredište, zakon ili rizik promijene.","Ponavljana ili ozbiljna kršenja mogu ograničiti račun.","Kampanje na čekanju ili odbijene se ne isporučuju."]},{id:"pricing",title:"5. Cijene, plaćanje i isporuka",paragraphs:["Medijski budžet, trajanje, uključena isporuka na platformi i bilo koji primjenjivi porez prikazuju se prije plaćanja. Podaci o CPM-u i dosegu su samo projekcije. Stripe obrađuje plaćanja za oglašavanje odvojeno od Coins, poklona, podrške, provizija WIZO VIP i Bizo Rewards."],bullets:["Preglednik ne može postaviti iznos za plaćanje; autoritativni poslužitelj za kampanju i verziju cijene kontrolira proces naplate.","Događaji plaćanja, neuspjeha, povrata i sporova dedupliciraju se i zapisuju u zaseban monetarni dnevnik.","Pravo na povrat ovisi o isporučenoj usluzi, statusu plaćanja, obveznom zakonu i dokumentiranom pregledu; zahtjev nije automatsko pravo."]},{id:"data",title:"6. Podaci, ciljano oglašavanje i privola za Stripe",paragraphs:["Ciljanje koristi samo opcije dostupne u oglašivačkom portalu. Osjetljive osobne osobine ne smiju se zaključivati niti učitavati radi ciljanja. Prije naplate, platitelj mora izričito odobriti potreban prijenos podataka o kampanji, naplati, kontaktima i tehničkim podacima naplate Stripeu."],bullets:["Marketing, analitika i ostalo opcionalno procesiranje podliježu odvojenim pravilima o privoli i povlačenju privole.","Verzija privole za naplatu i UTC vrijeme potvrde bilježe se uz plaćanje oglašavanja.","Agentima i agencijama mora biti dana ovlast za postupanje u ime svakog klijenta kojeg upravljaju."]},{id:"complaints",title:"7. Prijave, pritužbe i kontakt",paragraphs:["Korisnici mogu prijaviti sponzorirani sadržaj putem vidljivih kontrola za moderiranje. Prijave stvaraju revizijsku pritužbu za pregled. Oglašivači mogu osporiti odluku putem kontakta na računu; hitne pravne ili sigurnosne zabrinutosti mogu se poslati na info@bizowizo.ai."],bullets:["Za prijavu nije potrebno posjećivati odredište oglašivača.","Namjerne zlonamjerne prijave ili pokušaji izbjegavanja provedbe zabranjeni su.","Obvezna prava potrošača i zakonska prava ostaju netaknuta."]}]},"bs"),sr:pe({...jt,navLabel:"Pravila oglašavanja",eyebrow:"Bizowizo standardi oglašavanja",title:"Pravila oglašavanja",summary:"Pravila za oglašivače, agencije, kreative, ciljano oglašavanje, plaćanje, isporuku, pregled i pritužbe na Bizowizo.",print:"Politika ispisa",back:"Natrag na oglašavanje",sections:[{id:"scope",title:"1. Opseg i odgovornost oglašivača",paragraphs:["Ova politika primjenjuje se na pojedince, tvrtke, agencije, kampanje, grupe oglasa, kreativne materijale, odredišta i plaćenu dostavu na Bizowizo. Oglašivači su odgovorni za informacije o svojim računima, prava, tvrdnje, upute za ciljano oglašavanje i zakonsku usklađenost na svakom tržištu gdje se oglas prikazuje."],bullets:["Oglašavanje mora biti jasno označeno kao oglas ili sponzorirano.","Organsko rangiranje, podrška, pokloni i Bizo Rewards ne mogu se kupiti niti manipulirati putem oglašavanja.","Odobrenje ili uplata ne jamče doseg, angažman, podršku ili poslovne rezultate."]},{id:"prohibited",title:"2. Zabranjeni i ograničeni sadržaj",paragraphs:["Bizowizo može odbiti, pauzirati ili ukloniti oglašavanje koje je nezakonito, nesigurno, obmanjujuće, diskriminatorno, eksploatativno ili nespojivo s platformom."],bullets:["Nezakonita roba ili usluge, oružje, droge, duhan ili nikotin, seksualna eksploatacija, mržnja, uznemiravanje, nasilje ili opasni izazovi.","Prijevare, lažno predstavljanje, zlonamjerni softver, obmanjujuće odredišne stranice, skriveni troškovi, lažni nedostatak, zajamčeni prihod ili obmanjujuće tvrdnje o ulaganjima, zdravlju ili izvedbi.","Kockanje, političke, financijske, zdravstvene, alkoholne, kategorije s ograničenjem dobi ili druge regulirane kategorije zahtijevaju prethodnu pisanu potvrdu podobnosti i mogu ostati nedostupne.","Oglasi usmjereni na maloljetnike ne smiju iskorištavati neiskustvo, poticati nesigurno ponašanje ili koristiti neprikladno ciljanje."]},{id:"creative",title:"3. Zahtjevi za kreativu i odredište",paragraphs:["Svaka kreativa zahtijeva valjani medijski zapis, naslov, opis, sigurno HTTP(S) odredište, poziv na akciju, jezik, dobnu ocjenu, kategoriju politike i vidljivu oznaku oglašavanja. Oglašivač mora posjedovati ili imati licencu za sav medijski sadržaj, glazbu, zaštitne znakove i tvrdnje."],bullets:["Oznake moraju ostati vidljive i ne smiju biti prikrivene.","Odredišna stranica mora odgovarati oglasu, učitavati se sigurno i otkriti bitne uvjete.","Prije pregleda, oglašivač mora izričito potvrditi obveznu oznaku i dostavljene informacije o usklađenosti."]},{id:"review",title:"4. Pregled, provedba i revizija",paragraphs:["Računi, kampanje, grupe oglasa i kreative podliježu pregledu koji je autoritativan na strani poslužitelja. Bizowizo ih može odobriti, odbiti, pauzirati, obustaviti ili arhivirati uz zabilježen razlog. Odluke o pregledu, promjene statusa i financijski događaji zadržavaju se u revizijskim zapisnicima."],bullets:["Prethodno odobrenje ne sprječava naknadne mjere ako se sadržaj, odredište, zakon ili rizik promijene.","Ponavljana ili ozbiljna kršenja mogu ograničiti račun.","Kampanje na čekanju ili odbijene se ne isporučuju."]},{id:"pricing",title:"5. Cijene, plaćanje i isporuka",paragraphs:["Medijski budžet, trajanje, uključena isporuka na platformi i bilo koji primjenjivi porez prikazuju se prije plaćanja. Podaci o CPM-u i dosegu su samo projekcije. Stripe obrađuje plaćanja za oglašavanje odvojeno od Coins, poklona, podrške, provizija WIZO VIP i Bizo Rewards."],bullets:["Preglednik ne može postaviti iznos za plaćanje; autoritativni poslužitelj za kampanju i verziju cijene kontrolira proces naplate.","Događaji plaćanja, neuspjeha, povrata i sporova dedupliciraju se i zapisuju u zaseban monetarni dnevnik.","Pravo na povrat ovisi o isporučenoj usluzi, statusu plaćanja, obveznom zakonu i dokumentiranom pregledu; zahtjev nije automatsko pravo."]},{id:"data",title:"6. Podaci, ciljano oglašavanje i privola za Stripe",paragraphs:["Ciljanje koristi samo opcije dostupne u oglašivačkom portalu. Osjetljive osobne osobine ne smiju se zaključivati niti učitavati radi ciljanja. Prije naplate, platitelj mora izričito odobriti potreban prijenos podataka o kampanji, naplati, kontaktima i tehničkim podacima naplate Stripeu."],bullets:["Marketing, analitika i ostalo opcionalno procesiranje podliježu odvojenim pravilima o privoli i povlačenju privole.","Verzija privole za naplatu i UTC vrijeme potvrde bilježe se uz plaćanje oglašavanja.","Agentima i agencijama mora biti dana ovlast za postupanje u ime svakog klijenta kojeg upravljaju."]},{id:"complaints",title:"7. Prijave, pritužbe i kontakt",paragraphs:["Korisnici mogu prijaviti sponzorirani sadržaj putem vidljivih kontrola za moderiranje. Prijave stvaraju revizijsku pritužbu za pregled. Oglašivači mogu osporiti odluku putem kontakta na računu; hitne pravne ili sigurnosne zabrinutosti mogu se poslati na info@bizowizo.ai."],bullets:["Za prijavu nije potrebno posjećivati odredište oglašivača.","Namjerne zlonamjerne prijave ili pokušaji izbjegavanja provedbe zabranjeni su.","Obvezna prava potrošača i zakonska prava ostaju netaknuta."]}]},"sr")},Z2={en:{navLabel:"Knowledge",all:"All",watch:"Watch lesson",closeVideo:"Close video",videoLabel:"Video lesson",textLesson:"Complete text lesson",mediaPending:"Video production in progress — the complete text lesson is available now.",availableLanguages:"Video and subtitles: English, German, Arabic",moduleCount:"learning modules",faqCount:"answers",openGuide:"Open related guide",openModule:"Open Knowledge module",shareModule:"Share module",linkCopied:"Link copied",noMediaFallback:"This language remains text-only. No foreign-language video or audio is loaded.",promo:{eyebrow:"Learn with BIZOWIZO",title:"Three lessons. One stronger start.",body:"Improve your pitch, prepare a convincing Live Pitch and understand Battles before you go live. Explore all functions and answers on the complete Knowledge page.",cta:"Open all Knowledge"},orientation:{eyebrow:"Your knowledge. Your way.",title:"Find exactly what you need.",intro:"Search, watch or follow a guide. Every path takes you straight to the right BIZOWIZO answer.",cards:{search:{title:"Search and filter",body:"Enter a term and choose your role. Matching modules and answers appear immediately.",cta:"Start search"},videos:{title:"Watch video lessons",body:"Open a module and watch the available lesson in your selected language. A complete text lesson remains available as an alternative.",cta:"View videos"},guides:{title:"Use step-by-step guides",body:"Open the linked guide for exact next steps. Share useful modules directly with others.",cta:"Open guides"}}},audience:{all:"All roles",bizo:"Bizos",wizo:"Wizos",advertiser:"Advertisers"}},de:{navLabel:"Wissen",all:"Alle",watch:"Lektion ansehen",closeVideo:"Video schließen",videoLabel:"Videolektion",textLesson:"Vollständige Textlektion",mediaPending:"Die Videoproduktion läuft – die vollständige Textlektion ist bereits verfügbar.",availableLanguages:"Video und Untertitel: Englisch, Deutsch, Arabisch",moduleCount:"Lernmodule",faqCount:"Antworten",openGuide:"Zugehörigen Leitfaden öffnen",openModule:"Wissensmodul öffnen",shareModule:"Modul teilen",linkCopied:"Link kopiert",noMediaFallback:"Diese Sprache bleibt textbasiert. Es wird kein fremdsprachiges Video oder Audio geladen.",promo:{eyebrow:"Lerne mit BIZOWIZO",title:"Drei Lektionen. Ein stärkerer Start.",body:"Verbessere deinen Pitch, bereite einen überzeugenden Live Pitch vor und verstehe Battles, bevor du live gehst. Alle Funktionen und Antworten findest du auf der vollständigen Wissensseite.",cta:"Alles Wissen öffnen"},orientation:{eyebrow:"Dein Wissen. Dein Weg.",title:"Finde sofort, was du brauchst.",intro:"Suche, sieh dir Videos an oder folge einem Leitfaden. Jeder Weg führt dich direkt zur passenden BIZOWIZO-Antwort.",cards:{search:{title:"Suchen und filtern",body:"Gib einen Begriff ein und wähle deine Rolle. Passende Module und Antworten erscheinen sofort.",cta:"Suche starten"},videos:{title:"Videolektionen ansehen",body:"Öffne ein Modul und sieh dir die verfügbare Lektion in deiner gewählten Sprache an. Alternativ bleibt die vollständige Textlektion verfügbar.",cta:"Videos ansehen"},guides:{title:"Schritt-für-Schritt-Leitfäden nutzen",body:"Öffne den passenden Leitfaden für die nächsten Schritte. Teile hilfreiche Module direkt mit anderen.",cta:"Leitfäden öffnen"}}},audience:{all:"Alle Rollen",bizo:"Bizos",wizo:"Wizos",advertiser:"Werbekunden"}},es:{navLabel:"Conocimiento",all:"Todo",watch:"Ver lección",closeVideo:"Cerrar vídeo",videoLabel:"Lección en vídeo",textLesson:"Lección de texto completa",mediaPending:"La producción del vídeo está en curso; la lección de texto completa ya está disponible.",availableLanguages:"Vídeo y subtítulos: inglés, alemán y árabe",moduleCount:"módulos",faqCount:"respuestas",openGuide:"Abrir guía relacionada",openModule:"Abrir módulo de conocimiento",shareModule:"Compartir módulo",linkCopied:"Enlace copiado",noMediaFallback:"Este idioma se mantiene solo en texto. No se carga vídeo ni audio en otro idioma.",promo:{eyebrow:"Aprende con BIZOWIZO",title:"Tres lecciones. Un comienzo más sólido.",body:"Mejora tu pitch, prepara un Live Pitch convincente y comprende los Battles antes de salir en directo. Consulta todas las funciones y respuestas en la página completa de conocimiento.",cta:"Abrir todo el conocimiento"},orientation:{eyebrow:"Tu conocimiento. Tu camino.",title:"Encuentra exactamente lo que necesitas.",intro:"Busca, mira vídeos o sigue una guía. Cada camino te lleva directamente a la respuesta adecuada de BIZOWIZO.",cards:{search:{title:"Buscar y filtrar",body:"Introduce un término y elige tu rol. Los módulos y respuestas adecuados aparecen de inmediato.",cta:"Iniciar búsqueda"},videos:{title:"Ver lecciones en vídeo",body:"Abre un módulo y mira la lección disponible en el idioma elegido. La lección de texto completa permanece disponible como alternativa.",cta:"Ver vídeos"},guides:{title:"Usar guías paso a paso",body:"Abre la guía vinculada para conocer los siguientes pasos. Comparte directamente los módulos útiles.",cta:"Abrir guías"}}},audience:{all:"Todos",bizo:"Bizos",wizo:"Wizos",advertiser:"Anunciantes"}},ar:{navLabel:"المعرفة",all:"الكل",watch:"شاهد الدرس",closeVideo:"إغلاق الفيديو",videoLabel:"درس فيديو",textLesson:"درس نصي كامل",mediaPending:"إنتاج الفيديو جارٍ، والدرس النصي الكامل متاح الآن.",availableLanguages:"الفيديو والترجمة: الإنجليزية والألمانية والعربية",moduleCount:"وحدات تعليمية",faqCount:"إجابات",openGuide:"فتح الدليل المرتبط",openModule:"فتح وحدة المعرفة",shareModule:"مشاركة الوحدة",linkCopied:"تم نسخ الرابط",noMediaFallback:"تبقى هذه اللغة نصية فقط. لا يتم تحميل فيديو أو صوت بلغة أخرى.",promo:{eyebrow:"تعلّم مع BIZOWIZO",title:"ثلاثة دروس. بداية أقوى.",body:"حسّن عرضك، واستعد لعرض مباشر مقنع، وافهم المواجهات قبل البث. تعرّف على جميع الوظائف والإجابات في صفحة المعرفة الكاملة.",cta:"فتح كل المعرفة"},orientation:{eyebrow:"معرفتك. طريقك.",title:"اعثر فورًا على ما تحتاجه.",intro:"ابحث أو شاهد الفيديوهات أو اتبع دليلًا. كل مسار يوصلك مباشرة إلى إجابة BIZOWIZO المناسبة.",cards:{search:{title:"البحث والتصفية",body:"أدخل مصطلحًا واختر دورك. ستظهر الوحدات والإجابات المناسبة فورًا.",cta:"بدء البحث"},videos:{title:"مشاهدة دروس الفيديو",body:"افتح وحدة وشاهد الدرس المتاح بلغتك المختارة. يبقى الدرس النصي الكامل متاحًا كبديل.",cta:"مشاهدة الفيديوهات"},guides:{title:"استخدام الأدلة خطوة بخطوة",body:"افتح الدليل المرتبط لمعرفة الخطوات التالية بدقة. شارك الوحدات المفيدة مباشرة مع الآخرين.",cta:"فتح الأدلة"}}},audience:{all:"كل الأدوار",bizo:"بيزو",wizo:"ويزو",advertiser:"المعلنون"}},zh:{navLabel:"知识",all:"全部",watch:"观看课程",closeVideo:"关闭视频",videoLabel:"视频课程",textLesson:"完整文字课程",mediaPending:"视频仍在制作中，完整文字课程现已提供。",availableLanguages:"视频和字幕：英语、德语、阿拉伯语",moduleCount:"个学习模块",faqCount:"个答案",openGuide:"打开相关指南",openModule:"打开知识模块",shareModule:"分享模块",linkCopied:"链接已复制",noMediaFallback:"此语言仅提供文字内容，不会加载其他语言的视频或音频。",promo:{eyebrow:"与 BIZOWIZO 一起学习",title:"三节课程，更稳健地开始。",body:"优化你的路演，准备有说服力的直播路演，并在上线前了解对战。完整知识页面汇总了所有功能和答案。",cta:"打开全部知识"},orientation:{eyebrow:"你的知识，你的路径。",title:"立即找到你需要的内容。",intro:"搜索、观看视频或跟随指南。每条路径都会直接带你找到合适的 BIZOWIZO 答案。",cards:{search:{title:"搜索和筛选",body:"输入关键词并选择你的角色。匹配的模块和答案会立即显示。",cta:"开始搜索"},videos:{title:"观看视频课程",body:"打开模块并观看所选语言中可用的课程。完整文字课程始终可作为替代。",cta:"观看视频"},guides:{title:"使用分步指南",body:"打开相关指南，了解准确的下一步。你也可以直接与他人分享有用的模块。",cta:"打开指南"}}},audience:{all:"所有角色",bizo:"Bizos",wizo:"Wizos",advertiser:"广告客户"}},hi:{navLabel:"ज्ञान",all:"सभी",watch:"पाठ देखें",closeVideo:"वीडियो बंद करें",videoLabel:"वीडियो पाठ",textLesson:"पूरा लिखित पाठ",mediaPending:"वीडियो निर्माण जारी है; पूरा लिखित पाठ अभी उपलब्ध है।",availableLanguages:"वीडियो और उपशीर्षक: अंग्रेज़ी, जर्मन, अरबी",moduleCount:"सीखने के मॉड्यूल",faqCount:"उत्तर",openGuide:"संबंधित गाइड खोलें",openModule:"ज्ञान मॉड्यूल खोलें",shareModule:"मॉड्यूल साझा करें",linkCopied:"लिंक कॉपी हो गया",noMediaFallback:"यह भाषा केवल पाठ में रहती है। किसी दूसरी भाषा का वीडियो या ऑडियो लोड नहीं होता।",promo:{eyebrow:"BIZOWIZO के साथ सीखें",title:"तीन पाठ। एक मजबूत शुरुआत।",body:"अपनी पिच बेहतर करें, प्रभावी लाइव पिच तैयार करें और लाइव जाने से पहले बैटल समझें। सभी सुविधाएँ और उत्तर पूरी ज्ञान-पृष्ठ पर उपलब्ध हैं।",cta:"सारा ज्ञान खोलें"},orientation:{eyebrow:"आपका ज्ञान। आपका रास्ता।",title:"जो चाहिए, उसे तुरंत खोजें।",intro:"खोजें, वीडियो देखें या गाइड का पालन करें। हर रास्ता आपको सही BIZOWIZO उत्तर तक सीधे ले जाता है।",cards:{search:{title:"खोजें और फ़िल्टर करें",body:"कोई शब्द दर्ज करें और अपनी भूमिका चुनें। संबंधित मॉड्यूल और उत्तर तुरंत दिखाई देंगे।",cta:"खोज शुरू करें"},videos:{title:"वीडियो पाठ देखें",body:"मॉड्यूल खोलें और चुनी हुई भाषा में उपलब्ध पाठ देखें। पूरा लिखित पाठ विकल्प के रूप में उपलब्ध रहता है।",cta:"वीडियो देखें"},guides:{title:"चरण-दर-चरण गाइड उपयोग करें",body:"अगले सटीक चरणों के लिए संबंधित गाइड खोलें। उपयोगी मॉड्यूल सीधे दूसरों के साथ साझा करें।",cta:"गाइड खोलें"}}},audience:{all:"सभी भूमिकाएँ",bizo:"Bizos",wizo:"Wizos",advertiser:"विज्ञापनदाता"}},hr:{navLabel:"Znanje",all:"Sve",watch:"Pogledaj lekciju",closeVideo:"Zatvori video",videoLabel:"Video lekcija",textLesson:"Cjelovita tekstualna lekcija",mediaPending:"Produkcija videa u tijeku — cjelovita tekstualna lekcija je sada dostupna.",availableLanguages:"Video i titlovi: engleski, njemački, arapski",moduleCount:"Moduli za učenje",faqCount:"Odgovori",openGuide:"Otvori povezani vodič",openModule:"Otvori modul znanja",shareModule:"Podijeli modul",linkCopied:"Poveznica je kopirana.",noMediaFallback:"Ovaj jezik ostaje samo u tekstualnom obliku. Video ili audio na stranom jeziku nisu učitani