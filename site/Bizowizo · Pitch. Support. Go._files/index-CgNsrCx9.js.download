etId:"ID de destino",reason:"Justificación con al menos 10 caracteres",coinAmount:"Corrección de Coins, negativa o positiva",executeAction:"Ejecutar acción",actionComplete:"La acción del administrador se ha ejecutado y auditado.",actionFailed:"No se pudo ejecutar la acción del administrador.",userStatusAction:"Cambiar estado de usuario",walletAction:"Corregir billetera de forma equilibrada",moderationAction:"Cambiar estado de moderación",page:"Página",of:"de",previous:"Anterior",next:"Siguiente",noRows:"No hay registros para esta selección.",loading:"Cargando datos de administrador.",loadFailed:"No se pudieron cargar los datos de administrador.",entries:"Entradas",dataNotice:"No se muestran datos de tarjetas, bancos o acceso."},campaign:{title:"Campañas",intro:"Planifica tu objetivo, sube documentos y crea recompensas para los Wizos que te apoyan.",login:"Iniciar sesión como Bizo",onboarding:"Configurar perfil de Bizo",bizoOnly:"Las campañas pueden ser gestionadas por Bizos.",backProfile:"Volver al perfil de Bizo",myCampaigns:"Mis campañas",empty:"Aún no se ha creado ninguna campaña.",selectOrCreate:"Seleccionar campaña o crear una nueva.",loadFailed:"No se pudo cargar la campaña.",create:"Crear campaña",created:"Borrador de campaña creado.",createFailed:"No se pudo crear la campaña.",draftHint:"Primero guardar como borrador. Al publicar, comienzan 60 días.",saveDraft:"Guardar borrador",saved:"Campaña guardada.",saveFailed:"No se pudo guardar la campaña.",publish:"Iniciar 60 días",published:"Campaña publicada.",publishFailed:"No se pudo publicar la campaña.",reviewTitle:"Revisión automática de campaña",reviewIntro:"Toda la información obligatoria se verifica en el lado del servidor. Solo cuando se cumplen 15 de 15 criterios, la campaña comienza automáticamente durante 60 días.",reviewProgress:"Progreso de aprobación",reviewReady:"Listo para aprobación",reviewBlocked:"Aún no listo para aprobación",reviewNotChecked:"Aún no verificado",reviewApproved:"Aprobado automáticamente",reviewRun:"Iniciar revisión y aprobación",reviewRunning:"Revisando campaña",reviewBlockedToast:"La campaña permanece en borrador. Por favor, completa los criterios abiertos.",reviewFailed:"No se pudo ejecutar la revisión automática.",reviewLoadFailed:"No se pudo cargar el estado de aprobación.",reviewLastChecked:"Última revisión",reviewNeverChecked:"Aún no se ha guardado ninguna ejecución de prueba",reviewCorrection:"Corregir ahora",reviewCriteria:{account_active:{title:"Cuenta Bizo activa",hint:"La cuenta Bizo debe estar activa y sin restricciones."},profile_identity:{title:"Nombre de perfil completo",hint:"El nombre de usuario y el nombre para mostrar deben estar completos."},profile_bio:{title:"Biografía de perfil completa",hint:"La biografía del perfil debe estar completa."}}},upload:{title:"Subir video de Pitch",intro:"Máximo 60 segundos en MP4 o WebM.",videoLabel:"Video de Pitch",sourceLanguageLabel:"Idioma hablado en el video",sourceLanguageHint:"Se utiliza para crear subtítulos y traducciones automáticas.",captionsLabel:"Archivo de subtítulos (opcional)",captionsHint:"WEBVTT de hasta 30 KB. Sin archivo, los subtítulos se crean automáticamente.",captionsSelected:"Archivo de subtítulos seleccionado",captionsAutomatic:"Ningún archivo seleccionado – los subtítulos se crearán automáticamente.",titleLabel:"Título",categoryLabel:"Categoría",descriptionLabel:"Descripción",projectDetailsLabel:"Detalles del proyecto",goalCoinsLabel:"Coins necesarios",selectVideo:"Seleccionar video",replaceVideo:"Reemplazar video",duration:"Duración del video",submit:"Publicar Pitch",uploading:"Publicando Pitch",loginRequired:"Iniciar sesión como Bizo",roleRequired:"Esta área es para Bizos.",loadFailed:"No se pudo cargar el perfil Bizo.",onboardingRequired:"Crear perfil Bizo",backToFeed:"Ir al Feed de Pitch",formTitle:"Proyecto y Pitch",formHint:"Toda la información aparece directamente en el Feed.",errors:{VIDEO_TOO_LONG:"El video de Pitch puede durar como máximo 60 segundos.",VIDEO_NOT_9_16:"Por favor sube un vídeo vertical real en formato 9:16 (p. ej., 1080 × 1920 píxeles).",VIDEO_DURATION_UNREADABLE:"No se pudo leer la duración del video.",INVALID_VIDEO:"No se pudo procesar el archivo de video.",UNSUPPORTED_VIDEO_TYPE:"Se permiten videos MP4 y WebM.",VIDEO_TOO_LARGE:"El archivo de video es demasiado grande.",EMPTY_VIDEO:"El archivo de video está vacío.",VIDEO_REQUIRED:"Selecciona un video de Pitch.",CAPTIONS_TOO_LARGE:"El archivo de subtítulos no puede superar los 30 KB.",INVALID_CAPTIONS_VTT:"Selecciona un archivo de subtítulos WEBVTT válido.",CAPTIONS_READ_FAILED:"No se pudo leer el archivo de subtítulos.",INVALID_PITCH_FIELDS:"Revisa todos los datos del proyecto.",PITCH_UPLOAD_FAILED:"No se pudo publicar el Pitch.",BIZO_PROFILE_INCOMPLETE:"Tu perfil de Bizo aún no está completo. La información que falta aparece a continuación.",UNAUTHENTICATED:"Inicia sesión de nuevo.",BIZO_ROLE_REQUIRED:"Esta área es para Bizos."}},info:{heroTitle:"Cómo funciona",more:"Más información",backHome:"Volver a la página de inicio",navConcept:"Concepto",navBizo:"Bizo",navWizo:"Wizo",navCoins:"Coins",pitchVisualAlt:"Pitch ficticio de Bizo en Bizowizo",battleVisualAlt:"Proyectos ficticios de Bizo en una batalla en vivo",coinsVisualAlt:"Coins de Bizowizo",journey:Ex}},bT={...hT,...jT},fT={brand:"BIZOWIZO",slogan:"Do Your thing!",website:"WWW.BIZOWIZO.COM",roles:{bizo:"BIZO",wizo:"WIZO"},account:{bizoTitle:"¡EMPIEZA COMO BIZO!",wizoTitle:"VE CON TODO COMO WIZO.",usernameLabel:"Muestra tus vibras:",displayNameLabel:"Identidad de perfil o marca",bioLabel:"Haz un pitch de tu visión:",bizoFollowerLabel:"100 Seguidores",bizoBattleLabel:"Rockea batallas en vivo:",bizoCommunityLabel:"Habla con tu equipo WIZO:",wizoFollowingLabel:"Escuadrón WIZO:",wizoRewardLabel:"Recompensas por compromiso:"},live:"LIVE",coinMark:"B",hero:{title:"CROWD REVOLUTION 3.0",subtitle:"¡BIENVENIDO A LA PRIMERA PLATAFORMA DE CROWDFUNDING DE VIDEOS CORTOS DEL MUNDO!",paragraphs:["¡En Bizowizo, todo se trata de dar a cientos de miles de proyectos creativos en todo el mundo la oportunidad de despegar. ¿Y nosotros? ¡Estamos aquí para cambiar el juego por completo – con un toque en vivo que nunca antes has visto! ¡Se acabaron las aburridas campañas de crowdfunding de ayer!","Con videos de pitch de 1 minuto, sesiones de pitch en vivo y batallas en vivo llenas de acción de 5 minutos, abrimos dimensiones y oportunidades completamente nuevas para que los BIZOS conviertan sus ideas en realidad. Los BIZOS cautivan a la audiencia WIZO con sus pitches en vivo para ganar Coins virtuales, que luego pueden convertir en dinero contante y sonante.","Los proyectos creativos, productos y servicios merecen el escenario con nosotros – ¡directamente frente a una audiencia global, retroalimentación en tiempo real, apoyo y cajas registradoras llenas!","Con nuestro sistema de Coins integrado que incluye billeteras, los Wizos pueden invertir en vivo y directamente en sus Bizos favoritos, impulsarlos en su camino hacia el éxito y darles vida. ¡Con BIZOWIZO, creamos una atmósfera eufórica para todos los usuarios y abrimos oportunidades para convertir los sueños en realidad!","Esto es crowdfunding como nunca lo has experimentado – ¿y lo mejor? ¡Hacemos que el mundo sea un poco mejor, más innovador, más exitoso todos los días y ofrecemos la mejor experiencia de usuario de todos los tiempos!","BizoWizo – ¡la plataforma que cambia el juego del crowdfunding para siempre! ¡Únete a nosotros y experimenta el futuro del crowdfunding! LIVE"]},bizo:{title:"¡EMPIEZA COMO BIZO!",items:["Muestra tus vibras: Inicia tu identidad de perfil o marca única en BIZOWIZO con elementos visuales geniales, mensajes y acción en vivo para que realmente destaques.","Establece metas, recolecta Coins: Define metas claras y la cantidad de Coins que necesitas para involucrar completamente a tu comunidad WIZO y realmente impulsar tu proyecto.","Haz un pitch de tu visión: ¡Muestra lo que tienes! Comparte tu startup, tu idea o tu proyecto creativo con videos de pitch convincentes de 1 minuto.","Comparte sueños, alcanza 100 seguidores, ve en vivo: Una vez que hayas alcanzado la marca de 100 seguidores, comienza con unos pocos clics y conéctate en vivo con tu audiencia para obtener comentarios instantáneos.","Rockea batallas en vivo: Enfréntate a otros Bizos en batallas de pitch llenas de acción de 5 minutos, muestra tu innovación y recolecta monedas por cada actuación cautivadora. ¡Vamos!","Conéctate con otros Bizos: Únete a otros Bizos para batallas en vivo épicas y crea experiencias únicas para tu audiencia.","Gana monedas con apoyo: Obtén Coins virtuales como respaldo de tu club de fans WIZO. Esto no es solo dinero, sino también una clara aprobación de tu proyecto.","Habla con tu equipo WIZO: Charla casualmente con tus seguidores, mantenlos actualizados y construye tu propia base de fans.","Comparte sin parar: Aumenta tu visibilidad compartiendo tus videos de pitch y batallas en vivo en todas partes y creando mucho revuelo en torno a tu viaje innovador. ¡A rodar!"]},pitch:{title:"TU VIDEO DE PITCH",subtitle:"¡Tu boleto al éxito!",paragraphs:["¡Sumérgete en el emocionante mundo de BIZOWIZO! Con un video de pitch BIZO ultra genial de 1 minuto, puedes presentar tu proyecto en el escenario virtual y causar sensación. Esto es más que un simple pitch - ¡es una actuación cautivadora que allana el camino hacia tu éxito!","Únete a los pitches en vivo y a las batallas en vivo de 5 minutos mientras compartes tu audaz visión directamente con tus seguidores. Cada momento es una oportunidad no solo para mostrar tu proyecto, sino también el sueño que da forma al futuro.","Siente la energía de la pasión, la innovación y el espíritu de lucha contra otros Bizos - ¡esta no es una presentación ordinaria, sino un verdadero juego de poder para tu idea!","Comienza tu pitch frente a una audiencia WIZO entusiasta y experimenta la magia que se pone en escena.","¿Y lo mejor de todo? ¡Los WIZOS recompensan tu participación en los pitches en vivo y las batallas en vivo con Coins que catapultarán tu proyecto a un nivel completamente nuevo!"],reactions:["vamos, vamos, vamos","Lo vas a conseguir","Lo vas a conseguir","a por lo tuyo, hermano..."],display:{time:"3:00",coins:"250.000"}},battle:{title:"Batallas de Pitch en vivo",intro:["¡Bienvenido a las Live Pitch Battles, el enfrentamiento definitivo donde los BIZOS luchan por sus sueños y la innovación se dispara en solo 5 minutos!","¡Aquí no hay límites, solo negocios increíbles, mucha acción y, por supuesto, Coins en la caja registradora!"],minutes:["(1 Minuto) Los BIZOS entran en el centro de atención con pura pasión y despegan. Cada Coin que llega es un grito de júbilo digital, un voto por el sueño palpitante de los BIZOS.","(2 Minuto) Los pitches están en marcha. El ritmo aumenta. La audiencia WIZO tiene el destino de los proyectos firmemente en sus manos. ¿Quién convencerá más a los Wizos con su proyecto?","(3 Minuto) Los BIZOS realmente calientan la confrontación y convierten el pitch de video en vivo en una historia mega dinámica. Los Coins se acumulan como un aplauso atronador de nuestros entusiastas WIZOS. Cada segundo cuenta.","(4 Minuto) La batalla de pitch alcanza su clímax absoluto. Los Coins son el signo visible del apoyo colectivo y deciden qué sueño se hace realidad.","(5 Minuto) El tiempo se ha acabado. El ganador está decidido – su proyecto no solo ha capturado corazones, sino también los Coins. La Bizowizo Live Pitch Battle ha terminado, y el BIZO victorioso ahora puede deleitarse con la gloria de su éxito o comenzar una nueva ronda en la batalla por los Coins."],reactions:["Buen trabajo, amigo","Guau, increíble","Vamos, vamos, vamos","Lo vas a conseguir"],display:{time:"4:30"}},wizo:{title:"VE CON TODO COMO WIZO.",items:["Comprueba la exclusividad: Obtén contenido especial y transmisiones en vivo de BIZOS solo para ti.","Involúcrate: Da forma a la experiencia en vivo con BIZOS a través de comentarios, regalos virtuales y propinas.","Sorpresas virtuales: Envía regalos virtuales para mostrar tu apoyo.","A la batalla en vivo: Únete a las batallas en vivo y rockea la acción en la plataforma.","Impulsa proyectos: Compra monedas e impulsa los proyectos de los BIZOS.","Ofertas y descuentos: Obtén ofertas exclusivas y grandes descuentos en productos y servicios de BIZOS.","Eventos exclusivos: Únete a eventos especiales, solo para ti como parte del equipo de Bizowizo.","Recompensas por compromiso: Obtén recompensas y reconocimiento por tu compromiso.","Habla con BIZOS: Ponte en contacto directamente con los BIZOS y revisa sus proyectos. ¡A vibrar!","Escuadrón WIZO: ¡Únete al equipo que impulsa proyectos innovadores al siguiente nivel!","Adiós, publicidad: Disfruta de acción sin publicidad, obtén Coins y pon fin a las pausas publicitarias.","Reconocimiento para usuarios avanzados: Los WIZOS activos obtienen beneficios adicionales por su participación regular."]},coins:{title:"BIZOWIZO COINS",subtitle:"- LA MONEDA VIRTUAL-",label:"COINS VIRTUALES",paragraphs:["Obtén los Coins Bling-Bling: ¡Los WIZOS compran COINS para ver contenido VIP, suscribirse a BIZOS y disparar grandes regalos en vivo!","Desliza hacia adentro, COINS hacia afuera: ¡Los WIZOS introducen tarjetas de crédito, aumentan su SALDO DE COINS y luego comienza! Con estos COINS (también regalos y propinas) rockean las publicaciones de BIZO e impulsan las batallas en vivo."],action:"OBTÉN COINS",rate:"1 BIZOWIZO COIN = 1 EUR"},coinPacks:[{coins:"5",price:"5,00 €"},{coins:"10",price:"10,00 €"},{coins:"15",price:"15,00 €"},{coins:"20",price:"20,00 €"}],coinSections:{coinPacksTitle:"CATÁLOGO DE REGALOS",coinPacksSubtitle:"- 16 REGALOS -",giftsTitle:"REGALOS VIRTUALES.",giftsSubtitle:"DE NOVA A ULTRAWIZO",superPacksTitle:"MEGA REGALOS.",superPacksSubtitle:"- SUPERPACKS -"},gifts:[{name:"STARTY",coins:"25",price:"25,00 €"},{name:"BOOMY",coins:"50",price:"50,00 €"},{name:"CASHY",coins:"75",price:"75,00 €"},{name:"TROVY",coins:"100",price:"100,00 €"},{name:"COINY",coins:"125",price:"125,00 €"},{name:"WIZY",coins:"150",price:"150,00 €"},{name:"CATCHY",coins:"175",price:"175,00 €"},{name:"TWINKY",coins:"200",price:"200,00 €"}],superPacks:[{name:"WIZYPRO",coins:"500",price:"500,00 €"},{name:"WIZYHERO",coins:"1.000",price:"1.000,00 €"},{name:"MEGAWIZO",coins:"2.500",price:"2.500,00 €"},{name:"ULTRAWIZO",coins:"5.000",price:"5.000,00 €"}],revenue:{title:"¿Cómo gana Bizowizo?",subtitle:"GANAMOS CON COINS VIRTUALES.",paragraphs:["Los usuarios compran regalos virtuales con COINS y los envían a BIZOS seleccionados. Cada regalo enviado inyecta Coins en la caja registradora de Bizowizo – ¡una excelente manera de generar ingresos!","Bizowizo ofrece 16 regalos virtuales con nombre, de NOVA a ULTRAWIZO. Antes de la compra, cada tarjeta muestra su cantidad de Coins y el precio vinculante en euros a 1 Coin = 1 EUR. El procesamiento y la liquidación internos no se desglosan públicamente.","Los BIZOS tienen la oportunidad de ganar dinero marcando su contenido como exclusivo a través de nuestras funciones de transmisión en vivo premium. Los WIZOS pueden desbloquear estas transmisiones exclusivas usando Coins. Con cada transacción, Bizowizo gana una comisión, lo que representa un intercambio justo por la plataforma exclusiva proporcionada.","¡Bizowizo hace mucho dinero a través de publicidad en la aplicación de terceros geniales! La comisión depende de cuántas personas hagan clic en ella o compren los productos a través de recomendaciones. Más acción, más comisión – ¡ese es el estilo Bizowizo!"]},forecast:{title:"Lo que sale aproximadamente:",subtitle:"- COINS / PROYECTOS-",years:["2024","2025","2026","2027","2028"],rows:[{label:"Bizos / Proyectos",values:["500","1.000","2.000","5.000","10.000"]},{label:"Wizos / Donantes",values:["500.000","1.000.000","2.000.000","5.000.000","10.000.000"]},{label:"Coins comprados",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]},{label:"Coins donados",values:["500.000.000","1.000.000.000","2.000.000.000","5.000.000.000","10.000.000.000"]}],assumptions:["- Los valores planificados son supuestos internos y no una garantía de resultados","- Públicamente solo se muestra el progreso agregado de la campaña"],assumptionsTitle:"SUPOSICIONES"},investor:{title:"¿QUIERES UNIRTE A BIZOWIZO COMO AMIGO / INVERSOR?",companyTitle:"LA EMPRESA DETRÁS DE BIZOWIZO",company:"BIZOWIZO - ¡La vibra comienza en Dubái! Aquí brotan las startups, y no solo disfrutamos de la comunidad más genial, sino también de exención de impuestos y muchos otros beneficios.",amountTitle:"¿CUÁNTO PUEDO INVERTIR POR QUÉ?",amount:"¡Toma tu parte del pastel! En la ronda de Family & Friends puedes obtener hasta el 10% de las acciones. Incluso estamos regalando una participación del 1% por solo 25.000€. ¡Únete cuando despegue!",expectationTitle:"¿QUÉ PUEDO ESPERAR Y EN QUÉ PERÍODO DE TIEMPO?",expectation:"¡Alerta Bling-Bling! ¡Vemos a BIZOWIZO dispararse por las nubes y despegar a lo grande en poco tiempo! ¡La valoración y los ingresos serán catapultados a la estratosfera!",actionTitle:"¡SÍ, QUIERO UNIRME!",action:"¡Únete y asegura tu boleto para la inversión más candente del año! ¡Escríbenos un mensaje corto y tal vez experimentes la aventura más rentable de tu vida! Correo electrónico: edwin.davis@icloud.com"},copyright:"Copyright 2023 / EDWIN DAVIS"},os="يرجى قراءة هذا المستند بعناية.",yT={terms:{eyebrow:"قواعد المنصة",title:"شروط الاستخدام",summary:"تصف هذه الشروط استخدام Bizowizo من قبل Bizos و Wizos والمعلنين والوكالات.",shortNotice:os,version:"الإصدار 1.1",lastUpdated:"2 سبتمبر 2026",sections:[{id:"scope",title:"1. النطاق ومقدم الخدمة",paragraphs:["Bizowizo هي منصة تمويل جماعي لمقاطع الفيديو القصيرة. يقدم Bizos مشاريع في مقاطع فيديو ترويجية وحملات وعروض تقديمية مباشرة ومعارك مباشرة. يكتشف Wizos المشاريع ويمكنهم دعمها باستخدام Coins. بالإضافة إلى ذلك، يتم توفير محتوى مميز وبرنامج إعلاني.","الطرف المتعاقد ومقدم الخدمة هو المشغل المذكور في الإشعار القانوني."]},{id:"eligibility",title:"2. المشاركة والحد الأدنى للعمر",paragraphs:["لا يجوز فتح حساب إلا بمعلومات صحيحة وحديثة وكاملة. حتى يتوفر نموذج معتمد للقصر وموافقة الوالدين، فإن عمليات شراء Coins والتبرعات وفتح الميزات المميزة وحجوزات الإعلانات ومدفوعات Bizo مخصصة حصريًا للبالغين.","يجب أن تتصرف الشركات والوكالات من خلال ممثل مفوض. يجوز لـ Bizowizo طلب دليل مناسب إذا كان ذلك ضروريًا للأمان أو المدفوعات أو الالتزامات القانونية أو الحماية من إساءة الاستخدام."]},{id:"accounts",title:"3. الحساب والتسجيل والأدوار",paragraphs:["يحمي المستخدمون بيانات الوصول الخاصة بهم ويبلغون Bizowizo على الفور بأي وصول غير مصرح به مشتبه به. لا يجوز بيع الحساب أو تأجيره أو نقله دون موافقة.","أثناء الإعداد، يتم اختيار دور المنصة Bizo أو Wizo. هذا الدور دائم بشكل عام لأسباب أمنية ومالية. تتطلب تغييرات الدور عملية مراجعة منفصلة؛ لا يُسمح بحساب ثانٍ للتحايل على القواعد."]},{id:"content",title:"4. المحتوى وحقوق الاستخدام",paragraphs:["يحتفظ المستخدمون بحقوقهم في المحتوى الخاص بهم. من خلال التحميل، يمنحون Bizowizo الحقوق غير الحصرية اللازمة للتخزين والمعالجة الفنية والعرض والترجمة والترجمة النصية والإشراف والترويج المتعلق بالمنصة طوال مدة النشر.","لا يجوز تحميل سوى المحتوى الذي تتوفر له جميع الحقوق اللازمة. ينطبق هذا بشكل خاص على الموسيقى ومقاطع الفيديو والصور والعلامات التجارية والمستندات وحقوق الخصوصية والمعلومات السرية. يُحظر المحتوى المخالف أو المضلل."]},{id:"bizo-campaigns",title:"5. التزامات Bizos والحملات",paragraphs:["يجب على Bizos وصف المشروع وهدف التمويل والمدة والمخاطر والمستندات والمكافآت بشكل مفهوم وصادق. يجب الإبلاغ عن التغييرات الجوهرية بشفافية. لا تحل الموافقة الفنية التلقائية محل المراجعة القانونية أو الاقتصادية أو الواقعية للمشروع.","Bizos مسؤولون عن تنفيذ مشروعهم والمكافآت الموعودة والتواصل مع الداعمين والضرائب والتصاريح والأدلة اللازمة. لا تضمن Bizowizo نجاح التمويل أو التسليم أو النجاح الاقتصادي."]},{id:"wizo-support",title:"6. الدعم من قبل Wizos",paragraphs:["الدعم ليس شراء لأسهم الشركة، ولا قرضًا، ولا نصيحة استثمارية. يتلقى Wizos فقط المكافأة الموصوفة بوضوح أو الوصول الرقمي. لا يتم الوعد بأي ربح أو عائد أو سداد للمبلغ المدعوم.","يراجع Wizos معلومات الحملة على مسؤوليتهم الخاصة. توفر Bizowizo وظائف المنصة ومعالجة الدفع، لكنها لا تضمن بيانات أو التزامات أداء Bizo."]},{id:"coins",title:"7. Coins والدعم والهدايا الافتراضية",paragraphs:["Coins وحدات استخدام غير قابلة للتحويل ومقيدة بالمنصة. يشتري Wizos واحدة من 16 هدية مسماة من NOVA إلى ULTRAWIZO، وتظهر كمية Coins والسعر الملزم باليورو بنسبة ثابتة 1 Coin = 1 EUR على كل هدية. Coins ليست عملة قانونية أو رصيدًا مصرفيًا أو ورقة مالية أو استثمارًا ولا يمكن لـ Wizos تحويلها إلى مال.","تتم مشتريات الهدايا حصريًا عبر Stripe ولا تُقيد إلا بعد تأكيد الدفع من الخادم. تُعالج الاستردادات والنزاعات وأخطاء القيد بقيود مقابلة موثقة؛ ولا تُغيّر أو تُحذف سجلات Ledger المكتملة.","تحسب المنصة وتعرض قيمة مجمعة واحدة لتقدم الحملة فقط. لا تُكشف علنًا أوزانها الداخلية أو مكوناتها. يبقى التقدم الظاهر منفصلًا عن تقييم Battle وحد 1,000 Coin وعن حساب مكافأة Bizo أو الصرف لاحقًا. يُغلق الجمع تلقائيًا عند بلوغ الهدف أو بحد أقصى في نهاية اليوم الستين للحملة ولا يمكن تمديده. تحدّث القيود العكسية المؤكدة التقدم المجمع مرة واحدة من خلال إعادة حساب خادمية قابلة للتدقيق.","يُسجَّل الدعم المؤكد كالتزام قابل للتدقيق ومرتبط بالحملة ويبقى محجوزًا دون M1. بدءًا من M1 قد تنشأ مكافأة Bizo وفق قواعد المكافآت المطبقة واستنادًا إلى صافي الإيراد المعدل والمتحقق فعليًا. يُعتد بالإيراد المؤكد والضرائب والاستردادات والنزاعات وتكاليف الدفع ومتجر التطبيقات وConnect والصرف الفعلية. لا تنشئ التوقعات حقًا في الصرف. تبقى المكافأة مقفلة حتى انتهاء الحملة واكتمال Stripe Connect والمراجعة وانتهاء فترة المخاطر الدنيا البالغة 30 يومًا. لا يوجد ضمان للدخل أو الصرف."]},{id:"premium",title:"8. المحتوى المميز",paragraphs:["يمكن فتح عرض تقديمي مميز مرة واحدة بمبلغ Coin المعروض. ينطبق الفتح على حساب Wizo المعني والعرض التقديمي المحدد. لا ينقل الفتح أي حقوق نشر أو حقوق إعادة توزيع.","لن يتم تقديم الوصول المباشر المميز إلا بعد تنشيط البنية التحتية الخارجية لـ LiveKit. إشعار التحضير المرئي ليس وعدًا ببث مباشر متاح بالفعل."]},{id:"live",title:"9. العروض التقديمية المباشرة والمعارك المباشرة",paragraphs:["يحتاج Bizos إلى ما لا يقل عن 100 متابع حقيقي للعروض التقديمية المباشرة وما لا يقل عن 200 متابع حقيقي للمعارك المباشرة. يتم التحقق من الأهلية من جانب الخادم ويمكن سحبها في حالة التلاعب أو المشكلات الأمنية أو انتهاكات القواعد.","يمكن تأخير المحتوى المباشر أو مقاطعته أو الإشراف عليه أو إنهائه. يجب تحديد المعارك التجريبية وتأثيرات النظام التجريبية بوضوح ولا يجوز تقديمها كنشاط مستخدم حقيقي أو حركة أموال حقيقية."]},{id:"advertising",title:"10. الإعلانات وحسابات الوكالات",paragraphs:["بمجرد تنشيط البرنامج الإعلاني، يجوز للأفراد والشركات والوكالات حجز الإعلانات فقط وفقًا لإرشادات الإعلان السارية في ذلك الوقت. يتم عرض الأسعار والمدة والموضع والميزانية بشفافية وحسابها من جانب الخادم قبل الدفع.","سيتم تحديد الإعلانات بوضوح. يُحظر بشكل خاص الخداع والمنتجات غير القانونية والجماهير المستهدفة التمييزية وخصائص الجمهور المستهدف الحساسة والإعلانات الموجهة للقصر. يجوز لـ Bizowizo رفض الإعلانات أو إيقافها مؤقتًا قبل أو بعد البدء."]},{id:"payments",title:"11. المدفوعات والفواتير والمبالغ المستردة والمدفوعات",paragraphs:["Stripe هو مزود خدمة الدفع الوحيد. تتم معالجة بيانات البطاقة والبنك بواسطة Stripe ولا يتم تخزينها بالكامل في Bizowizo. يمكن أن تظهر فقط البيانات الوصفية الآمنة مثل طريقة الدفع والعلامة التجارية والأرقام الأخيرة والحالة في الحساب.","تظل حقوق الإلغاء والضمان والاسترداد القانونية غير متأثرة. تتوفر معلومات خاصة حول المحتوى الرقمي وحزم Coins وبدء الخدمة في معلومات الإلغاء. لا تتم مدفوعات Bizo إلا إذا تم استيفاء متطلبات الحملة و Ledger و Stripe Connect."]},{id:"conduct",title:"12. السلوك المحظور",paragraphs:["يُحظر المحتوى غير القانوني والاحتيال ومعلومات الحملة الخاطئة والمتابعين أو التفاعلات المصطنعة وغسيل الأموال والتلاعب بالدفع والتحرش والكراهية والتهديدات وإساءة استخدام الهوية والبرامج الضارة والبريد العشوائي والتحايل على تدابير الحماية الفنية.","لا يجوز التلاعب بـ Coins أو التبرعات أو المراجعات أو التعليقات أو التصنيفات أو الأحداث الإعلانية بشكل آلي أو منسق. يجب الإبلاغ عن الثغرات الأمنية بمسؤولية إلى Bizowizo وعدم استغلالها."]},{id:"moderation",title:"13. الإشراف والتقارير والشكاوى",paragraphs:["يمكن للمستخدمين الإبلاغ عن المحتوى والحسابات وحظر المستخدمين الآخرين. يجوز لـ Bizowizo تقييد المحتوى أو إزالته أو إلغاء تحقيق الدخل منه أو تعليق الحسابات مؤقتًا أو دائمًا إذا تم انتهاك القواعد أو القوانين أو متطلبات الأمان.","إلى الحد الذي يقتضيه القانون، تشرح Bizowizo قرارات الإشراف الجوهرية وتوفر مسارًا داخليًا للشكاوى. يمكن تقييد التقارير المسيئة بشكل واضح."]},{id:"availability",title:"14. التوافر والمسؤولية",paragraphs:["تسعى Bizowizo جاهدة لتوفير خدمة آمنة ومتاحة، لكنها لا تدين بالتوافر دون انقطاع. قد تؤدي الصيانة أو مقدمو الخدمات الخارجيون أو الشبكات أو القوة القاهرة أو التدابير الأمنية إلى تقييد الوظائف مؤقتًا.","تنطبق القواعد القانونية على النية والإهمال الجسيم وكذلك الأضرار التي تلحق بالحياة أو الجسد أو الصحة. بخلاف ذلك، تعتمد المسؤولية على القانون المعمول به؛ لا يتم تقييد حقوق المستهلك الإلزامية."]},{id:"termination",title:"15. المدة والإنهاء وحذف الحساب",paragraphs:["يمكن للمستخدمين إغلاق حسابهم بعد الوفاء بالتزامات الدفع والدفع والإشراف والاحتفاظ المعلقة. قد يحد الاحتفاظ القانوني والنزاعات الجارية ومنع الاحتيال والمجلات المالية غير القابلة للتغيير من الحذف الكامل الفوري.","يجوز لـ Bizowizo تعليق الحسابات أو إنهائها لسبب وجيه. تظل حقوق المستخدم المعلقة والمبالغ المستردة والمطالبات القانونية غير متأثرة."]},{id:"changes",title:"16. التغييرات على هذه الشروط",paragraphs:["سيتم الإبلاغ عن التغييرات الجوهرية برقم إصدار جديد ومعلومات مسبقة مناسبة. إذا كانت الموافقة مطلوبة، فسيتم الحصول عليها صراحةً. الاستمرار في الاستخدام لا يحل محل الموافقة المطلوبة قانونًا."]},{id:"law",title:"17. القانون المعمول به وتسوية المنازعات",paragraphs:["تسري هذه الشروط وفق القوانين السارية في دبي ودولة الإمارات العربية المتحدة، مع بقاء حقوق المستهلك الإلزامية محفوظة.","في الحدود التي يسمح بها القانون، تنظر المحاكم أو جهات تسوية المنازعات المختصة في دبي أو الإمارات في النزاعات. ويمكن للمستهلك استخدام قنوات الشكاوى المختصة لدى وزارة الاقتصاد أو دائرة الاقتصاد والسياحة في دبي."]}]},privacy:{eyebrow:"الشفافية حول البيانات",title:"سياسة الخصوصية",summary:"تصف هذه السياسة البيانات الشخصية التي تعالجها Bizowizo للمنصة والمدفوعات والوسائط والاتصالات والأمان.",shortNotice:os,version:"الإصدار 1.0",lastUpdated:"12 أغسطس 2026",sections:[{id:"controller",title:"1. المراقب وجهة الاتصال",paragraphs:["المراقب هو المشغل المذكور في الإشعار القانوني.","info@bizowizo.ai هو عنوان البريد الإلكتروني المركزي لاستفسارات الخصوصية والتواصل مع المشغل."]},{id:"scope",title:"2. النطاق",paragraphs:["تنطبق هذه السياسة على موقع الويب وتطبيق الويب والحسابات والملفات الشخصية والخلاصات والحملات والمحفظة والمدفوعات والميزات المميزة والمراسلة والتعليقات والمراجعات والإشراف والبرنامج الإعلاني المستقبلي. قد تكون الإشعارات الإضافية مطلوبة لتطبيق أصلي لاحق أو تواجد خارجي على وسائل التواصل الاجتماعي."]},{id:"categories",title:"3. ما هي البيانات التي تتم معالجتها",paragraphs:["اعتمادًا على الاستخدام، تعالج Bizowizo بيانات الحساب وجهات الاتصال، وبيانات الدور والملف الشخصي، والمحتوى العام، والوسائط والمستندات، وبيانات المتابعين والتفاعل، والرسائل، وبيانات الإشراف والأمان، وبيانات الوصول الفني والجهاز، بالإضافة إلى البيانات الوصفية للدفع و Ledger."],bullets:["الحساب: OpenID أو البريد الإلكتروني اللاحق، واسم العرض، والدور، واللغة، وبيانات الجلسة، وحالة الحساب.","الملف الشخصي العام: اسم المستخدم، وصورة الملف الشخصي، واللافتة، والسيرة الذاتية، والبلد/الموقع، والأنشطة المنشورة.","المشروع والمحتوى: العروض التقديمية، ومقاطع الفيديو، والتسميات التوضيحية، والحملات، والمستندات، والمكافآت، والتعليقات، والمراجعات.","الاتصالات: محتوى المراسلة الخاصة، والدعوات، والإشعارات، وطلبات الدعم.","المالية: مراجع عميل/جلسة/حدث Stripe، وحالة الشراء، وحجوزات Coin و Ledger، والتبرعات، والحجوزات، وحالة الدفع؛ لا توجد بيانات كاملة للبطاقة أو CVC أو الوصول إلى البنك.","الأمان: معلومات IP/الوقت/الجهاز، وإشارات إساءة الاستخدام، والتقارير، والحظر، وبيانات الإشراف والتدقيق."]},{id:"purposes",title:"4. الأغراض والقواعد القانونية",paragraphs:["تعتمد القاعدة القانونية المحددة على الغرض. يدعم العقد وتدابير ما قبل التعاقد الحساب ووظائف المنصة وشراء Coin والميزات المميزة والإعلانات والدفع. تتعلق الالتزامات القانونية بشكل خاص بالمحاسبة والتحقق من الدفع واستفسارات السلطات. يمكن أن تدعم المصالح المشروعة الأمان والحماية من إساءة الاستخدام وتحليل الأخطاء وتشغيل المنصة الأساسي. تُستخدم الموافقة للتحليل الاختياري والتسويق والمعالجة الأخرى غير الضرورية.","تُوثَّق القواعد القانونية وموازنة المصالح وفترات الاحتفاظ في سجل أنشطة المعالجة."]},{id:"public-content",title:"5. الملفات الشخصية والمحتوى العام",paragraphs:["يمكن الوصول إلى الملفات الشخصية المنشورة والعروض التقديمية والحملات والتعليقات والمراجعات وأعداد المتابعين والتصنيفات ونتائج المعارك ومشاركتها في جميع أنحاء العالم. لا يتم إخراج بيانات الاتصال الخاصة ومعرفات المحفظة ورسائل البريد الإلكتروني وتفاصيل الدفع عمدًا للجمهور.","يجب ألا يدرج المستخدمون بيانات سرية أو حساسة بشكل خاص في المحتوى العام. يمكن لمحركات البحث ومستلمي الروابط المشتركة تخزين المحتوى العام مؤقتًا بشكل مستقل."]},{id:"payments",title:"6. Stripe و Coins والمدفوعات",paragraphs:["يعالج Stripe المدفوعات وطرق الدفع ومنع الاحتيال والتحقق من الهوية ومدفوعات Bizo كمراقب مستقل أو معالج وفقًا للخدمة المعنية. تتلقى Bizowizo فقط المراجع والبيانات الوصفية اللازمة للحالة والتخصيص والدعم والمحاسبة و Ledger.","تنشأ أرصدة Coin من قيود Double-Entry-Ledger غير القابلة للتغيير. تصبح المبالغ المستردة والنزاعات قابلة للتتبع من خلال القيود العكسية. قد تتطلب الالتزامات المالية والإثباتية القانونية احتفاظًا أطول."]},{id:"media-ai",title:"7. الوسائط والترجمة النصية والترجمة",paragraphs:["يتم تخزين بايتات الوسائط في وحدة تخزين متوافقة مع S3. توجد البيانات الوصفية والملكية والحالة ومراجع التخزين في قاعدة بيانات المنصة. للنسخ والترجمة النصية والترجمة، يمكن نقل الصوت والنص والسياق الضروري إلى خدمات الذكاء الاصطناعي المتكاملة.","تتم ترجمة نصوص المراسلة الخاصة فقط للمستلم المسجل المعني. يُوثَّق المزود والمنطقة ومعالجة الطلبات والمقاولون من الباطن وفترات الحذف وآليات البلد الثالث."]},{id:"communication",title:"8. المراسلة والإشعارات والبريد الإلكتروني",paragraphs:["تتم معالجة الرسائل الخاصة للتسليم وحالة القراءة والحماية من إساءة الاستخدام والتقارير. تحتوي الإشعارات فقط على المعلومات اللازمة للحدث. لا يتم تضمين محتوى الرسالة في خلاصات النشاط العام.","لم يتم تكوين مزود لرسائل البريد الإلكتروني الخاصة بالتأكيد وإعادة تعيين كلمة المرور بعد. بعد الاختيار، ستتم إضافة المزود والمنطقة ونطاق البيانات ومدة التخزين هنا؛ حتى ذلك الحين، لا يجوز محاكاة تسليم البريد الإلكتروني."]},{id:"live",title:"9. LiveKit والبث المباشر",paragraphs:["تم التخطيط لـ LiveKit Cloud كبنية تحتية مستقبلية للعروض التقديمية والمعارك المباشرة، ولكن لم يتم تنشيطها بعد. بعد التنشيط، يمكن معالجة بيانات الغرفة والمشارك والاتصال والصوت/الفيديو والجودة الفنية. قبل ذلك، ستتم إضافة منطقة المزود والاحتفاظ والتسجيل والإشراف ونقل البلد الثالث."]},{id:"analytics",title:"10. ملفات تعريف الارتباط والتخزين المحلي والتحليلات",paragraphs:["تخزن التقنيات الضرورية بشكل خاص الجلسة واللغة وقرار الخصوصية وتفضيل الصوت وإعدادات الواجهة. لا يتم تحميل البرنامج النصي Umami Analytics الخاص بالمشروع إلا بعد الموافقة الاختيارية على التحليلات.",'يمكن سحب الموافقة في أي وقت عبر "إعدادات ملفات تعريف الارتباط" في التذييل. تتوفر مزيد من التفاصيل في إشعار ملفات تعريف الارتباط.']},{id:"recipients",title:"11. المستلمون ومقدمو الخدمات",paragraphs:["اعتمادًا على الوظيفة، يمكن أن يكون المستلمون استضافة/مصادقة/قاعدة بيانات/تخزين Manus، و Stripe، وخدمات البريد الإلكتروني المستقبلية، و LiveKit، وخدمات الترجمة/النسخ، ومقدمي الدعم، والمستشارين المهنيين، والسلطات. يتم نقل البيانات فقط بالقدر اللازم وعلى أساس قانوني مناسب.","يوثّق سجل مقدمي الخدمات الأدوار والمناطق والعقود والمقاولين من الباطن."]},{id:"transfers",title:"12. عمليات النقل خارج الاتحاد الأوروبي/المنطقة الاقتصادية الأوروبية",paragraphs:["قد يعالج مقدمو الخدمات الفرديون البيانات خارج الاتحاد الأوروبي أو المنطقة الاقتصادية الأوروبية. في هذه الحالة، يجب فحص وتوثيق قرار الملاءمة والبنود التعاقدية القياسية وتدابير الحماية الإضافية اللازمة."]},{id:"retention",title:"13. مدة التخزين",paragraphs:["يتم تخزين البيانات فقط طالما كانت ضرورية للغرض المعني أو العقد أو إثبات الأمان أو الالتزامات القانونية. يمكن حذف بيانات الحساب بعد الحذف؛ تتم إزالة المحتوى العام أو إخفاء هويته، ما لم تمنع الحقوق أو الالتزامات ذلك.","قد يتم تخزين بيانات Ledger و Stripe والفواتير والتدقيق والإشراف والنزاعات لفترة أطول بسبب الاحتفاظ القانوني ومنع الاحتيال والدفاع القانوني. تحدد المواعيد النهائية في مفهوم الحذف."]},{id:"rights",title:"14. حقوق أصحاب البيانات",paragraphs:["يمكن لأصحاب البيانات طلب الوصول والتصحيح والحذف والتقييد وقابلية نقل البيانات والاعتراض وفقًا للمتطلبات القانونية. يمكن سحب الموافقة في أي وقت للمستقبل.","بالإضافة إلى ذلك، هناك حق في تقديم شكوى إلى سلطة الإشراف على حماية البيانات المختصة وفق القانون المطبق."]},{id:"automation",title:"15. القواعد الآلية والتنميط",paragraphs:["يمكن حساب عتبات المتابعين واكتمال الحملة والتصنيفات ومؤشرات الاحتيال وأولويات الإشراف تلقائيًا. وهي لا تبرر حاليًا قرارًا آليًا حصريًا له تأثير قانوني كبير مماثل؛ يتم الاحتفاظ بالتدابير عالية المخاطر قابلة للمراجعة إداريًا.","يجب ألا يستخدم النظام الإعلاني المستقبلي بيانات حساسة لاستهداف الجمهور ويجب ألا يعرض إعلانات موجهة للقصر. سيتم إضافة المنطق النهائي قبل التنشيط."]},{id:"minors-security",title:"16. القصر وأمن البيانات",paragraphs:["حتى يتوفر نموذج معتمد للعمر وموافقة الوالدين، فإن الوظائف المتعلقة بالدفع مخصصة للبالغين فقط. يمكن تقييد حسابات القصر المشبوهة.","تستخدم Bizowizo الوصول المستند إلى الدور، وملفات تعريف الارتباط الآمنة، والتحقق من جانب الخادم، وحدود المعدل، وخطافات الويب الموقعة، والنقل المشفر، وحماية وصول S3، والمجلات المالية غير القابلة للتغيير. لا يوجد نظام يمكنه ضمان الأمان المطلق."]},{id:"changes-contact",title:"17. التغييرات وجهة اتصال الخصوصية",paragraphs:["سيتم تحديث هذه السياسة لمقدمي الخدمات أو الوظائف أو القواعد القانونية الجديدة. سيتم الإبلاغ عن التغييرات الجوهرية بشكل مناسب.","للاستفسارات المتعلقة بالخصوصية، يمكن التواصل عبر info@bizowizo.ai."]}]},imprint:{eyebrow:"تحديد المزود",title:"الإشعار القانوني",summary:"معلومات المزود لـ Bizowizo.",shortNotice:os,version:"الإصدار 1.0",lastUpdated:"12 أغسطس 2026",sections:[{id:"provider",title:"مزود الخدمة الرقمية",paragraphs:["Pitch60 Social Media Marketing Services - FZCO – المشغّل القانوني لمنصة Bizowizo","دبي، الإمارات العربية المتحدة"]},{id:"contact",title:"جهة الاتصال",paragraphs:["عنوان البريد الإلكتروني المركزي لاستفسارات المشغل والخصوصية: info@bizowizo.ai."]},{id:"register",title:"السجل والتفاصيل الضريبية",paragraphs:["جهة إصدار الرخصة التجارية: حكومة دبي","رقم الرخصة التجارية: 10742"]},{id:"editorial-dsa",title:"المسؤولية التحريرية وجهة اتصال DSA",paragraphs:["تُعالج مسائل المحتوى والتحرير وفق القوانين المنطبقة.","يمكن للسلطات والمستخدمين التواصل عبر info@bizowizo.ai."]},{id:"dispute",title:"تسوية منازعات المستهلك",paragraphs:["تُطبّق حقوق المستهلك وإجراءات تسوية المنازعات وفق القانون المطبق في دبي والإمارات.","لن يتم ربط منصة الاتحاد الأوروبي السابقة لتسوية المنازعات عبر الإنترنت لأنه تم إيقافها."]},{id:"copyright",title:"العلامة التجارية وحقوق النشر",paragraphs:["Bizowizo وعلامة Bold-B والوسائط الخاصة بالمنصة محمية بموجب قانون العلامات التجارية وحقوق النشر. يظل محتوى المستخدم مع أصحاب الحقوق المعنيين.","الوثيقة الأصلية: حقوق النشر 2023 / EDWIN DAVIS."]}]},community:{eyebrow:"آمنون معًا",title:"إرشادات المجتمع",summary:"تحمي هذه القواعد Bizos و Wizos والمشاريع ومصداقية الدعم والإعلان.",shortNotice:os,version:"الإصدار 1.1",lastUpdated:"8 سبتمبر 2026",sections:[{id:"respect",title:"1. الاحترام والأمان",paragraphs:["عامل الآخرين باحترام. لا يُسمح بالتحرش والتهديدات والكراهية والتجريد من الإنسانية والاعتداءات الجنسية ونشر المعلومات الشخصية (Doxxing) والدعوات إلى العنف."]},{id:"authenticity",title:"2. الأصالة والثقة",paragraphs:["لا توجد هويات مزيفة أو نجاحات مشاريع مخترعة أو متابعين متلاعب بهم أو تفاعلات مشتراة أو تبرعات وهمية منسقة. يجب أن يظل المحتوى التجريبي قابلاً للتعرف عليه كعرض توضيحي."]},{id:"campaigns",title:"3. حملات صادقة",paragraphs:["يشرح Bizos الهدف واستخدام الأموال والمخاطر والجدول الزمني والمكافآت بصدق. يتم الإبلاغ عن المشكلات أو التغييرات الجوهرية على الفور. يُحظر الاحتيال والمخططات الهرمية ووعود العائد غير الواقعية."]},{id:"rights",title:"4. الحقوق والخصوصية والقصر",paragraphs:["انشر فقط المحتوى والموسيقى والصور والمستندات التي تمتلك حقوقها. لا تشارك البيانات الخاصة لأشخاص آخرين. يتطلب المحتوى الذي يضم قاصرين رعاية خاصة وجميع الموافقات اللازمة."]},{id:"platform-content",title:"5. المنشورات والشركات الأخرى والإعلانات",paragraphs:["عند كل رفع، تؤكد أنك أنشأت المحتوى بنفسك أو أنك تملك جميع حقوق الاستخدام والموسيقى والعلامات والصور والحقوق الشخصية والتصاريح الأخرى اللازمة. لا يجوز رفع محتوى أو شعارات أو منتجات أو أسرار تجارية أو مواد إعلانية تخص شركات أخرى دون تفويض يمكن إثباته.","يُحظر الإعلان غير المطلوب والرسائل المزعجة وعروض البيع المخفية وإعلانات العمولة أو الإحالة خارج وظائف Bizowizo المخصصة والادعاءات التجارية المضللة. يجب أن يلتزم الإعلان المسموح به بسياسة الإعلان وأن يُوسم بوضوح كإعلان.","يجوز لـ Bizowizo مراجعة المحتوى المُبلغ عنه أو المشتبه به أو إخفاؤه مؤقتًا أو إزالته أو تقييد وصوله، وتقييد وظائف الحساب عند الانتهاكات الجسيمة أو المتكررة. يمكن لأصحاب الحقوق والمتضررين استخدام مسار الإبلاغ على المحتوى أو الملف الشخصي، مع بقاء طرق المعلومات والشكاوى والانتصاف القانونية دون مساس."]},{id:"live",title:"6. العروض التقديمية المباشرة والمعارك",paragraphs:["لا يجوز استخدام التنسيقات المباشرة للأفعال الخطيرة أو الإذلال أو المقامرة أو ضغط الدفع أو التلاعب الاصطناعي بالتبرعات. يمكن للمشرفين مقاطعة أو إنهاء عمليات البث."]},{id:"commerce",title:"7. المدفوعات والإعلانات والعروض المحظورة",paragraphs:["لا تتحايل على Stripe أو محفظة Bizowizo من خلال طلبات الدفع المخفية. لا يجوز الإعلان عن السلع غير القانونية والأسلحة والمخدرات والاستغلال والعروض المالية الاحتيالية والخدمات المحظورة الأخرى أو تمويلها.","يجب أن يكون الإعلان قابلاً للتعرف عليه كإعلان ولا يجوز استخدام خصائص حساسة أو قاصرين لاستهداف الجمهور."]},{id:"enforcement",title:"8. التدابير",paragraphs:["اعتمادًا على الخطورة، يجوز لـ Bizowizo الحد من الوصول، أو إزالة المحتوى، أو حظر تحقيق الدخل أو الوصول المباشر، أو مراجعة المدفوعات، أو إغلاق الحسابات مؤقتًا أو دائمًا. لا يتم حذف البيانات المالية، بل يتم حظرها بشكل آمن قانونيًا أو تصحيحها عن طريق القيود العكسية."]},{id:"report-appeal",title:"9. الإبلاغ والشكوى",paragraphs:["استخدم وظيفة الإبلاغ على المحتوى أو الملف الشخصي ووصف السبب بشكل ملموس. يتلقى المتأثرون، إلى الحد المسموح به قانونًا، مبررًا ومسارًا للمراجعة الداخلية. تنتمي المخاطر الحادة أيضًا إلى السلطات المختصة أو خدمات الطوارئ."]}]},cookies:{eyebrow:"إعدادات الخصوصية",title:"إشعارات ملفات تعريف الارتباط والتخزين",summary:"تفصل Bizowizo تقنية الجلسة الضرورية عن قياس الوصول الاختياري ولا تقوم بتحميل التحليلات إلا بعد الموافقة.",shortNotice:os,version:"الإصدار 1.0",lastUpdated:"12 أغسطس 2026",sections:[{id:"necessary",title:"1. التقنيات الضرورية",paragraphs:["تتيح ملفات تعريف الارتباط الضرورية وتخزين المتصفح تسجيل الدخول والأمان واللغة وقرار الخصوصية وإعادة التوجيه بعد تسجيل الدخول بالإضافة إلى إعدادات الصوت والواجهة. بدونها، لا تعمل الوظائف الأساسية المطلوبة بشكل موثوق."],bullets:["ملف تعريف ارتباط الجلسة: يحافظ على تسجيل دخول آمن.","تخزين اللغة: يتذكر اللغة المختارة.","تخزين الخصوصية: يتذكر القرار بشأن التحليلات الاختيارية.","تخزين الجلسة: يتذكر تفضيلات العودة والصوت للجلسة الحالية فقط.","تخزين الواجهة: يتذكر الإعدادات المحلية مثل عرض الشريط الجانبي للمسؤول."]},{id:"analytics",title:"2. التحليلات الاختيارية",paragraphs:["تستخدم Bizowizo قياس وصول Umami المكون من جانب المشروع فقط بعد الموافقة الصريحة. إنه يخدم التحسين الفني والمحتوى. يُوثَّق المزود ومنطقة الاستضافة والأحداث المحددة ومدة التخزين والمعرفات المحتملة.","لا يتم تحميل أي إعلانات أو بكسلات وسائط اجتماعية بواسطة Bizowizo. يتطلب تغيير هذا البيان تحديث هذا الإشعار عند الاقتضاء."]},{id:"choice",title:"3. اختيارك",paragraphs:["في زيارتك الأولى، يمكنك استخدام التقنيات الضرورية فقط أو السماح بالتحليلات بشكل إضافي. كلا الخيارين متاحان بشكل متساوٍ. لا يتم تحميل التحليلات غير الضرورية قبل القرار."]},{id:"withdraw",title:"4. تغيير أو سحب الموافقة",paragraphs:['افتح "إعدادات ملفات تعريف الارتباط" في التذييل في أي وقت. ينطبق التغيير على المستقبل. البيانات التي تمت معالجتها بشكل قانوني بالفعل لا تصبح غير مقبولة بأثر رجعي؛ قد توجد حقوق الحذف أو الاعتراض بشكل إضافي.']},{id:"browser",title:"5. إعدادات المتصفح",paragraphs:["يمكن للمتصفحات حظر أو حذف ملفات تعريف الارتباط والتخزين المحلي. قد يؤدي هذا إلى إضعاف تسجيل الدخول أو اللغة أو المحفظة أو إعدادات الفيديو أو الوظائف الأخرى المطلوبة."]},{id:"changes",title:"6. التغييرات",paragraphs:["لن يتم تنشيط تقنيات التحليل أو الإعلان أو الجهات الخارجية الجديدة إلا بعد تحديث هذا الإشعار، وإذا لزم الأمر، الحصول على موافقة متجددة."]}]},withdrawal:{eyebrow:"معلومات للمستهلكين",title:"الإلغاء والاسترداد",summary:"معلومات بشأن الإلغاء والخدمات الرقمية ومشتريات الهدايا والوصول المميز والدعم والاستردادات.",shortNotice:os,version:"الإصدار 1.0",lastUpdated:"12 أغسطس 2026",sections:[{id:"scope",title:"1. لمن تنطبق هذه المعلومات",paragraphs:["هذه المعلومات موجهة للمستهلكين. لا تتمتع الشركات والوكالات عمومًا بحق قانوني في الإلغاء للمستهلكين. تخضع مشتريات الهدايا والوصول المميز والدعم المنفذ والخدمات الإعلانية للقانون المطبق وحقوق المستهلك الإلزامية."]},{id:"period",title:"2. فترة الإلغاء",paragraphs:["في حالة وجود عقد بيع عن بعد ذي صلة، هناك عمومًا فترة أربعة عشر يومًا من إبرام العقد. يجب الإعلان عن الإلغاء بوضوح ولا يتطلب أي مبرر."]},{id:"digital",title:"3. الخدمة الرقمية الفورية",paragraphs:["إذا كان سيتم توفير هدية رقمية أو وصول مميز على الفور، فلا يمكن أن ينتهي حق الإلغاء قبل الأوان إلا بموجب المتطلبات القانونية. يتضمن ذلك موافقة صريحة غير محددة مسبقًا على البدء الفوري، والمعرفة المؤكدة بفقدان الحق، والتأكيد على وسيط بيانات دائم.","إذا كان هناك متطلب مفقود، فلن يتم استبعاد حق الإلغاء فقط من خلال استخدام موقع الويب."]},{id:"donations",title:"4. الدعم والهدايا والقيود المنفذة",paragraphs:["تنشئ مشتريات الهدايا المؤكدة والدعم المنفذ سجلات أولية وسجلات التزام قابلة للتتبع وغير قابلة للتغيير؛ ولا يوجد تقسيم تلقائي للقيمة الاسمية. تتم الاستردادات والنزاعات والعكوس المطلوبة قانونًا من خلال قيود مقابلة موثقة فقط. تعتمد إمكانية إلغاء الدعم المنفذ أو استرداده على تصنيفه القانوني النهائي وحقوق المستهلك الإلزامية التي لا يجوز استبعادها عمومًا على حساب المستهلك."]},{id:"refunds",title:"5. المبالغ المستردة والنزاعات وحقوق العيوب",paragraphs:["الإلغاء والاسترداد الطوعي ورد المبالغ المدفوعة وحقوق العيوب القانونية هي عمليات مختلفة. تتم معالجة المبالغ المستردة أو النزاعات المؤكدة فنيًا من خلال القيود العكسية؛ تظل المجلة الأصلية كما هي.","تظل الحقوق القانونية في حالة الخدمات الرقمية غير المقدمة أو المعيبة موجودة بغض النظر عن الإلغاء."]},{id:"exercise",title:"6. إعلان الإلغاء",paragraphs:["لطلب الإلغاء أو الاسترداد، تواصل عبر info@bizowizo.ai.","قد تتاح وظيفة إلغاء إلكترونية إضافية للعقود ذات الصلة عبر الإنترنت وفق المتطلبات القانونية."]},{id:"consequences",title:"7. عواقب الإلغاء الفعال",paragraphs:["في حالة الإلغاء الفعال، سيتم سداد المدفوعات المستلمة وفقًا للقواعد القانونية وبشكل عام باستخدام نفس وسيلة الدفع، ما لم يتم الاتفاق على خلاف ذلك بشكل مسموح به. قد تؤدي الخدمات المقدمة بالفعل إلى تعويض عن القيمة بموجب المتطلبات القانونية."]}]}},wT="يرجى قراءة هذا المستند بعناية.";function PT(e,i={}){return{...e,...i}}function Nn(e,i={}){return{...e,shortNotice:wT,version:e.version.replace(/^[^\d]*/,"الإصدار "),sections:e.sections.map(t=>PT(t,i[t.id]))}}const ts=rr(yT,"ar"),ST={terms:Nn(ts.terms,{law:{paragraphs:["تسري هذه الشروط وفق القوانين السارية في دبي ودولة الإمارات العربية المتحدة، مع بقاء حقوق المستهلك الإلزامية محفوظة.","في الحدود التي يسمح بها القانون، تنظر المحاكم أو جهات تسوية المنازعات المختصة في دبي أو الإمارات في النزاعات. ويمكن للمستهلك استخدام قنوات الشكاوى المختصة لدى وزارة الاقتصاد أو دائرة الاقتصاد والسياحة في دبي."],warning:void 0},"tap-support-connect-v18":{warning:void 0}}),privacy:Nn(ts.privacy,{controller:{paragraphs:["المتحكم في بيانات Bizowizo هو Pitch60 Social Media Marketing Services - FZCO، IFZA Business Park، Premises No. 10742-001، دبي، الإمارات العربية المتحدة. الرخصة التجارية صادرة عن حكومة دبي برقم 10742، ورقم مكاني A1-3641379065.","عنوان البريد الإلكتروني المركزي لاستفسارات الخصوصية والتواصل مع المشغّل هو info@bizowizo.ai."],warning:void 0},rights:{paragraphs:["وفق الشروط القانونية، يمكن طلب المعلومات والوصول والتصحيح والحذف وتقييد المعالجة أو إيقافها وقابلية النقل والاعتراض على بعض القرارات الآلية. ويمكن سحب الموافقة للمستقبل.","يمكن تقديم الشكاوى وفق القانون المطبق إلى UAE Data Office أو الجهة الإماراتية المختصة."]},"changes-contact":{paragraphs:["سيتم تحديث هذا الإشعار عند إضافة مزودين أو وظائف أو أسس قانونية جديدة، وسيتم الإبلاغ عن التغييرات الجوهرية.","للاستفسارات المتعلقة بالخصوصية، يمكن التواصل عبر info@bizowizo.ai."],warning:void 0}}),imprint:{...Nn(ts.imprint,{contact:{paragraphs:["عنوان البريد الإلكتروني المركزي لاستفسارات المشغّل والخصوصية: info@bizowizo.ai."],warning:void 0},disputes:{paragraphs:["تسري مسائل القانون والمنازعات وفق القوانين السارية في دبي والإمارات، مع بقاء حقوق المستهلك الإلزامية محفوظة."]},copyright:{paragraphs:["تدير Pitch60 Social Media Marketing Services - FZCO منصة Bizowizo وشعار Bold-B ووسائط المنصة."]}})},community:Nn(ts.community),cookies:Nn(ts.cookies),withdrawal:{...Nn(ts.withdrawal,{contact:{paragraphs:["لطلب الاسترداد، تواصل مع Pitch60 Social Media Marketing Services - FZCO عبر info@bizowizo.ai."],warning:void 0},"tap-support-refunds-v18":{warning:void 0}}),summary:"قواعد مشتريات الهدايا والخدمات الرقمية والدعم المنفذ واستردادات Stripe والشكاوى وفق إطار دبي والإمارات."},ambassador:{...Nn(nr.ar,{promotion:{paragraphs:["تؤدي الروابط فقط إلى أهداف Bizowizo المعتمدة من الخادم. يحظر التحويل المفتوح وCookie Stuffing والنقر القسري والتضليل.","يجب بيان الإعلان أو رابط العمولة بوضوح وبلغة المنشور. يلتزم WIZO VIP بالتراخيص والتصاريح المنطبقة على موقعه وقناته."]},law:{paragraphs:["تسري التغييرات الجوهرية مستقبلًا أو بعد الموافقة المطلوبة. يوقف الإنهاء الإسناد الجديد من دون محو الحقوق والسجلات اللازمة.","تسري مسائل القانون والاختصاص والضرائب والتصاريح ومدة الاعتراض ولغة العقد وفق القانون المطبق في دبي والإمارات."],warning:void 0}}),summary:"شروط الطلب وروابط الإحالة وعمولة 5% والإفصاح والخصوصية ومدفوعات Stripe ومنع الإساءة."}},OT={pitchBoost:si.ar,pitchDonationTicker:li.ar,ambassador:ur.ar,commercialAccount:ui.ar,ads:di.ar,adReporting:pi.ar,common:{save:"حفظ",cancel:"إلغاء"},donationEffects:{live:"دعم مباشر",sent:"يُرسل",coins:"عملات",support:"Support",soundOn:"تشغيل صوت التبرع",soundOff:"إيقاف صوت التبرع",previewBadge:"معاينة التأثير",previewTitle:"تأثيرات التبرع المباشرة",previewDescription:"معاينة فقط – لن يتم خصم Coins ولا يُعد تبرعًا فعليًا.",previewSender:"Wizo Demo"},home:{login:"تسجيل الدخول",startBizo:"البدء كـ Bizo",startWizo:"البدء كـ Wizo",howItWorksEyebrow:"عرض · مباشر · دعم",howItWorksTitle:"هكذا يعمل Bizowizo",howItWorksStepsLabel:"كيف يعمل Bizowizo في ثلاث خطوات",howItWorksPitch:"عرض",howItWorksLive:"مباشر",howItWorksSupport:"دعم",howItWorksStep1Title:"سجّل وابدأ حملتك",howItWorksStep1Body:"أنشئ ملفك، وانشر حملتك، وشاركها واكسب أول المتابعين.",howItWorksStep1Label:"بدء · مشاركة · متابعون",howItWorksStep2Title:"أقنعهم مباشرة",howItWorksStep2Body:"قدّم فكرتك في Live Pitch ونافس عليها في Live Battle.",howItWorksStep2Label:"Live Pitch · Live Battle",howItWorksStep3Title:"أكمل واستلم الدفعة",howItWorksStep3Body:"أكمل الحملة بنجاح وجهّز الدفعة المستحقة بأمان.",howItWorksStep3Label:"هدف · إكمال · دفعة",startNow:"ابدأ الآن!",toFeed:"إلى الـ Feed",feed:"Pitch-Feed",shortVideoCrowdfunding:"التمويل الجماعي عبر الفيديو القصير",heroShort:"شاهد Pitch. احتفل بالفكرة. ادعم بـ Coins.",heroWelcome:"افعل ما تريد على BIZOWIZO-أول منصة عالمية للتمويل الجماعي بالفيديو القصير!",heroFunding:"اكتشف طرقًا جديدة لتمويل فكرتك. مهما كانت رؤيتك، ستجد على Bizowizo الدعم الذي تستحقه. قدّم فكرتك في عرض مقنع، واكسب الناس لمشروعك، وحوّلها إلى واقع مع مجتمع متفاعل.",watchPitches:"مشاهدة الـ Pitches",swipeHeadline:"مرّر. اكتشف. ادعم.",openFeed:"فتح الـ Feed",feedGatewayLabel:"اختيار Feeds في Bizowizo",feedGatewayEyebrow:"ثلاثة Feeds · مجتمع واحد",feedGatewayTitle:"اختر Feed الخاص بـ Bizowizo",feedGatewayDescription:"اكتشف أفكارًا جديدة، شاهد Bizos مباشرة أو ادعم المفضل لديك في الـ Battle.",feedRadarDescription:"شاهد فورًا عدد العروض المتاحة وأي عروض أو معارك مباشرة نشطة الآن.",feedRadarLabel:"رادار موجزات Bizowizo بالأعداد الحالية",publishedPitches:"العروض المتاحة",currentlyAvailable:"متاح