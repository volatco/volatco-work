dBizos:"已支持的 Bizos",supportCoins:"支持 Coins",interests:"兴趣",active:"活跃 Wizo",noInterests:"暂无公开兴趣",noBio:"此 Wizo 资料暂无公开简介。",openProfile:"查看资料",scrollHint:"滑动至下一个 Wizo",loading:"正在加载 Wizos",emptyTitle:"暂无可见 Wizo",emptyBody:"此搜索暂无活跃公开 Wizo 资料。",retry:"重试",likes:"点赞",like:"点赞 Wizo",unlike:"取消点赞",share:"分享",message:"消息",invite:"邀请参与项目",loadMore:"加载更多 Wizos"},hi:{navigationLabel:"WIZO FEED",pageLabel:"Wizo Feed",eyebrow:"WIZO DISCOVERY",title:"विचारों को आगे बढ़ाने वाले Wizos",subtitle:"एक समय में एक बड़ा, स्पष्ट और सीधे जुड़ा Wizo प्रोफ़ाइल खोजें।",searchPlaceholder:"Wizo या रुचि खोजें",supportedBizos:"समर्थित Bizos",supportCoins:"Support Coins",interests:"रुचियाँ",active:"सक्रिय Wizo",noInterests:"अभी सार्वजनिक रुचियाँ नहीं",noBio:"इस Wizo प्रोफ़ाइल में अभी सार्वजनिक परिचय नहीं है।",openProfile:"प्रोफ़ाइल देखें",scrollHint:"अगले Wizo पर स्वाइप करें",loading:"Wizos लोड हो रहे हैं",emptyTitle:"अभी कोई Wizo दिखाई नहीं देता",emptyBody:"इस खोज के लिए कोई सक्रिय सार्वजनिक Wizo प्रोफ़ाइल उपलब्ध नहीं है।",retry:"फिर प्रयास करें",likes:"लाइक्स",like:"Wizo को लाइक करें",unlike:"लाइक हटाएँ",share:"साझा करें",message:"संदेश",invite:"अभियान में बुलाएँ",loadMore:"और Wizos लोड करें"},hr:{navigationLabel:"WIZO FEED",pageLabel:"Wizo Feed",eyebrow:"WIZO DISCOVERY",title:"Wizos koji pokreću ideje",subtitle:"Otkrijte jedan Wizo profil odjednom — velik, jasan i izravno povezan.",searchPlaceholder:"Pretražite Wizos ili interese",supportedBizos:"Podržani Bizos",supportCoins:"Coins podrške",interests:"Interesi",active:"Aktivni Wizo",noInterests:"Još nema javnih interesa.",noBio:"Ovaj Wizo profil još nema javni sažetak.",openProfile:"Prikaži profil",scrollHint:"Prijeđite prstom na sljedeći Wizo",loading:"Učitavanje Wizos",emptyTitle:"Još nema vidljivih Wizos",emptyBody:"Za ovu pretragu nema dostupnog aktivnog javnog Wizo profila.",retry:"Pokušajte ponovno",likes:"Sviđanja",like:"Sviđa mi se Wizo",unlike:"Ukloni sviđanje",share:"Podijeli",message:"Pošalji poruku",invite:"Pozovi u kampanju",loadMore:"Učitaj više Wizos"},bs:pe({navigationLabel:"WIZO FEED",pageLabel:"Wizo Feed",eyebrow:"WIZO DISCOVERY",title:"Wizos koji pokreću ideje",subtitle:"Otkrijte jedan Wizo profil odjednom — velik, jasan i izravno povezan.",searchPlaceholder:"Pretražite Wizos ili interese",supportedBizos:"Podržani Bizos",supportCoins:"Coins podrške",interests:"Interesi",active:"Aktivni Wizo",noInterests:"Još nema javnih interesa.",noBio:"Ovaj Wizo profil još nema javni sažetak.",openProfile:"Prikaži profil",scrollHint:"Prijeđite prstom na sljedeći Wizo",loading:"Učitavanje Wizos",emptyTitle:"Još nema vidljivih Wizos",emptyBody:"Za ovu pretragu nema dostupnog aktivnog javnog Wizo profila.",retry:"Pokušajte ponovno",likes:"Sviđanja",like:"Sviđa mi se Wizo",unlike:"Ukloni sviđanje",share:"Podijeli",message:"Pošalji poruku",invite:"Pozovi u kampanju",loadMore:"Učitaj više Wizos"},"bs"),sr:pe({navigationLabel:"WIZO FEED",pageLabel:"Wizo Feed",eyebrow:"WIZO DISCOVERY",title:"Wizos koji pokreću ideje",subtitle:"Otkrijte jedan Wizo profil odjednom — velik, jasan i izravno povezan.",searchPlaceholder:"Pretražite Wizos ili interese",supportedBizos:"Podržani Bizos",supportCoins:"Coins podrške",interests:"Interesi",active:"Aktivni Wizo",noInterests:"Još nema javnih interesa.",noBio:"Ovaj Wizo profil još nema javni sažetak.",openProfile:"Prikaži profil",scrollHint:"Prijeđite prstom na sljedeći Wizo",loading:"Učitavanje Wizos",emptyTitle:"Još nema vidljivih Wizos",emptyBody:"Za ovu pretragu nema dostupnog aktivnog javnog Wizo profila.",retry:"Pokušajte ponovno",likes:"Sviđanja",like:"Sviđa mi se Wizo",unlike:"Ukloni sviđanje",share:"Podijeli",message:"Pošalji poruku",invite:"Pozovi u kampanju",loadMore:"Učitaj više Wizos"},"sr")};function U2(e){return M2[e]}const V2={de:{eyebrow:"BIZO · BUSINESS BUILDER · GRÜNDER · MACHER",title:"BIZO START",heroBody:"BIZO steht für Business: für Gründer, kreative Köpfe, Ideengeber und Macher, die aus einem Gedanken etwas Reales bauen. Du hast einen Traum – jetzt ist die Zeit, ihn in Wirklichkeit zu versetzen. Zeig deine Idee in einem 60-Sekunden-Pitch, starte deine 60-Tage-Kampagne und gewinne Menschen, die dein Projekt mit Support voranbringen.",processTitle:"Deine Idee. Dein Pitch. Deine Crowd.",processCards:[{label:"IDEE · PROFIL · 60-SEKUNDEN-PITCH",title:"Zeig, was für ein Business in deiner Idee steckt.",body:"Vervollständige dein BIZO-Profil als Gründer, kreativer Kopf, Ideengeber und Macher. Zeig in einem 60-Sekunden-Pitch, was du entwickelst, welches Problem du löst, was deine Idee besonders macht und warum Menschen dich unterstützen sollten."},{label:"60 TAGE · ZIEL · REWARDS",title:"Baue eine Kampagne, die jeder versteht.",body:"Lege dein Kampagnenziel und die 60-Tage-Laufzeit fest. Definiere bis zu fünf klare Rewards, prüfe alle Angaben und reiche deine Kampagne zur Veröffentlichung ein."},{label:"TEILEN · LIVE · SUPPORT",title:"Mach deine Community zu Mitstreitern.",body:"Teile deine Kampagne, gewinne echte Follower und halte alle mit Updates auf dem Laufenden. Ab 100 Followern öffnet Live Pitch, ab 200 Live Battle – für mehr Sichtbarkeit und Support."}],filmEyebrow:"DEIN 60-SEKUNDEN-PITCH",filmTitle:"60 Sekunden können der Anfang von etwas Großem sein.",filmBody:"Zeig den Menschen deinen Traum, dein Ziel und den nächsten konkreten Schritt. Ein klarer Pitch macht aus einer Idee eine Geschichte, die andere verstehen, teilen und supporten können.",startAction:"Als Bizo starten",feedAction:"Pitch Feed ansehen",roadmapEyebrow:"DEIN WEG ZUR KAMPAGNE",roadmapTitle:"Von deinem Traum zur veröffentlichten Kampagne.",roadmapBody:"Vervollständige dein Profil, lade deinen 60-Sekunden-Pitch hoch und beschreibe dein Projekt glasklar. Lege Ziel, 60 Tage Laufzeit und bis zu fünf Rewards fest, prüfe alle Angaben und veröffentliche deine Kampagne. Danach teilst du sie, gewinnst Follower und baust Schritt für Schritt echten Support auf.",discoverTitle:"Mach aus deinem Traum einen konkreten Plan.",discoverBody:"Zeig, welches Problem du löst, für wen deine Idee gedacht ist und was du als Nächstes umsetzen willst. So verstehen Menschen sofort, warum dein Projekt ihre Aufmerksamkeit verdient.",communityTitle:"Hol die ersten Menschen in dein Projekt.",communityBody:"Teile Pitch und Kampagne persönlich mit Freunden, Kontakten und Partnern. Bitte nicht nur um einen Klick, sondern lade sie ein, dir zu folgen, Fragen zu stellen und dein Projekt mit Support voranzubringen.",livePitchTitle:"Live Pitch ab 100 Followern",livePitchBody:"Erreiche 100 echte Follower und schalte Live Pitch frei. Stell dein Projekt live vor und beantworte Fragen.",liveBattleTitle:"Live Battle ab 200 Followern",liveBattleBody:"Erreiche 200 echte Follower und schalte Live Battle frei. Tritt live gegen einen anderen Bizo an und gewinne Sichtbarkeit und Support.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Jeder Schritt macht deinen Fortschritt sichtbar.",fundingBody:"M1, M2 und M3 zeigen deiner Community, wie sich deine Kampagne entwickelt. Nutze jeden Meilenstein für Updates, neue Shares und den nächsten Schub Richtung Kampagnenziel.",milestonesTitle:"Mach jeden Meilenstein zum nächsten Schub.",m1Title:"M1 · 40 % · Deine Idee bewegt Menschen",m1Body:"Mit 40 % erreichst du M1 und zeigst: Deine Kampagne gewinnt echten Support. Teile den Fortschritt und nutze das Momentum. BIZO-Rewards können nach den Regeln zu verifizierten Nettoerlösen entstehen; Prüfung und Risikofrist gelten weiter.",m2Title:"M2 · 70 % · Jetzt wird aus Interesse Momentum",m2Body:"Bei 70 % ist dein Ziel in Reichweite. Veröffentliche ein starkes Update, beantworte offene Fragen und aktiviere deine Community noch einmal für den entscheidenden nächsten Schritt.",m3Title:"M3 · 100 % · Kampagnenziel erreicht",m3Body:"Mit 100 % erreichst du M3 und dein Kampagnenziel. Danach folgen der reguläre Abschluss, die Prüfung von Gebühren und Reversals sowie die Risikofrist. Erst anschließend können tatsächlich verfügbare BIZO-Rewards ausgezahlt werden.",finishEyebrow:"ABSCHLUSS & MÖGLICHE AUSZAHLUNG",finishTitle:"Kampagne abgeschlossen. Jetzt wird sauber geprüft.",finishBody:"Nach dem Kampagnenende werden Gebühren, Reversals und der bereinigte Nettoerlös geprüft. Nach der 30-tägigen Risikofrist siehst du, welche BIZO-Rewards tatsächlich verfügbar sind und über Stripe ausgezahlt werden können.",finishSteps:["Kampagne und alle verbuchten Supportvorgänge regulär abschließen","Tatsächliche Gebühren, Rückerstattungen und Reversals prüfen","30-tägige Risikofrist vollständig abwarten","Danach verfügbare BIZO-Rewards sicher über Stripe auszahlen lassen"],note:"Auszahlungen sind nur bei erfüllten Voraussetzungen, abgeschlossenem Onboarding und verfügbarem Betrag möglich. Maßgeblich sind Konto, Checkout und die geltenden Bedingungen.",finalTitle:"Dein Traum wartet nicht. Starte jetzt.",finalBody:"Nimm deinen 60-Sekunden-Pitch auf, baue deine 60-Tage-Kampagne und zeig der Community, warum deine Idee Unterstützung verdient. Dein erster Schritt beginnt mit deinem BIZO-Profil."},en:{eyebrow:"BIZO · BUSINESS BUILDER · FOUNDER · IDEA MAKER",title:"BIZO START",heroBody:"BIZO stands for business: founders, creatives, idea makers and builders who turn a thought into something real. You have a dream—now bring it to life. Show it in a 60-second pitch, launch your 60-day campaign and win people who move your project forward with support.",processTitle:"Your idea. Your pitch. Your crowd.",processCards:[{label:"IDEA · PROFILE · 60-SECOND PITCH",title:"Show the business inside your idea.",body:"Complete your BIZO profile as a founder, creative mind and builder. Use 60 seconds to show what you create, the problem you solve, what makes it different and why people should support it."},{label:"60 DAYS · GOAL · REWARDS",title:"Build a campaign everyone understands.",body:"Set your campaign goal and 60-day duration. Define up to five clear Rewards, review every detail and submit your campaign for publication."},{label:"SHARE · LIVE · SUPPORT",title:"Turn your community into collaborators.",body:"Share your campaign, win real followers and keep everyone updated. Live Pitch unlocks at 100 followers and Live Battle at 200, giving you more ways to earn visibility and support."}],filmEyebrow:"YOUR 60-SECOND PITCH",filmTitle:"Show why your idea matters in 60 seconds.",filmBody:"Make your idea, goal and next step clear. Then launch your campaign and activate your community.",startAction:"Start as a Bizo",feedAction:"View Pitch Feed",roadmapEyebrow:"THREE STEPS. ONE GOAL.",roadmapTitle:"Show the idea. Start the campaign. Win support.",roadmapBody:"Create your profile and pitch. Publish your campaign for 60 days. Share it with your network and gain real followers and support.",discoverTitle:"Show your idea.",discoverBody:"Create your Bizo profile. Make your project clear. Then start.",communityTitle:"Win your first supporters.",communityBody:"Share your pitch personally. Invite friends, contacts and partners to Bizowizo. Ask for real followers and support.",livePitchTitle:"Live Pitch at 100 followers",livePitchBody:"Reach 100 real followers to unlock Live Pitch. Present your project live and answer questions.",liveBattleTitle:"Live Battle at 200 followers",liveBattleBody:"Reach 200 real followers to unlock Live Battle. Face another Bizo live and compete for visibility and support.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Your progress. Clearly shown.",fundingBody:"M1, M2 and M3 make your campaign progress visible. Your community sees how close you are to the campaign goal.",milestonesTitle:"Your milestones",m1Title:"M1 · 40%",m1Body:"At 40%, you reach M1. Bizo Rewards may arise under the verified net-revenue rules. Checks and the risk hold still apply.",m2Title:"M2 · 70%",m2Body:"At 70%, you reach M2. Share updates, answer questions and activate your community for the next step.",m3Title:"M3 · 100%",m3Body:"At 100%, you reach M3 and the campaign goal. Closing, fee verification and the risk hold follow. Only then may available Bizo Rewards be paid out.",finishEyebrow:"CLOSING & POSSIBLE PAYOUT",finishTitle:"Goal reached. Now comes the review.",finishBody:"Reaching the goal does not mean an immediate payout. Campaign progress, verified adjusted net revenue and available Bizo Rewards are shown separately.",finishSteps:["Close the campaign correctly","Verify actual fees and reversals","Wait for the 30-day risk hold","Request payout of available Bizo Rewards through Stripe"],note:"Payouts are only possible when conditions are met, onboarding is complete and a balance is available. The account, checkout and applicable terms are authoritative.",finalTitle:"Your idea needs a start.",finalBody:"Record your 60-second pitch. Launch your 60-day campaign. Share it and win support."},es:{eyebrow:"BIZO · BUSINESS BUILDER · FUNDADOR · IMPULSOR",title:"BIZO START",heroBody:"BIZO representa el business: fundadores, mentes creativas, ideadores e impulsores que convierten un pensamiento en algo real. Tienes un sueño; ahora dale vida. Muéstralo en un pitch de 60 segundos, inicia tu campaña de 60 días y gana personas que impulsen tu proyecto.",processTitle:"Tu idea. Tu pitch. Tu comunidad.",processCards:[{label:"IDEA · PERFIL · PITCH DE 60 SEGUNDOS",title:"Muestra el negocio que vive dentro de tu idea.",body:"Completa tu perfil BIZO como fundador, mente creativa, ideador e impulsor. Explica en 60 segundos qué construyes, qué problema resuelves, qué te hace diferente y por qué mereces apoyo."},{label:"60 DÍAS · META · REWARDS",title:"Crea una campaña que todos entiendan.",body:"Define la meta y la duración de 60 días. Configura hasta cinco Rewards claros, revisa todos los datos y envía la campaña para su publicación."},{label:"COMPARTIR · LIVE · APOYO",title:"Convierte tu comunidad en colaboradores.",body:"Comparte tu campaña, gana seguidores reales y publica actualizaciones. Live Pitch se abre con 100 seguidores y Live Battle con 200 para sumar visibilidad y apoyo."}],filmEyebrow:"TU PITCH DE 60 SEGUNDOS",filmTitle:"Muestra en 60 segundos por qué importa tu idea.",filmBody:"Deja clara tu idea, tu meta y el siguiente paso. Después inicia tu campaña y activa a tu comunidad.",startAction:"Empezar como Bizo",feedAction:"Ver Pitch Feed",roadmapEyebrow:"TRES PASOS. UNA META.",roadmapTitle:"Muestra tu idea. Inicia tu campaña. Gana apoyo.",roadmapBody:"Crea tu perfil y tu pitch. Publica tu campaña durante 60 días. Compártela con tu red y gana seguidores reales y apoyo.",discoverTitle:"Muestra tu idea.",discoverBody:"Crea tu perfil de Bizo. Haz que tu proyecto se entienda. Después empieza.",communityTitle:"Gana tus primeros apoyos.",communityBody:"Comparte tu pitch de forma personal. Invita a amigos, contactos y socios a Bizowizo. Pide seguidores reales y apoyo.",livePitchTitle:"Live Pitch con 100 seguidores",livePitchBody:"Alcanza 100 seguidores reales para desbloquear Live Pitch. Presenta tu proyecto en directo y responde preguntas.",liveBattleTitle:"Live Battle con 200 seguidores",liveBattleBody:"Alcanza 200 seguidores reales para desbloquear Live Battle. Compite en directo con otro Bizo por visibilidad y apoyo.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Tu progreso. Claro y visible.",fundingBody:"M1, M2 y M3 hacen visible el avance de tu campaña. Tu comunidad ve cuánto falta para la meta.",milestonesTitle:"Tus hitos",m1Title:"M1 · 40 %",m1Body:"Al 40 % alcanzas M1. Los Bizo Rewards pueden surgir según las reglas de ingresos netos verificados. Siguen aplicando controles y retención de riesgo.",m2Title:"M2 · 70 %",m2Body:"Al 70 % alcanzas M2. Comparte actualizaciones, responde preguntas y activa a tu comunidad para el siguiente paso.",m3Title:"M3 · 100 %",m3Body:"Al 100 % alcanzas M3 y la meta. Después vienen el cierre, la verificación de comisiones y la retención de riesgo. Solo entonces pueden pagarse Bizo Rewards disponibles.",finishEyebrow:"CIERRE Y POSIBLE PAGO",finishTitle:"Meta alcanzada. Ahora se verifica.",finishBody:"Alcanzar la meta no implica un pago inmediato. El progreso, el ingreso neto ajustado verificado y los Bizo Rewards disponibles se muestran por separado.",finishSteps:["Cerrar correctamente la campaña","Verificar comisiones reales y reversiones","Esperar la retención de riesgo de 30 días","Solicitar el pago de Bizo Rewards disponibles mediante Stripe"],note:"Los pagos solo son posibles si se cumplen los requisitos, se completa el onboarding y hay saldo disponible. Mandan la cuenta, el checkout y las condiciones vigentes.",finalTitle:"Tu idea necesita un comienzo.",finalBody:"Graba tu pitch de 60 segundos. Inicia tu campaña de 60 días. Compártela y gana apoyo."},ar:{eyebrow:"BIZO · صانع الأعمال · المؤسس · رائد الأعمال",title:"BIZO START",heroBody:"يرمز BIZO إلى عالم الأعمال: المؤسسون وأصحاب الأفكار ورواد الأعمال الذين يحوّلون الفكرة إلى واقع. لديك حلم؛ حان وقت إحيائه. اعرضه في 60 ثانية وابدأ حملتك لمدة 60 يوماً واكسب أشخاصاً يدفعون مشروعك إلى الأمام.",processTitle:"فكرتك. عرضك. مجتمعك.",processCards:[{label:"الفكرة · الملف · عرض 60 ثانية",title:"أظهر العمل الكامن في فكرتك.",body:"أكمل ملف BIZO كمؤسس وصاحب فكرة وباني مشروع. اشرح خلال 60 ثانية ما الذي تبنيه والمشكلة التي تحلها وما يميز فكرتك ولماذا تستحق الدعم."},{label:"60 يوماً · الهدف · REWARDS",title:"أنشئ حملة يفهمها الجميع.",body:"حدد هدف الحملة ومدتها البالغة 60 يوماً. عرّف حتى خمسة Rewards واضحة وراجع جميع البيانات ثم أرسل الحملة للنشر."},{label:"المشاركة · LIVE · الدعم",title:"حوّل مجتمعك إلى شركاء في الطريق.",body:"شارك حملتك واكسب متابعين حقيقيين وانشر التحديثات. يُفتح Live Pitch عند 100 متابع وLive Battle عند 200 لفرص أكبر في الظهور والدعم."}],filmEyebrow:"عرضك في 60 ثانية",filmTitle:"اعرض في 60 ثانية لماذا تهم فكرتك.",filmBody:"وضّح فكرتك وهدفك وخطوتك التالية. ثم ابدأ حملتك وفعّل مجتمعك.",startAction:"ابدأ كـ Bizo",feedAction:"شاهد Pitch Feed",roadmapEyebrow:"ثلاث خطوات. هدف واحد.",roadmapTitle:"اعرض فكرتك. ابدأ حملتك. اكسب الدعم.",roadmapBody:"أنشئ ملفك وعرضك. انشر حملتك لمدة 60 يومًا. شاركها مع شبكتك واكسب متابعين حقيقيين ودعمًا.",discoverTitle:"اعرض فكرتك.",discoverBody:"أنشئ ملفك كـ Bizo. اجعل مشروعك واضحًا. ثم ابدأ.",communityTitle:"اكسب داعميك الأوائل.",communityBody:"شارك عرضك بصورة شخصية. ادعُ الأصدقاء والمعارف والشركاء إلى Bizowizo. اطلب متابعين حقيقيين ودعمًا.",livePitchTitle:"Live Pitch عند 100 متابع",livePitchBody:"بلغ 100 متابع حقيقي لفتح Live Pitch. قدّم مشروعك مباشرة وأجب عن الأسئلة.",liveBattleTitle:"Live Battle عند 200 متابع",liveBattleBody:"بلغ 200 متابع حقيقي لفتح Live Battle. نافس Bizo آخر مباشرة على الظهور والدعم.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"تقدمك. ظاهر بوضوح.",fundingBody:"تجعل M1 وM2 وM3 تقدم حملتك ظاهرًا. يرى مجتمعك مدى قربك من هدف الحملة.",milestonesTitle:"محطاتك",m1Title:"M1 · 40٪",m1Body:"عند 40٪ تصل إلى M1. قد تنشأ Bizo Rewards وفق قواعد صافي الإيراد المتحقق. وتبقى الفحوص وفترة المخاطر سارية.",m2Title:"M2 · 70٪",m2Body:"عند 70٪ تصل إلى M2. شارك التحديثات وأجب عن الأسئلة وفعّل مجتمعك للخطوة التالية.",m3Title:"M3 · 100٪",m3Body:"عند 100٪ تصل إلى M3 وهدف الحملة. يلي ذلك الإغلاق وفحص الرسوم وفترة المخاطر. عندها فقط يمكن دفع Bizo Rewards المتاحة.",finishEyebrow:"الإغلاق والدفع المحتمل",finishTitle:"تم بلوغ الهدف. تبدأ المراجعة الآن.",finishBody:"بلوغ الهدف لا يعني دفعًا فوريًا. يُعرض تقدم الحملة وصافي الإيراد المعدل المتحقق وBizo Rewards المتاحة كلٌّ على حدة.",finishSteps:["أغلق الحملة بصورة صحيحة","تحقق من الرسوم الفعلية والاستردادات","انتظر فترة المخاطر لمدة 30 يومًا","اطلب دفع Bizo Rewards المتاحة عبر Stripe"],note:"لا تكون الدفعات ممكنة إلا عند استيفاء الشروط وإكمال الإعداد وتوفر رصيد. تبقى بيانات الحساب والدفع والشروط السارية هي المرجع.",finalTitle:"فكرتك تحتاج إلى بداية.",finalBody:"سجّل عرضك في 60 ثانية. ابدأ حملتك لمدة 60 يومًا. شاركها واكسب الدعم."},zh:{eyebrow:"BIZO · 商业构建者 · 创始人 · 实干家",title:"BIZO START",heroBody:"BIZO 代表 Business：创始人、构想者与实干家，把一个念头变成真正的事业。你有一个梦想，现在就让它成为现实。用 60 秒路演展示它，发起 60 天活动，赢得愿意推动项目的人。",processTitle:"你的创意。你的路演。你的社群。",processCards:[{label:"创意 · 资料 · 60 秒路演",title:"展示创意中蕴藏的商业可能。",body:"以创始人、构想者和实干家的身份完善 BIZO 资料。用 60 秒说明你要打造什么、解决什么问题、独特之处以及为什么值得支持。"},{label:"60 天 · 目标 · REWARDS",title:"创建人人都能看懂的活动。",body:"设定活动目标和 60 天期限。配置最多五项清晰的 Rewards，检查所有信息，然后提交发布。"},{label:"分享 · LIVE · 支持",title:"让社区成为并肩前行的伙伴。",body:"分享活动，赢得真实关注者，并持续发布更新。达到 100 名关注者可解锁 Live Pitch，达到 200 名可解锁 Live Battle，争取更多曝光和支持。"}],filmEyebrow:"你的 60 秒路演",filmTitle:"用 60 秒说明你的创意为何重要。",filmBody:"讲清创意、目标和下一步。然后发起活动，动员你的社区。",startAction:"以 Bizo 身份开始",feedAction:"查看 Pitch Feed",roadmapEyebrow:"三步。一个目标。",roadmapTitle:"展示创意。发起活动。赢得支持。",roadmapBody:"创建个人资料和路演。发布为期 60 天的活动。向你的网络分享，赢得真实关注者和支持。",discoverTitle:"展示你的创意。",discoverBody:"创建你的 Bizo 资料。清楚说明项目。然后开始。",communityTitle:"赢得第一批支持者。",communityBody:"亲自分享你的路演。邀请朋友、联系人和合作伙伴加入 Bizowizo。争取真实关注者和支持。",livePitchTitle:"100 名关注者解锁 Live Pitch",livePitchBody:"达到 100 名真实关注者后解锁 Live Pitch。直播介绍项目并回答问题。",liveBattleTitle:"200 名关注者解锁 Live Battle",liveBattleBody:"达到 200 名真实关注者后解锁 Live Battle。与另一位 Bizo 直播比拼，争取曝光和支持。",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"你的进展。清楚可见。",fundingBody:"M1、M2 和 M3 让活动进展清楚可见。社区可以看到你离活动目标还有多远。",milestonesTitle:"你的里程碑",m1Title:"M1 · 40%",m1Body:"达到 40% 即达到 M1。Bizo Rewards 可按经核验的净收入规则产生。审核和风险保留期仍然适用。",m2Title:"M2 · 70%",m2Body:"达到 70% 即达到 M2。分享更新、回答问题，并动员社区迈向下一步。",m3Title:"M3 · 100%",m3Body:"达到 100% 即达到 M3 和活动目标。之后须完成结项、费用核验和风险保留期。只有这样，才可支付可用的 Bizo Rewards。",finishEyebrow:"结项与可能的支付",finishTitle:"目标已达成。现在进入核验。",finishBody:"达到目标不代表立即支付。活动进度、经核验的调整后净收入和可用的 Bizo Rewards 会分别显示。",finishSteps:["正确结束活动","核验实际费用和撤销","等待 30 天风险保留期","通过 Stripe 申请提取可用的 Bizo Rewards"],note:"只有满足条件、完成入驻并有可用余额时，才可能支付。账户、结账页面和适用条款为准。",finalTitle:"你的创意需要一个开始。",finalBody:"录制你的 60 秒路演。发起为期 60 天的活动。分享它，赢得支持。"},hi:{eyebrow:"BIZO · BUSINESS BUILDER · FOUNDER · IDEA MAKER",title:"BIZO START",heroBody:"BIZO का अर्थ है business: founder, creative mind, idea maker और builder जो सोच को असली project में बदलता है। आपका एक सपना है—अब उसे सच बनाने का समय है। 60-second pitch में दिखाएँ, 60-day campaign शुरू करें और project को आगे बढ़ाने वाले लोगों को जोड़ें।",processTitle:"आपका आइडिया। आपकी पिच। आपकी कम्युनिटी।",processCards:[{label:"आइडिया · प्रोफ़ाइल · 60-सेकंड पिच",title:"दिखाएँ कि आपके आइडिया में कौन-सा business छिपा है।",body:"Founder, creative mind, idea maker और builder के रूप में BIZO profile पूरी करें। 60 सेकंड में बताएँ कि आप क्या बना रहे हैं, कौन-सी समस्या हल करते हैं, क्या अलग है और लोग सपोर्ट क्यों करें।"},{label:"60 दिन · लक्ष्य · REWARDS",title:"ऐसा कैंपेन बनाएं जिसे हर कोई समझे।",body:"कैंपेन लक्ष्य और 60-दिन की अवधि तय करें। अधिकतम पाँच साफ़ Rewards बनाएं, सभी जानकारियाँ जाँचें और कैंपेन प्रकाशन के लिए भेजें।"},{label:"शेयर · LIVE · सपोर्ट",title:"अपनी कम्युनिटी को साथ चलने वाला बनाएं।",body:"कैंपेन शेयर करें, असली फॉलोअर्स जोड़ें और अपडेट देते रहें। 100 फॉलोअर्स पर Live Pitch और 200 पर Live Battle खुलता है, जिससे दृश्यता और सपोर्ट के और मौके मिलते हैं।"}],filmEyebrow:"आपका 60-सेकंड का पिच",filmTitle:"60 सेकंड में बताइए कि आपका विचार क्यों महत्वपूर्ण है।",filmBody:"अपने विचार, लक्ष्य और अगले कदम को साफ़ बताइए। फिर कैंपेन शुरू कीजिए और कम्युनिटी को सक्रिय कीजिए।",startAction:"Bizo के रूप में शुरू करें",feedAction:"Pitch Feed देखें",roadmapEyebrow:"तीन कदम। एक लक्ष्य।",roadmapTitle:"विचार दिखाइए। कैंपेन शुरू कीजिए। सपोर्ट पाइए।",roadmapBody:"अपनी प्रोफ़ाइल और पिच बनाइए। 60 दिनों के लिए अपना कैंपेन प्रकाशित कीजिए। उसे नेटवर्क में साझा कीजिए और असली फॉलोअर्स व सपोर्ट पाइए।",discoverTitle:"अपना विचार दिखाइए।",discoverBody:"अपनी Bizo प्रोफ़ाइल बनाइए। प्रोजेक्ट को साफ़ समझाइए। फिर शुरू कीजिए।",communityTitle:"अपने पहले सपोर्टर्स पाइए।",communityBody:"अपना पिच व्यक्तिगत रूप से साझा कीजिए। दोस्तों, संपर्कों और पार्टनर्स को Bizowizo पर आमंत्रित कीजिए। असली फॉलोअर्स और सपोर्ट माँगिए।",livePitchTitle:"100 फॉलोअर्स पर Live Pitch",livePitchBody:"100 असली फॉलोअर्स तक पहुँचें और Live Pitch खोलें। अपना प्रोजेक्ट लाइव दिखाइए और सवालों के जवाब दीजिए।",liveBattleTitle:"200 फॉलोअर्स पर Live Battle",liveBattleBody:"200 असली फॉलोअर्स तक पहुँचें और Live Battle खोलें। दूसरे Bizo के साथ लाइव मुकाबला कीजिए और दृश्यता व सपोर्ट के लिए प्रतिस्पर्धा कीजिए।",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"आपकी प्रगति। साफ़ दिखाई गई।",fundingBody:"M1, M2 और M3 आपके कैंपेन की प्रगति दिखाते हैं। आपकी कम्युनिटी देखती है कि आप लक्ष्य के कितने करीब हैं।",milestonesTitle:"आपके मील के पत्थर",m1Title:"M1 · 40%",m1Body:"40% पर आप M1 तक पहुँचते हैं। सत्यापित नेट-रेवेन्यू नियमों के तहत Bizo Rewards बन सकते हैं। जाँच और रिस्क होल्ड लागू रहते हैं।",m2Title:"M2 · 70%",m2Body:"70% पर आप M2 तक पहुँचते हैं। अपडेट साझा कीजिए, सवालों के जवाब दीजिए और अगले कदम के लिए कम्युनिटी को सक्रिय कीजिए।",m3Title:"M3 · 100%",m3Body:"100% पर आप M3 और कैंपेन लक्ष्य तक पहुँचते हैं। इसके बाद क्लोजिंग, फीस जाँच और रिस्क होल्ड होता है। तभी उपलब्ध Bizo Rewards का भुगतान हो सकता है।",finishEyebrow:"समापन और संभावित भुगतान",finishTitle:"लक्ष्य पूरा हुआ। अब जाँच होगी।",finishBody:"लक्ष्य पूरा होने का अर्थ तुरंत भुगतान नहीं है। कैंपेन प्रगति, सत्यापित समायोजित नेट रेवेन्यू और उपलब्ध Bizo Rewards अलग-अलग दिखाए जाते हैं।",finishSteps:["कैंपेन सही तरह बंद करें","वास्तविक फीस और रिवर्सल जाँचें","30-दिन का रिस्क होल्ड पूरा करें","Stripe से उपलब्ध Bizo Rewards के भुगतान का अनुरोध करें"],note:"भुगतान केवल तब संभव है जब शर्तें पूरी हों, onboarding पूरा हो और बैलेंस उपलब्ध हो। अकाउंट, checkout और लागू शर्तें मान्य हैं।",finalTitle:"आपके विचार को एक शुरुआत चाहिए।",finalBody:"अपना 60-सेकंड का पिच रिकॉर्ड कीजिए। 60-दिन का कैंपेन शुरू कीजिए। उसे साझा कीजिए और सपोर्ट पाइए।"},hr:{eyebrow:"BIZO · BUSINESS BUILDER · OSNIVAČ · POKRETAČ",title:"BIZO START",heroBody:"BIZO predstavlja business: osnivače, kreativne umove, pokretače ideja i graditelje koji misao pretvaraju u nešto stvarno. Imate san; sada ga oživite. Predstavite ga u pitchu od 60 sekundi, pokrenite kampanju od 60 dana i okupite ljude koji podrškom pokreću projekt.",processTitle:"Vaša ideja. Vaš pitch. Vaša zajednica.",processCards:[{label:"IDEJA · PROFIL · PITCH OD 60 SEKUNDI",title:"Pokažite kakav se posao krije u vašoj ideji.",body:"Dovršite BIZO profil kao osnivač, kreativni um, pokretač ideja i graditelj. U 60 sekundi pokažite što gradite, koji problem rješavate, po čemu ste posebni i zašto zaslužujete podršku."},{label:"60 DANA · CILJ · REWARDS",title:"Izradite kampanju koju svi razumiju.",body:"Postavite cilj i trajanje od 60 dana. Definirajte do pet jasnih Rewards, provjerite sve podatke i pošaljite kampanju na objavu."},{label:"DIJELJENJE · LIVE · PODRŠKA",title:"Pretvorite zajednicu u suradnike.",body:"Podijelite kampanju, okupite stvarne pratitelje i objavljujte novosti. Live Pitch otvara se na 100 pratitelja, a Live Battle na 200, za veću vidljivost i podršku."}],filmEyebrow:"VAŠ PITCH OD 60 SEKUNDI",filmTitle:"U 60 sekundi pokažite zašto je vaša ideja važna.",filmBody:"Jasno recite ideju, cilj i sljedeći korak. Zatim pokrenite kampanju i aktivirajte zajednicu.",startAction:"Započnite kao Bizo",feedAction:"Pogledajte Pitch Feed",roadmapEyebrow:"TRI KORAKA. JEDAN CILJ.",roadmapTitle:"Pokažite ideju. Pokrenite kampanju. Osvojite podršku.",roadmapBody:"Izradite profil i pitch. Objavite kampanju na 60 dana. Podijelite je sa svojom mrežom i prikupite stvarne pratitelje i podršku.",discoverTitle:"Pokažite svoju ideju.",discoverBody:"Izradite svoj Bizo profil. Jasno predstavite projekt. Zatim krenite.",communityTitle:"Pridobijte prve podržavatelje.",communityBody:"Podijelite pitch osobno. Pozovite prijatelje, kontakte i partnere na Bizowizo. Zatražite stvarne pratitelje i podršku.",livePitchTitle:"Live Pitch od 100 pratitelja",livePitchBody:"Dosegnite 100 stvarnih pratitelja i otključajte Live Pitch. Predstavite projekt uživo i odgovorite na pitanja.",liveBattleTitle:"Live Battle od 200 pratitelja",liveBattleBody:"Dosegnite 200 stvarnih pratitelja i otključajte Live Battle. Natječite se uživo s drugim Bizom za vidljivost i podršku.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Vaš napredak. Jasno prikazan.",fundingBody:"M1, M2 i M3 čine napredak kampanje vidljivim. Vaša zajednica vidi koliko ste blizu cilju kampanje.",milestonesTitle:"Vaše prekretnice",m1Title:"M1 · 40%",m1Body:"Na 40% dosežete M1. Bizo Rewards mogu nastati prema pravilima o verificiranom neto prihodu. Provjere i zadržavanje zbog rizika i dalje vrijede.",m2Title:"M2 · 70%",m2Body:"Na 70% dosežete M2. Dijelite novosti, odgovarajte na pitanja i aktivirajte zajednicu za sljedeći korak.",m3Title:"M3 · 100%",m3Body:"Na 100% dosežete M3 i cilj kampanje. Slijede zatvaranje, provjera naknada i zadržavanje zbog rizika. Tek tada dostupne Bizo Rewards mogu biti isplaćene.",finishEyebrow:"ZATVARANJE I MOGUĆA ISPLATA",finishTitle:"Cilj je ostvaren. Sada slijedi provjera.",finishBody:"Ostvaren cilj ne znači trenutačnu isplatu. Napredak kampanje, verificirani prilagođeni neto prihod i dostupne Bizo Rewards prikazuju se odvojeno.",finishSteps:["Ispravno zatvorite kampanju","Provjerite stvarne naknade i povrate","Pričekajte zadržavanje zbog rizika od 30 dana","Zatražite isplatu dostupnih Bizo Rewards putem Stripea"],note:"Isplata je moguća samo uz ispunjene uvjete, dovršen onboarding i raspoloživ saldo. Račun, checkout i primjenjivi uvjeti su mjerodavni.",finalTitle:"Vaša ideja treba početak.",finalBody:"Snimite pitch od 60 sekundi. Pokrenite kampanju od 60 dana. Podijelite je i osvojite podršku."},bs:pe({eyebrow:"BIZO · BUSINESS BUILDER · OSNIVAČ · POKRETAČ",title:"BIZO START",heroBody:"BIZO predstavlja business: osnivače, kreativne umove, pokretače ideja i graditelje koji misao pretvaraju u nešto stvarno. Imate san; sada ga oživite. Predstavite ga u pitchu od 60 sekundi, pokrenite kampanju od 60 dana i okupite ljude koji podrškom pokreću projekt.",processTitle:"Vaša ideja. Vaš pitch. Vaša zajednica.",processCards:[{label:"IDEJA · PROFIL · PITCH OD 60 SEKUNDI",title:"Pokažite kakav se posao krije u vašoj ideji.",body:"Dovršite BIZO profil kao osnivač, kreativni um, pokretač ideja i graditelj. U 60 sekundi pokažite što gradite, koji problem rješavate, po čemu ste posebni i zašto zaslužujete podršku."},{label:"60 DANA · CILJ · REWARDS",title:"Izradite kampanju koju svi razumiju.",body:"Postavite cilj i trajanje od 60 dana. Definirajte do pet jasnih Rewards, provjerite sve podatke i pošaljite kampanju na objavu."},{label:"DIJELJENJE · LIVE · PODRŠKA",title:"Pretvorite zajednicu u suradnike.",body:"Podijelite kampanju, okupite stvarne pratitelje i objavljujte novosti. Live Pitch otvara se na 100 pratitelja, a Live Battle na 200, za veću vidljivost i podršku."}],filmEyebrow:"VAŠ PITCH OD 60 SEKUNDI",filmTitle:"U 60 sekundi pokažite zašto je vaša ideja važna.",filmBody:"Jasno recite ideju, cilj i sljedeći korak. Zatim pokrenite kampanju i aktivirajte zajednicu.",startAction:"Započnite kao Bizo",feedAction:"Pogledajte Pitch Feed",roadmapEyebrow:"TRI KORAKA. JEDAN CILJ.",roadmapTitle:"Pokažite ideju. Pokrenite kampanju. Osvojite podršku.",roadmapBody:"Izradite profil i pitch. Objavite kampanju na 60 dana. Podijelite je sa svojom mrežom i prikupite stvarne pratitelje i podršku.",discoverTitle:"Pokažite svoju ideju.",discoverBody:"Izradite svoj Bizo profil. Jasno predstavite projekt. Zatim krenite.",communityTitle:"Pridobijte prve podržavatelje.",communityBody:"Podijelite pitch osobno. Pozovite prijatelje, kontakte i partnere na Bizowizo. Zatražite stvarne pratitelje i podršku.",livePitchTitle:"Live Pitch od 100 pratitelja",livePitchBody:"Dosegnite 100 stvarnih pratitelja i otključajte Live Pitch. Predstavite projekt uživo i odgovorite na pitanja.",liveBattleTitle:"Live Battle od 200 pratitelja",liveBattleBody:"Dosegnite 200 stvarnih pratitelja i otključajte Live Battle. Natječite se uživo s drugim Bizom za vidljivost i podršku.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Vaš napredak. Jasno prikazan.",fundingBody:"M1, M2 i M3 čine napredak kampanje vidljivim. Vaša zajednica vidi koliko ste blizu cilju kampanje.",milestonesTitle:"Vaše prekretnice",m1Title:"M1 · 40%",m1Body:"Na 40% dosežete M1. Bizo Rewards mogu nastati prema pravilima o verificiranom neto prihodu. Provjere i zadržavanje zbog rizika i dalje vrijede.",m2Title:"M2 · 70%",m2Body:"Na 70% dosežete M2. Dijelite novosti, odgovarajte na pitanja i aktivirajte zajednicu za sljedeći korak.",m3Title:"M3 · 100%",m3Body:"Na 100% dosežete M3 i cilj kampanje. Slijede zatvaranje, provjera naknada i zadržavanje zbog rizika. Tek tada dostupne Bizo Rewards mogu biti isplaćene.",finishEyebrow:"ZATVARANJE I MOGUĆA ISPLATA",finishTitle:"Cilj je ostvaren. Sada slijedi provjera.",finishBody:"Ostvaren cilj ne znači trenutačnu isplatu. Napredak kampanje, verificirani prilagođeni neto prihod i dostupne Bizo Rewards prikazuju se odvojeno.",finishSteps:["Ispravno zatvorite kampanju","Provjerite stvarne naknade i povrate","Pričekajte zadržavanje zbog rizika od 30 dana","Zatražite isplatu dostupnih Bizo Rewards putem Stripea"],note:"Isplata je moguća samo uz ispunjene uvjete, dovršen onboarding i raspoloživ saldo. Račun, checkout i primjenjivi uvjeti su mjerodavni.",finalTitle:"Vaša ideja treba početak.",finalBody:"Snimite pitch od 60 sekundi. Pokrenite kampanju od 60 dana. Podijelite je i osvojite podršku."},"bs"),sr:pe({eyebrow:"BIZO · BUSINESS BUILDER · OSNIVAČ · POKRETAČ",title:"BIZO START",heroBody:"BIZO predstavlja business: osnivače, kreativne umove, pokretače ideja i graditelje koji misao pretvaraju u nešto stvarno. Imate san; sada ga oživite. Predstavite ga u pitchu od 60 sekundi, pokrenite kampanju od 60 dana i okupite ljude koji podrškom pokreću projekt.",processTitle:"Vaša ideja. Vaš pitch. Vaša zajednica.",processCards:[{label:"IDEJA · PROFIL · PITCH OD 60 SEKUNDI",title:"Pokažite kakav se posao krije u vašoj ideji.",body:"Dovršite BIZO profil kao osnivač, kreativni um, pokretač ideja i graditelj. U 60 sekundi pokažite što gradite, koji problem rješavate, po čemu ste posebni i zašto zaslužujete podršku."},{label:"60 DANA · CILJ · REWARDS",title:"Izradite kampanju koju svi razumiju.",body:"Postavite cilj i trajanje od 60 dana. Definirajte do pet jasnih Rewards, provjerite sve podatke i pošaljite kampanju na objavu."},{label:"DIJELJENJE · LIVE · PODRŠKA",title:"Pretvorite zajednicu u suradnike.",body:"Podijelite kampanju, okupite stvarne pratitelje i objavljujte novosti. Live Pitch otvara se na 100 pratitelja, a Live Battle na 200, za veću vidljivost i podršku."}],filmEyebrow:"VAŠ PITCH OD 60 SEKUNDI",filmTitle:"U 60 sekundi pokažite zašto je vaša ideja važna.",filmBody:"Jasno recite ideju, cilj i sljedeći korak. Zatim pokrenite kampanju i aktivirajte zajednicu.",startAction:"Započnite kao Bizo",feedAction:"Pogledajte Pitch Feed",roadmapEyebrow:"TRI KORAKA. JEDAN CILJ.",roadmapTitle:"Pokažite ideju. Pokrenite kampanju. Osvojite podršku.",roadmapBody:"Izradite profil i pitch. Objavite kampanju na 60 dana. Podijelite je sa svojom mrežom i prikupite stvarne pratitelje i podršku.",discoverTitle:"Pokažite svoju ideju.",discoverBody:"Izradite svoj Bizo profil. Jasno predstavite projekt. Zatim krenite.",communityTitle:"Pridobijte prve podržavatelje.",communityBody:"Podijelite pitch osobno. Pozovite prijatelje, kontakte i partnere na Bizowizo. Zatražite stvarne pratitelje i podršku.",livePitchTitle:"Live Pitch od 100 pratitelja",livePitchBody:"Dosegnite 100 stvarnih pratitelja i otključajte Live Pitch. Predstavite projekt uživo i odgovorite na pitanja.",liveBattleTitle:"Live Battle od 200 pratitelja",liveBattleBody:"Dosegnite 200 stvarnih pratitelja i otključajte Live Battle. Natječite se uživo s drugim Bizom za vidljivost i podršku.",fundingEyebrow:"M1 · M2 · M3",fundingTitle:"Vaš napredak. Jasno prikazan.",fundingBody:"M1, M2 i M3 čine napredak kampanje vidljivim. Vaša zajednica vidi koliko ste blizu cilju kampanje.",milestonesTitle:"Vaše prekretnice",m1Title:"M1 · 40%",m1Body:"Na 40% dosežete M1. Bizo Rewards mogu nastati prema pravilima o verificiranom neto prihodu. Provjere i zadržavanje zbog rizika i dalje vrijede.",m2Title:"M2 · 70%",m2Body:"Na 70% dosežete M2. Dijelite novosti, odgovarajte na pitanja i aktivirajte zajednicu za sljedeći korak.",m3Title:"M3 · 100%",m3Body:"Na 100% dosežete M3 i cilj kampanje. Slijede zatvaranje, provjera naknada i zadržavanje zbog rizika. Tek tada dostupne Bizo Rewards mogu biti isplaćene.",finishEyebrow:"ZATVARANJE I MOGUĆA ISPLATA",finishTitle:"Cilj je ostvaren. Sada slijedi provjera.",finishBody:"Ostvaren cilj ne znači trenutačnu isplatu. Napredak kampanje, verificirani prilagođeni neto prihod i dostupne Bizo Rewards prikazuju se odvojeno.",finishSteps:["Ispravno zatvorite kampanju","Provjerite stvarne naknade i povrate","Pričekajte zadržavanje zbog rizika od 30 dana","Zatražite isplatu dostupnih Bizo Rewards putem Stripea"],note:"Isplata je moguća samo uz ispunjene uvjete, dovršen onboarding i raspoloživ saldo. Račun, checkout i primjenjivi uvjeti su mjerodavni.",finalTitle:"Vaša ideja treba početak.",finalBody:"Snimite pitch od 60 sekundi. Pokrenite kampanju od 60 dana. Podijelite je i osvojite podršku."},"sr")},_2={de:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · DER WIZARD FÜR IDEEN UND VISIONEN",title:"Werde zum WIZO. Erwecke Ideen zum Leben.",heroBody:"Du interessierst dich für Start-ups, Gründer, neue Ideen und große Visionen? Als WIZO – der Wizard der Community – entdeckst du Projekte, glaubst an ihre Träume, supportest sie mit Coins und Gifts und hilfst dabei, aus Visionen Wirklichkeit zu machen. Zeig anderen, was dich begeistert, lade sie über deinen persönlichen Share-Link ein und erhalte Provision, wenn zugeordnete WIZOs später qualifiziert supporten.",primaryAction:"Jetzt Wizo werden",secondaryAction:"Wizo Feed entdecken",impactLabel:"WIZO VIP",impactTitle:"Supporten. Teilen. Verdienen.",impactBody:"Dein Wizo-Profil ist dein WIZO VIP-Einstieg. Qualifizierter, gebuchter Support von zugeordneten Personen kann Provision auslösen.",filmEyebrow:"DEIN EINSTIEG ALS WIZO",filmTitle:"So wirst du zum WIZO, der Ideen zum Leben erweckt.",filmBody:"Sieh, wie du Projekte unterstützt, Inhalte teilst und deinen Status im WIZO VIP-Bereich verfolgst.",journeyEyebrow:"DEINE WIZO-MAGIE · ENTDECKEN · SUPPORTEN · TEILEN",journeyTitle:"Unterstütze Ideen. Teile, was überzeugt.",journeyBody:"Wähle Bizos und Projekte, die du voranbringen willst. Teile sie mit deinem persönlichen Link. Qualifizierter, gebuchter Support zugeordneter Personen kann Provision auslösen.",steps:[{title:"Wizo-Profil starten",body:"Registriere dich als Wizo, zeige deine Interessen und aktiviere damit automatisch deinen Einstieg in das WIZO VIP-Programm."},{title:"Ideen entdecken",body:"Erlebe kurze Pitches, Live Pitches und Battles. Finde Bizos und Projekte, an deren Vision du wirklich glaubst."},{title:"Direkt unterstützen",body:"Nutze Tap Coins, Geschenke und Support, um Projekten Rückenwind zu geben und ihren Fortschritt sichtbar zu machen."},{title:"Persönlichen Link teilen",body:"Teile Kampagnen, Pitches und Profile mit deinem persönlichen Link über Social Media, Messenger sowie direkte Gespräche."},{title:"Menschen dauerhaft verbinden",body:"Registriert sich ein Kontakt nach deinem gültigen Link, wird die zulässige Attribution dauerhaft seinem Konto und deinem Wizo-Profil zugeordnet."},{title:"Provision aus qualifiziertem Support",body:"Leistet eine zugeordnete Person qualifizierten, gebuchten Coin-Support, wird 5 % Standardprovision erfasst. Mit gültigem VIP-Status gelten 10 %."}],shareEyebrow:"TEILEN MIT PERSÖNLICHEM LINK",shareTitle:"Teile Ideen mit den richtigen Menschen.",shareBody:"Teile Kampagnen, Pitches und Profile persönlich oder über deine Kanäle. Nach einer zulässigen Registrierung bleibt die Zuordnung bestehen.",opportunityEyebrow:"DEIN WIZO VIP-SYSTEM IM DETAIL",opportunityTitle:"So entsteht Provision.",opportunityBody:"Teile einen persönlichen Link. Registriert sich ein Kontakt zulässig, wird er deinem Wizo-Profil zugeordnet. Leistet er später qualifizierten, gebuchten Coin-Support, gilt dein Satz zum Buchungszeitpunkt.",opportunityFlowTitle:"Vier Schritte zu deiner Provision",referralFlow:[{title:"1. Persönlichen Link teilen",body:"Wähle Inhalt, den du vertreten willst, und teile deinen persönlichen Link."},{title:"2. Zulässige Registrierung",body:"Registriert sich ein echter Kontakt nach deinem Link zulässig, bleibt er deinem Wizo-Profil zugeordnet."},{title:"3. Qualifizierter, gebuchter Support",body:"Unterstützt die zugeordnete Person einen Bizo mit tatsächlich gebuchten Coins, entsteht ein provisionsfähiger Support."},{title:"4. Provision wird erfasst",body:"Für jeden späteren qualifizierten, gebuchten Support gelten 5 % Standardprovision oder 10 % bei gültigem Wizo-VIP-Status zum Buchungszeitpunkt."}],opportunityCards:[{title:"5 % Standardprovision",body:"Qualifizierter, gebuchter und nicht rückabgewickelter Support einer zugeordneten Person wird mit 5 % gemäß Programmregeln erfasst."},{title:"10 % Wizo VIP",body:"Ab 100 aktiven, direkt zugeordneten Wizos im rollierenden 30-Tage-Zeitraum gelten 10 % für künftigen qualifizierten Support."},{title:"Teilen mit Wirkung",body:"Teile Inhalte, die zu deinem Netzwerk passen. So bringst du Projekte voran und gewinnst zugeordnete Wizos."}],opportunityPermanentTitle:"Deine Zuordnung bleibt bestehen.",opportunityPermanentBody:"Eine zulässig geworbene Person bleibt deinem Wizo-Profil zugeordnet. Rückerstattungen, Chargebacks oder Missbrauch können Buchungen rückgängig machen. Provisionen erscheinen zunächst in der 30-Tage-Risikofrist in deiner privaten Übersicht.",opportunityAction:"WIZO VIP-System im Detail",programmeNote:"Provision entsteht nur durch qualifizierten, tatsächlich gebuchten Support zugeordneter Personen. Teilen oder Registrierung allein erzeugen keine Provision. VIP-Status und Auszahlung richten sich nach den geltenden Programm- und Auszahlungsregeln.",finalTitle:"Werde der WIZO, den große Ideen brauchen.",finalBody:"Entdecke die Menschen hinter neuen Visionen, gib ihren Projekten Rückenwind und zeig deinem Netzwerk, woran du glaubst. Mit deinem persönlichen Share-Link lädst du neue WIZOs ein; qualifizierter, gebuchter Support kann gemäß Programmregeln Provision auslösen.",finalAction:"Jetzt Wizo werden"},en:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · THE WIZARD FOR IDEAS AND VISIONARIES",title:"Become a WIZO. Bring ideas to life.",heroBody:"Are start-ups, founders, new ideas and bold visions your world? As a WIZO—the community's wizard—you discover projects, believe in founders' dreams and support them with Coins and Gifts. Show people what inspires you, invite them through your personal Share Link and earn commission when attributed WIZOs later make qualified support under the Programme Rules.",primaryAction:"Become a Wizo now",secondaryAction:"Explore the Wizo Feed",impactLabel:"WIZO VIP",impactTitle:"Support. Share. Earn.",impactBody:"Your Wizo profile is your WIZO VIP entry point. Qualified, booked support from attributed people can create commission.",filmEyebrow:"YOUR WIZO START",filmTitle:"Become the WIZO who brings ideas to life.",filmBody:"See how to support projects, share content and follow your WIZO VIP status.",journeyEyebrow:"YOUR WIZO MAGIC · DISCOVER · SUPPORT · SHARE",journeyTitle:"Support ideas. Share what matters.",journeyBody:"Choose Bizos and projects you want to move forward. Share them with your personal link. Qualified, booked support from attributed people can create commission.",steps:[{title:"Start your Wizo profile",body:"Register as a Wizo, show your interests and automatically activate your entry into the WIZO VIP programme."},{title:"Discover ideas",body:"Experience short pitches, Live Pitches and Battles. Find the Bizos and projects you truly believe in."},{title:"Support directly",body:"Use Tap Coins, gifts and support to give projects momentum and make progress visible."},{title:"Share your personal link",body:"Share campaigns, pitches and profiles through your personal link on social media, messaging and direct conversations."},{title:"Connect people permanently",body:"When a contact validly registers after your link, the permitted attribution remains permanently connected to their account and your Wizo profile."},{title:"Commission from qualified support",body:"When an attributed person makes qualified, booked Coin support, 5% standard commission is recorded. With valid VIP status, 10% applies."}],shareEyebrow:"SHARE WITH YOUR PERSONAL LINK",shareTitle:"Share ideas with the right people.",shareBody:"Share campaigns, pitches and profiles directly or through your channels. After a permitted registration, the attribution remains.",opportunityEyebrow:"YOUR WIZO VIP SYSTEM IN DETAIL",opportunityTitle:"How commission is created.",opportunityBody:"Share a personal link. When a contact registers validly, they are attributed to your Wizo profile. When they later make qualified, booked Coin support, your rate at booking applies.",opportunityFlowTitle:"Four steps to commission",referralFlow:[{title:"1. Share a personal link",body:"Choose content you stand behind and share your personal link."},{title:"2. Permitted registration",body:"When a real contact registers validly after your link, they remain attributed to your Wizo profile."},{title:"3. Qualified, booked support",body:"When the attributed person supports a Bizo with actually booked Coins, commissionable support is created."},{title:"4. Commission is recorded",body:"Later qualified, booked support earns 5% standard commission or 10% when Wizo VIP is valid at booking."}],opportunityCards:[{title:"5% standard commission",body:"Qualified, booked and non-reversed support from an attributed person records 5% commission under the Programme Rules."},{title:"10% Wizo VIP",body:"From 100 active, directly attributed Wizos in a rolling 30-day period, 10% applies to future qualified support."},{title:"Share with impact",body:"Share content that fits your network. Move projects forward and gain attributed Wizos."}],opportunityPermanentTitle:"Your attribution remains.",opportunityPermanentBody:"A validly referred person remains attributed to your Wizo profile. Refunds, chargebacks or misuse can reverse a booking. Commission first appears in your private overview during the 30-day risk period.",opportunityAction:"Explore the WIZO VIP system",programmeNote:"Commission requires qualified, actually booked support from attributed people. Sharing or registration alone creates no commission. VIP status and payout follow the applicable Programme and payout rules.",finalTitle:"Become the WIZO great ideas need.",finalBody:"Meet the people behind new visions, give their projects momentum and show your network what you believe in. Invite new WIZOs with your personal Share Link; qualified, booked support may create commission under the Programme Rules.",finalAction:"Become a Wizo now"},es:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · EL MAGO DE LAS IDEAS Y LAS VISIONES",title:"Conviértete en WIZO. Da vida a las ideas.",heroBody:"¿Te apasionan las start-ups, los fundadores, las ideas nuevas y las grandes visiones? Como WIZO, el mago de la comunidad, descubres proyectos, crees en los sueños de sus creadores y los apoyas con Coins y regalos. Muestra lo que te inspira, invita a otras personas con tu Share Link y recibe comisión cuando los WIZOs atribuidos realizan apoyo cualificado según las normas.",primaryAction:"Hazte Wizo ahora",secondaryAction:"Descubrir Wizo Feed",impactLabel:"WIZO VIP",impactTitle:"Apoya. Comparte. Gana.",impactBody:"Tu perfil Wizo es tu acceso a WIZO VIP. El apoyo cualificado y contabilizado de personas atribuidas puede generar comisión.",filmEyebrow:"TU INICIO COMO WIZO",filmTitle:"Conviértete en el WIZO que da vida a las ideas.",filmBody:"Mira cómo apoyar proyectos, compartir contenido y seguir tu estado WIZO VIP.",journeyEyebrow:"TU MAGIA WIZO · DESCUBRIR · APOYAR · COMPARTIR",journeyTitle:"Apoya ideas. Comparte lo que importa.",journeyBody:"Elige Bizos y proyectos que quieres impulsar. Compártelos con tu enlace personal. El apoyo cualificado y contabilizado de personas atribuidas puede generar comisión.",steps:[{title:"Crea tu perfil Wizo",body:"Regístrate como Wizo, muestra tus intereses y activa automáticamente tu entrada al programa WIZO VIP."},{title:"Descubre ideas",body:"Vive pitches breves, Live Pitches y Battles. Encuentra los Bizos y proyectos en los que realmente crees."},{title:"Apoya directamente",body:"Usa Tap Coins, regalos y Support para impulsar proyectos y hacer visible su avance."},{title:"Comparte tu enlace personal",body:"Comparte campañas, pitches y perfiles con tu enlace personal en redes, mensajería y conversaciones directas."},{title:"Conecta personas permanentemente",body:"Si un contacto se registra válidamente tras tu enlace, la atribución permitida queda vinculada permanentemente a su cuenta y a tu perfil Wizo."},{title:"Comisión por apoyo cualificado",body:"Cuando una persona atribuida realiza apoyo cualificado y contabilizado con Coins, se registra el 5 % de comisión estándar. Con estado VIP válido se aplica el 10 %."}],shareEyebrow:"COMPARTE CON TU ENLACE PERSONAL",shareTitle:"Comparte ideas con las personas adecuadas.",shareBody:"Comparte campañas, pitches y perfiles directamente o en tus canales. Tras un registro permitido, la atribución permanece.",opportunityEyebrow:"TU SISTEMA WIZO VIP EN DETALLE",opportunityTitle:"Así se genera la comisión.",opportunityBody:"Comparte un enlace personal. Cuando un contacto se registra válidamente, queda atribuido a tu perfil Wizo. Si después realiza apoyo cualificado y contabilizado con Coins, se aplica tu tasa vigente al reservar.",opportunityFlowTitle:"Cuatro pasos hacia la comisión",referralFlow:[{title:"1. Comparte un enlace personal",body:"Elige contenido que puedas recomendar y comparte tu enlace personal."},{title:"2. Registro permitido",body:"Si un contacto real se registra válidamente tras tu enlace, queda atribuido a tu perfil Wizo."},{title:"3. Apoyo cualificado y contabilizado",body:"Si la persona atribuida apoya a un Bizo con Coins realmente contabilizados, se crea apoyo con derecho a comisión."},{title:"4. Se registra la comisión",body:"El apoyo cualificado y contabilizado posterior genera un 5 % estándar o un 10 % si Wizo VIP es válido al reservar."}],opportunityCards:[{title:"5 % de comisión estándar",body:"El apoyo cualificado, contabilizado y no revertido de una persona atribuida registra un 5 % conforme a las normas del programa."},{title:"10 % Wizo VIP",body:"Desde 100 Wizos activos atribuidos directamente en un período móvil de 30 días, se aplica el 10 % al apoyo cualificado futuro."},{title:"Comparte con impacto",body:"Comparte contenido adecuado para tu red. Impulsa proyectos y consigue Wizos atribuidos."}],opportunityPermanentTitle:"Tu atribución permanece.",opportunityPermanentBody:"Una persona recomendada válidamente permanece atribuida a tu perfil Wizo. Reembolsos, contracargos o uso indebido pueden revertir una reserva. La comisión aparece primero en tu resumen privado durante el período de riesgo de 30 días.",opportunityAction:"Ver el sistema WIZO VIP",programmeNote:"La comisión requiere apoyo cualificado y realmente contabilizado de personas atribuidas. Compartir o registrarse por sí solo no genera comisión. El estado VIP y el pago siguen las normas vigentes del programa y de pago.",finalTitle:"Conviértete en el WIZO que necesitan las grandes ideas.",finalBody:"Conoce a las personas detrás de nuevas visiones, impulsa sus proyectos y muestra a tu red aquello en lo que crees. Invita nuevos WIZOs con tu Share Link; el apoyo cualificado y contabilizado puede generar comisión según las normas.",finalAction:"Hazte Wizo ahora"},ar:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · ساحر الأفكار والرؤى",title:"كن WIZO. امنح الأفكار الحياة.",heroBody:"هل تهتم بالشركات الناشئة والمؤسسين والأفكار الجديدة والرؤى الكبيرة؟ بصفتك WIZO، ساحر المجتمع، تكتشف المشاريع وتؤمن بأحلام مؤسسيها وتدعمها باستخدام Coins والهدايا. أظهر للآخرين ما يلهمك وادعهم عبر Share Link الخاص بك؛ وقد تنشأ عمولة عندما يقدم WIZOs المنسوبون دعماً مؤهلاً وفق القواعد.",primaryAction:"كن Wizo الآن",secondaryAction:"استكشف Wizo Feed",impactLabel:"WIZO VIP",impactTitle:"ادعم. شارك. اكسب.",impactBody:"ملف Wizo هو بوابتك إلى WIZO VIP. الدعم المؤهل والمحجوز من الأشخاص المنسوبين إليك قد ينشئ عمولة.",filmEyebrow:"بدايتك كـ WIZO",filmTitle:"كن WIZO الذي يمنح الأفكار الحياة.",filmBody:"تعرّف على دعم المشاريع ومشاركة المحتوى ومتابعة حالة WIZO VIP الخاصة بك.",journeyEyebrow:"سحر WIZO · اكتشف · ادعم · شارك",journeyTitle:"ادعم الأفكار. شارك ما يهم.",journeyBody:"اختر Bizos والمشاريع التي تريد دفعها إلى الأمام. شاركها برابطك الشخصي. الدعم المؤهل والمحجوز من الأشخاص المنسوبين إليك قد ينشئ عمولة.",steps:[{title:"ابدأ ملف Wizo",body:"سجّل كـ Wizo وأظهر اهتماماتك وفعّل تلقائيًا دخولك إلى برنامج WIZO VIP."},{title:"اكتشف الأفكار",body:"شاهد العروض القصيرة وLive Pitches وBattles واختر Bizos والمشاريع التي تؤمن بها."},{title:"ادعم مباشرة",body:"استخدم Tap Coins والهدايا وSupport لمنح المشاريع زخمًا وإظهار تقدمها."},{title:"شارك رابطك الشخصي",body:"شارك الحملات والعروض والملفات عبر رابطك الشخصي في الشبكات والرسائل والمحادثات المباشرة."},{title:"اربط الناس بشكل دائم",body:"عندما يسجل أحد معارفك بصورة صالحة بعد رابطك، يبقى الإسناد المسموح مرتبطًا بحسابه وملف Wizo الخاص بك بشكل دائم."},{title:"عمولة من دعم مؤهل",body:"عندما يقدم شخص منسوب إليك دعم Coins مؤهلًا ومحجوزًا، تُسجّل عمولة قياسية بنسبة 5٪. ومع حالة VIP سارية تنطبق نسبة 10٪."}],shareEyebrow:"شارك برابطك الشخصي",shareTitle:"شارك الأفكار مع الأشخاص المناسبين.",shareBody:"شارك الحملات والعروض والملفات مباشرة أو عبر قنواتك. بعد تسجيل مسموح، يبقى الإسناد قائمًا.",opportunityEyebrow:"نظام WIZO VIP بالتفصيل",opportunityTitle:"كيف تنشأ العمولة.",opportunityBody:"شارك رابطًا شخصيًا. عندما يسجل أحد معارفك بصورة صالحة، يُنسب إلى ملف Wizo الخاص بك. وإذا قدم لاحقًا دعم Coins مؤهلًا ومحجوزًا، ينطبق معدلك الساري عند الحجز.",opportunityFlowTitle:"أربع خطوات إلى العمولة",referralFlow:[{title:"1. شارك رابطًا شخصيًا",body:"اختر محتوى تمثله وشارك رابطك الشخصي."},{title:"2. تسجيل مسموح",body:"عندما يسجّل شخص حقيقي بصورة صالحة بعد رابطك، يبقى منسوبًا إلى ملف Wizo الخاص بك."},{title:"3. دعم مؤهل ومحجوز",body:"عندما يدعم الشخص المنسوب Bizo بعملات Coins محجوزة فعليًا، ينشأ دعم يستحق العمولة."},{title:"4. تُسجّل العمولة",body:"الدعم المؤهل والمحجوز لاحقًا يحقق 5٪ كعمولة قياسية أو 10٪ عند سريان Wizo VIP وقت الحجز."}],opportunityCards:[{title:"عمولة قياسية 5٪",body:"الدعم المؤهل والمحجوز وغير المعكوس من شخص منسوب يسجّل عمولة 5٪ وفقًا لقواعد البرنامج."},{title:"Wizo VIP بنسبة 10٪",body:"بدءًا من 100 Wizo نشط ومنسوب إليك مباشرة خلال فترة متحركة من 30 يومًا، تنطبق نسبة 10٪ على الدعم المؤهل المستقبلي."},{title:"شارك بأثر",body:"شارك محتوى يناسب شبكتك. ادفع المشاريع إلى الأمام واكسب Wizos منسوبين إليك."}],opportunityPermanentTitle:"يبقى إسنادك قائمًا.",opportunityPermanentBody:"يبقى الشخص المُحال بصورة صالحة منسوبًا إلى ملف Wizo الخاص بك. يمكن لعمليات الاسترداد أو الاعتراضات أو إساءة الاستخدام عكس الحجز. تظهر العمولة أولًا في ملخصك الخاص خلال فترة المخاطر البالغة 30 يومًا.",opportunityAction:"استكشف نظام WIZO VIP",programmeNote:"تتطلب العمولة دعمًا مؤهلًا ومحجوزًا فعليًا من أشخاص منسوبين إليك. المشاركة أو التسجيل وحدهما لا ينشئان عمولة. تخضع حالة VIP والدفع لقواعد البرنامج والدفع السارية.",finalTitle:"كن WIZO الذي تحتاجه الأفكار الكبيرة.",finalBody:"تعرّف إلى أصحاب الرؤى الجديدة وامنح مشاريعهم زخماً وأظهر لشبكتك ما تؤمن به. ادعُ WIZOs جدداً عبر Share Link الخاص بك؛ وقد ينشئ الدعم المؤهل والمحجوز عمولة وفق القواعد.",finalAction:"كن Wizo الآن"},zh:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · 点亮创意与愿景的魔法师",title:"成为 WIZO，让创意真正活起来。",heroBody:"你是否一直关注初创企业、创始人、新创意和大胆愿景？作为 WIZO——社区中的魔法师——你发现项目、相信创始人的梦想，并用 Coins 和 Gifts 提供支持。向他人展示你的选择，通过个人 Share Link 邀请他们；归属 WIZO 后续完成合格支持时，可按计划规则记录佣金。",primaryAction:"立即成为 Wizo",secondaryAction:"探索 Wizo Feed",impactLabel:"WIZO VIP",impactTitle:"支持。分享。获得佣金。",impactBody:"你的 Wizo 资料就是 WIZO VIP 入口。归因用户完成合格且已记账的支持时，可能产生佣金。",filmEyebrow:"你的 WIZO 起点",filmTitle:"成为让创意活起来的 WIZO。",filmBody:"了解如何支持项目、分享内容并查看你的 WIZO VIP 状态。",journeyEyebrow:"你的 WIZO 魔法 · 发现 · 支持 · 分享",journeyTitle:"支持创意。分享重要内容。",journeyBody:"选择你想推动的 Bizo 和项目，用个人链接分享它们。归因用户完成合格且已记账的支持时，可能产生佣金。",steps:[{title:"建立 Wizo 资料",body:"注册成为 Wizo，展示兴趣，并自动开启你的 WIZO VIP 计划入口。"},{title:"发现创意",body:"体验短片、Live Pitch 与 Battle，找到你真正相信的 Bizo 和项目。"},{title:"直接支持",body:"使用 Tap Coins、礼物与 Support，为项目带来动力并展示进展。"},{title:"分享个人链接",body:"通过社交媒体、消息工具和直接交流分享活动、Pitch 与资料的个人链接。"},{title:"长期连接用户",body:"联系人通过你的有效链接注册后，允许的归因会长期连接其账户与你的 Wizo 资料。"},{title:"合格支持产生佣金",body:"归因用户完成合格且已记账的 Coin 支持时，系统记录 5% 标准佣金。VIP 状态有效时，适用 10%。"}],shareEyebrow:"使用个人链接分享",shareTitle:"把创意分享给合适的人。",shareBody:"直接分享活动、Pitch 和资料页，或通过你的渠道分享。完成合规注册后，归因会保留。",opportunityEyebrow:"你的 WIZO VIP 系统详解",opportunityTitle:"佣金如何产生。",opportunityBody:"分享个人链接。联系人合规注册后，会归因到你的 Wizo 资料。之后完成合格且已记账的 Coin 支持时，适用预订时有效的比例。",opportunityFlowTitle:"获得佣金的四个步骤",referralFlow:[{title:"1. 分享个人链接",body:"选择你愿意推荐的内容，分享个人链接。"},{title:"2. 合规注册",body:"真实联系人通过链接合规注册后，会归因到你的 Wizo 资料。"},{title:"3. 合格且已记账的支持",body:"归因用户用实际记账的 Coins 支持 Bizo 后，会形成可计佣的支持。"},{title:"4. 记录佣金",body:"后续合格且已记账的支持适用 5% 标准佣金；预订时 Wizo VIP 有效则适用 10%。"}],opportunityCards:[{title:"5% 标准佣金",body:"归因用户完成合格、已记账且未撤销的支持时，系统按计划规则记录 5% 佣金。"},{title:"10% Wizo VIP",body:"滚动 30 天内达到 100 位直接归因的活跃 Wizo 后，未来合格支持适用 10%。"},{title:"有效分享",body:"分享适合你网络的内容，推动项目并获得归因 Wizo。"}],opportunityPermanentTitle:"归因会保留。",opportunityPermanentBody:"合规推荐的用户会持续归因到你的 Wizo 资料。退款、拒付或滥用可能撤销记录。佣金会先在你的私密概览中显示 30 天风险期。",opportunityAction:"了解 WIZO VIP 系统",programmeNote:"佣金只来自归因用户完成的合格且实际记账的支持。仅分享或注册不会产生佣金。VIP 状态和付款遵循适用的计划及付款规则。",finalTitle:"成为伟大创意需要的 WIZO。",finalBody:"认识新愿景背后的人，为项目带来动力，并向你的网络展示你相信什么。通过个人 Share Link 邀请新的 WIZO；合格且已记账的支持可按计划规则产生佣金。",finalAction:"立即成为 Wizo"},hi:{pageTitle:"WIZO START",navLabel:"WIZO START",eyebrow:"WIZO · आइडिया और विज़न को जगाने वाला WIZARD",title:"WIZO बनें। आइडिया को जीवन दें।",heroBody:"क्या आपको start-ups, founders, नए ideas और बड़े visions हमेशा आकर्षित करते हैं? WIZO के रूप में—कम्युनिटी के wizard—आप projects खोजते हैं, founders के सपनों पर विश्वास करते हैं और Coins व Gifts से उन्हें सपोर्ट करते हैं। जो आपको प्रेरित करे उसे दिखाएँ, अपने Share Link से नए WIZOs बुलाएँ; उनका योग्य सपोर्ट नियमों के अनुसार कमीशन बना सकता है।",primaryAction:"अभी Wizo बनें",secondaryAction:"Wizo Feed देखें",impactLabel:"WIZO VIP",impactTitle:"सपोर्ट करें। शेयर करें। कमाएँ।",impactBody:"आपकी Wizo प्रोफ़ाइल ही WIZO VIP में प्रवेश है। जुड़े लोगों का योग्य, बुक किया गया सपोर्ट कमीशन बना सकता है।",filmEyebrow:"आपकी WIZO शुरुआत",filmTitle:"वह WIZO बनें जो ideas को जीवन देता है।",filmBody:"देखें कि परियोजनाओं को कैसे सपोर्ट करें, सामग्री शेयर करें और अपना WIZO VIP स्टेटस देखें।",journeyEyebrow:"आपका WIZO MAGIC · खोजें · सपोर्ट करें · शेयर करें",journeyTitle:"विचारों को सपोर्ट करें। जो महत्वपूर्ण है उसे शेयर करें।",journeyBody:"उन Bizos और परियोजनाओं को चुनें जिन्हें आप आगे बढ़ाना चाहते हैं। उन्हें निजी लिंक से शेयर करें। जुड़े लोगों का योग्य, बुक किया गया सपोर्ट कमीशन बना सकता है।",steps:[{title:"Wizo प्रोफ़ाइल शुरू करें",body:"Wizo के रूप में पंजीकरण करें, अपनी रुचियां दिखाएं और WIZO VIP कार्यक्रम में अपना प्रवेश स्वतः सक्रिय करें।"},{title:"विचार खोजें",body:"शॉर्ट Pitch, Live Pitch और Battle देखें और वे Bizos तथा परियोजनाएं चुनें जिन पर आप विश्वास करते हैं।"},{title:"सीधा समर्थन करें",body:"Tap Coins, गिफ्ट और Support से परियोजनाओं को गति दें और प्रगति दिखाएं।"},{title:"व्यक्तिगत लिंक साझा करें",body:"सोशल मीडिया, मैसेजिंग और सीधी बातचीत में अभियान, Pitch और प्रोफ़ाइल का व्यक्तिगत लिंक साझा करें।"},{title:"लोगों को स्थायी रूप से जोड़ें",body:"आपके वैध लिंक के बाद संपर्क पंजीकरण करता है तो अनुमत एट्रिब्यूशन उसके खाते और आपकी Wizo प्रोफ़ाइल से स्थायी रूप से जुड़ता है।"},{title:"योग्य सपोर्ट से कमीशन",body:"जब जुड़ा व्यक्ति योग्य, बुक किया गया Coin सपोर्ट करता है, तो 5% मानक कमीशन दर्ज होता है। वैध VIP स्थिति में 10% लागू होता है।"}],shareEyebrow:"अपने निजी लिंक से शेयर करें",shareTitle:"विचार सही लोगों तक पहुँचाएँ।",shareBody:"अभियान, Pitch और प्रोफ़ाइल सीधे या अपने चैनलों में शेयर करें। अनुमत रजिस्ट्रेशन के बाद जुड़ाव बना रहता है।",opportunityEyebrow:"आपका WIZO VIP सिस्टम विस्तार से",opportunityTitle:"कमीशन कैसे बनता है।",opportunityBody:"निजी लिंक शेयर करें। संपर्क वैध रूप से रजिस्टर करता है तो वह आपकी Wizo प्रोफ़ाइल से जुड़ता है। बाद में योग्य, बुक किया गया Coin सपोर्ट करने पर बुकिंग के समय की आपकी दर लागू होती है।",opportunityFlowTitle:"कमीशन तक चार चरण",referralFlow:[{title:"1. निजी लिंक शेयर करें",body:"वह सामग्री चुनें जिसका आप समर्थन करते हैं और निजी लिंक शेयर करें।"},{title:"2. अनुमत रजिस्ट्रेशन",body:"असली संपर्क आपके लिंक के बाद वैध रजिस्ट्रेशन करता है तो वह आपकी Wizo प्रोफ़ाइल से जुड़ा रहता है।"},{title:"3. योग्य, बुक किया गया सपोर्ट",body:"जुड़ा व्यक्ति वास्तव में बुक किए Coins से Bizo को सपोर्ट करता है तो कमीशन योग्य सपोर्ट बनता है।"},{title:"4. कमीशन दर्ज होता है",body:"बाद का योग्य, बुक किया गया सपोर्ट 5% मानक कमीशन बनाता है या बुकिंग पर Wizo VIP वैध होने पर 10%."}],opportunityCards:[{title:"5% मानक कमीशन",body:"जुड़े व्यक्ति का योग्य, बुक और वापस न किया गया सपोर्ट नियमों के अनुसार 5% कमीशन दर्ज करता है।"},{title:"10% Wizo VIP",body:"रोलिंग 30 दिनों में 100 सक्रिय, सीधे जुड़े Wizos से भविष्य के योग्य सपोर्ट पर 10% लागू होता है।"},{title:"असर के साथ शेयर करें",body:"अपने नेटवर्क के लिए सही सामग्री शेयर करें। परियोजनाओं को आगे बढ़ाएँ और जुड़े Wizos पाएँ।"}],opportunityPermanentTitle:"आपका जुड़ाव बना रहता है।",opportunityPermanentBody:"वैध रूप से रेफ़र किया गया व्यक्ति आपकी Wizo प्रोफ़ाइल से जुड़ा रहता है। Refund, chargeback या दुरुपयोग बुकिंग को उलट सकते हैं। कमीशन पहले 30-दिन की जोखिम अवधि में निजी सारांश में दिखता है।",opportunityAction:"WIZO VIP सिस्टम विस्तार से देखें",programmeNote:"कमीशन केवल जुड़े लोगों के योग्य, वास्तव में बुक किए गए सपोर्ट से बनता है। केवल शेयर या रजिस्ट्रेशन से कमीशन नहीं बनता। VIP स्थिति और भुगतान लागू कार्यक्रम व भुगतान नियमों के अनुसार हैं।",finalTitle:"वह WIZO बनें जिसकी बड़े ideas को जरूरत है।",finalBody:"नए visions के पीछे के लोगों को जानें, उनके projects को गति दें और अपने network को दिखाएँ कि आप किस पर विश्वास करते हैं। Share Link से नए WIZOs बुलाएँ; योग्य, booked सपोर्ट नियमों के अनुसार कमीशन बना सकता है।",finalAction:"अभी Wizo बनें"},hr:{pageTitle:"WIZO POČETAK",navLabel:"WIZO POČETAK",eyebrow:"WIZO · ČAROBNJAK IDEJA I VIZIJA",title:"Postanite WIZO. Oživite ideje.",heroBody:"Zanimaju li vas start-upovi, osnivači, nove ideje i velike vizije? Kao WIZO, čarobnjak zajednice, otkrivate projekte, vjerujete u snove osnivača i podržavate ih Coinsima i poklonima. Pokažite drugima što vas nadahnjuje, pozovite ih osobnim Share Linkom; kvalificirana podrška pripisanih WIZO-a može stvoriti proviziju prema pravilima.",primaryAction:"Postanite Wizo sada",secondaryAction:"Istražite feed Wizo",impactLabel:"WIZO VIP",impactTitle:"Podržite. Podijelite. Zaradite.",impactBody:"Vaš Wizo profil je ulaz u WIZO VIP program. Kvalificirana, stvarno rezervirana podrška pripisanih osoba može stvoriti proviziju.",filmEyebrow:"POČETAK VAŠEG WIZO",filmTitle:"Postanite WIZO koji oživljava ideje.",filmBody:"Saznajte kako podržati projekte, dijeliti sadržaj i pratiti svoj WIZO VIP status.",journeyEyebrow:"VAŠA WIZO MAGIJA · OTKRIJTE · PODRŽITE · PODIJELITE",journeyTitle:"Podržite ideje. Podijelite ono što je važno.",journeyBody:"Odaberite Bizose i projekte koje želite pokrenuti. Podijelite ih svojom osobnom poveznicom. Kvalificirana, stvarno rezervirana podrška pripisanih osoba može stvoriti proviziju.",steps:[{title:"Pokrenite svoj Wizo profil",body:"Registrirajte se kao Wizo, pokažite svoje interese i automatski aktivirajte svoj ulazak u WIZO VIPski program."},{title:"Otkrijte ideje",body:"Doživite kratke pitcheve, Live Pitches i Battles. Pronađite Bizos i projekte u koje zaista vjerujete."},{title:"Podržite izravno",body:"Koristite Tap Coins, poklone i podršku kako biste projektima dali zamah i učinili napredak vidljivim."},{title:"Podijelite svoju osobnu poveznicu",body:"Dijelite kampanje, pitcheve i profile putem svoje osobne poveznice na društvenim mrežama, u porukama i u izravnim razgovorima."},{title:"Trajno povežite ljude",body:"Kada se kontakt valjano registrira putem vaše poveznice, dopuštena atribucija ostaje trajno povezana s njihovim računom i vašim Wizo profilom."},{title:"Provizija od kvalificirane podrške",body:"Kada pripisana osoba pruži kvalificiranu, stvarno rezerviranu Coin podršku, evidentira se standardna provizija od 5%. Uz važeći VIP status primjenjuje se 10%."}],shareEyebrow:"DIJELITE OSOBNOM POVEZNICOM",shareTitle:"Podijelite ideje s pravim ljudima.",shareBody:"Podijelite kampanje, pitcheve i profile izravno ili putem svojih kanala. Nakon dopuštene registracije pripisivanje ostaje.",opportunityEyebrow:"DETALJI VAŠEG WIZO VIP SUSTAVA",opportunityTitle:"Kako nastaje provizija.",opportunityBody:"Podijelite osobnu poveznicu. Kada se kontakt valjano registrira, pripisuje se vašem Wizo profilu. Kada kasnije pruži kvalificiranu, stvarno rezerviranu Coin podršku, primjenjuje se vaša stopa koja vrijedi pri rezervaciji.",opportunityFlowTitle:"Četiri koraka do provizije",referralFlow:[{title:"1. Podijelite osobnu poveznicu",body:"Odaberite sadržaj koji želite preporučiti i podijelite osobnu poveznicu."},{title:"2. Dopuštena registracija",body:"Kada se stvarni kontakt valjano registrira nakon vaše poveznice, ostaje pripisan vašem Wizo profilu."},{title:"3. Kvalificirana, rezervirana podrška",body:"Kada pripisana osoba podrži Bizo stvarno rezerviranim Coinsima, nastaje podrška za koju se može obračunati provizija."},{title:"4. Provizija se evidentira",body:"Kasnija kvalificirana, stvarno rezervirana podrška donosi 5% standardne provizije ili 10% ako Wizo VIP vrijedi pri rezervaciji."}],opportunityCards:[{title:"5% standardna provizija",body:"Kvalificirana, stvarno rezervirana i neponištena podrška pripisane osobe evidentira 5% provizije prema pravilima Programa."},{title:"10% Wizo VIP",body:"Od 100 aktivnih, izravno pripisanih Wizosa u pomičnom razdoblju od 30 dana, 10% vrijedi za buduću kvalificiranu podršku."},{title:"Dijelite s učinkom",body:"Dijelite sadržaj koji odgovara vašoj mreži. Pokrećite projekte i steknite pripisane Wizose."}],opportunityPermanentTitle:"Vaše pripisivanje ostaje.",opportunityPermanentBody:"Valjano preporučena osoba ostaje pripisana vašem Wizo profilu. Povrati, povratni tereti ili zlouporaba mogu poništiti rezervaciju. Provizija se prvo prikazuje u privatnom pregledu tijekom 30-dnevnog razdoblja rizika.",opportunityAction:"Istražite sustav WIZO VIP",programmeNote:"Provizija zahtijeva kvalificiranu, stvarno rezerviranu podršku pripisanih osoba. Samo dijeljenje ili registracija ne stvaraju proviziju. VIP status i isplata slijede važeća pravila Programa i isplate.",finalTitle:"Postanite WIZO kojeg velike ideje trebaju.",finalBody:"Upoznajte ljude iza novih vizija, dajte njihovim projektima zamah i pokažite svojoj mreži u što vjerujete. Pozovite nove WIZO-e osobnim Share Linkom; kvalificirana, knjižena podrška može stvoriti proviziju prema pravilima.",finalAction:"Postanite Wizo sada"},bs:pe({pageTitle:"WIZO POČETAK",navLabel:"WIZO POČETAK",eyebrow:"WIZO · ČAROBNJAK IDEJA I VIZIJA",title:"Postanite WIZO. Oživite ideje.",heroBody:"Zanimaju li vas start-upovi, osnivači, nove ideje i velike vizije? Kao WIZO, čarobnjak zajednice, otkrivate projekte, vjerujete u snove osnivača i podržavate ih Coinsima i poklonima. Pokažite drugima što vas nadahnjuje, pozovite ih osobnim Share Linkom; kvalificirana podrška pripisanih WIZO-a može stvoriti proviziju prema pravilima.",primaryAction:"Postanite Wizo sada",secondaryAction:"Istražite feed Wizo",impactLabel:"WIZO VIP",impactTitle:"Podržite. Podijelite. Zaradite.",impactBody:"Vaš Wizo profil je ulaz u WIZO VIP program. Kvalificirana, stvarno rezervirana podrška pripisanih osoba može stvoriti proviziju.",filmEyebrow:"POČETAK VAŠEG WIZO",filmTitle:"Postanite WIZO koji oživljava ideje.",filmBody:"Saznajte kako podržati projekte, dijeliti sadržaj i pratiti svoj WIZO VIP status.",journeyEyebrow:"VAŠA WIZO MAGIJA · OTKRIJTE · PODRŽITE · PODIJELITE",journeyTitle:"Podržite ideje. Podijelite ono što je važno.",journeyBody:"Odaberite Bizose i projekte koje želite pokrenuti. Podijelite ih svojom osobnom poveznicom. Kvalificirana, stvarno rezervirana podrška pripisanih osoba može stvoriti proviziju.",steps:[{title