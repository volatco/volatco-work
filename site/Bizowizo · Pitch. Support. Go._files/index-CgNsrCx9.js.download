mail-bestaetigen","/en/verify-email"],["/passwort-vergessen","/en/forgot-password"],["/passwort-neu","/en/reset-password"],["/konto/kontotyp","/en/account/type"],["/konto/einstellungen","/en/account/settings"],["/recht/nutzungsbedingungen","/en/legal/terms"],["/recht/datenschutz","/en/legal/privacy"],["/recht/impressum","/en/legal/imprint"],["/recht/community","/en/legal/community"],["/recht/cookies","/en/legal/cookies"],["/recht/widerruf","/en/legal/withdrawal"],["/recht/ambassador","/en/legal/ambassador"],["/recht/werbung","/en/legal/advertising"],["/bizo-start","/en/bizo-start"],["/wizo-start","/en/wizo-start"],["/alle-kampagnen","/en/campaigns"],["/kampagnen","/en/manage-campaigns"],["/kampagne","/en/campaign"],["/beitrag","/en/post"],["/pitch","/en/pitch"],["/video","/en/video"],["/bizo","/en/bizo"],["/wizo","/en/wizo"],["/wizos","/en/wizos"],["/my-feed","/en/my-feed"],["/folge-ich","/en/following"],["/live-pitches","/en/live-pitches"],["/live","/en/live"],["/battles","/en/battles"],["/wallet","/en/wallet"],["/profil","/en/profile"],["/studio","/en/studio"],["/reward/versand","/en/reward/shipping"],["/wissen","/en/knowledge"],["/info","/en/how-it-works"],["/werben/portal","/en/advertise/portal"],["/werben","/en/advertise"],["/ambassador","/en/ambassador"],["/messenger","/en/messenger"],["/start","/en/get-started"],["/admin","/en/admin"]],fx=[...GP].sort((e,i)=>i[1].length-e[1].length),yx=[...GP].sort((e,i)=>i[0].length-e[0].length),mk=/^\/en(?:\/|$)/;function jk(e){const i=e.indexOf("#"),t=e.indexOf("?"),r=Math.min(t<0?e.length:t,i<0?e.length:i);return[e.slice(0,r),e.slice(r)]}function JP(e,i,t){for(const r of i){const s=r[t];if(e===s||e.startsWith(`${s}/`))return`${r[1-t]}${e.slice(s.length)}`}return null}function wx(e){const[i,t]=jk(e);if(i==="/en")return`/${t}`;if(!mk.test(i))return null;const r=JP(i,fx,1);return r===null?null:`${r}${t}`}function qP(e){if(!e.startsWith("/")||e.startsWith("//"))return e;const[i,t]=jk(e);if(i==="/en"||mk.test(i))return e;if(i=